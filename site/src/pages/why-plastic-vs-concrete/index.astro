---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import installImage from '../../assets/images/install-trench-row.jpg';

const glance = [
  { label: 'Design service life', value: '100 years', icon: 'service-life' as const },
  { label: 'Standard install', value: 'By hand', icon: 'feather' as const },
  { label: 'Max traffic load', value: 'Class D', icon: 'load' as const },
  { label: 'Chemical resistance', value: 'pH 1–13', icon: 'chemical' as const },
  { label: 'Joint system', value: 'Sealed RRJ', icon: 'joint' as const },
  { label: 'Appraisal', value: 'WSA 137', icon: 'wsaa' as const },
];

const rows = [
  {
    factor: 'Material corrosion resistance',
    plastic: 'Polypropylene resists pH 1–13 and hydrogen sulphide (H2S)/sulphuric acid (H2SO4) attack — the primary cause of concrete sewer structure failure',
    concrete: 'Concrete is progressively attacked by H2S/H2SO4 generated by sewer gas, requiring liners or protective coatings to match PP\'s native resistance',
  },
  {
    factor: 'Design service life',
    plastic: '100 years (SMS AXEDO/ROMOLD range)',
    concrete: 'Typically shorter effective service life in aggressive sewer environments without additional corrosion protection',
  },
  {
    factor: 'Component weight & handling',
    plastic: 'Individual elements from ~15kg up to ~65kg depending on product and component — handled by 1–2 installers using the excavator already on site for the dig',
    concrete: 'Precast sections and lids commonly weigh several hundred kilograms to multiple tonnes, requiring purpose-mobilised crane or excavator lifting',
  },
  {
    factor: 'Typical install method',
    plastic: 'Modular base/riser/cover assembly, on-site height trimming, hand-placed',
    concrete: 'Crane-lifted precast sections or in-situ pour/cure, generally slower and more labour-intensive per structure',
  },
  {
    factor: 'Infiltration/exfiltration performance',
    plastic: 'Rubber ring joint (RRJ) sockets and EPDM/SBR seals engineered for a watertight system',
    concrete: 'Joints between precast sections are a common infiltration/exfiltration point without additional sealing measures',
  },
  {
    factor: 'Load rating available',
    plastic: 'Class D (trafficable) to AS 3996, with load transferred to surrounding bedding via the access cover — not the PP structure',
    concrete: 'Class D achievable, structure itself typically load-bearing',
  },
  {
    factor: 'Standards & appraisal',
    plastic: 'WSAA Product Appraisal PA 1317 to WSA 137:2019, EN 13598-2',
    concrete: 'Assessed under separate precast concrete manhole standards/specifications',
  },
];

const faqs = [
  {
    question: 'Is a polypropylene maintenance structure as strong as a concrete manhole?',
    answer: 'Fitted with a Class D access cover to AS 3996, SMS polypropylene structures carry the same trafficable load rating as a concrete manhole. The access cover is engineered to transfer surface loads to the surrounding bedding rather than the PP structure itself, so the comparison is between two different but equally standards-compliant load paths, not a strength shortfall in the plastic.',
  },
  {
    question: 'Why does concrete corrode in sewer applications but polypropylene doesn\'t?',
    answer: 'Sewer gas generates hydrogen sulphide, which bacteria convert to sulphuric acid on the exposed surface above the waterline — this is the dominant cause of concrete sewer structure degradation. Polypropylene resists pH 1–13 and is not attacked by H2S/H2SO4, so it doesn\'t need a protective lining to achieve its rated service life.',
  },
  {
    question: 'Do plastic maintenance structures need a crane to install?',
    answer: 'No. SMS structures are supplied as separate base, riser and access cover elements, each light enough for 1–2 installers to place by hand using the excavator already on site for the trench — unlike precast concrete sections, which generally need a crane or excavator specifically mobilised to lift them.',
  },
  {
    question: 'How does installation time compare to concrete?',
    answer: 'Modular assembly, on-site height trimming and hand-placed components mean a polypropylene structure is typically installed significantly faster than an equivalent precast concrete manhole, which needs crane mobilisation and more time per lift. Exact time savings depend on depth, access and site conditions — talk to SMS about your specific project.',
  },
  {
    question: 'Is WSAA appraisal the same as an Australian Standard?',
    answer: 'A WSAA Product Appraisal (SMS holds PA 1317) is a water-industry-recognised assessment that a product meets the relevant standard — in this case WSA 137:2019 — for use in Australian water utility networks. It sits alongside, not instead of, the underlying Australian and international standards referenced on each product page.',
  },
];
---

<BaseLayout
  title="Why Plastic vs Concrete Maintenance Structures | SMS"
  description="Compare polypropylene and concrete sewer maintenance structures on corrosion resistance, weight, install time, infiltration performance, load rating and standards compliance."
  canonicalPath="/why-plastic-vs-concrete/"
>
  <Breadcrumbs items={[{ label: 'Why Plastic vs Concrete', href: '/why-plastic-vs-concrete/' }]} />
  <Hero
    eyebrow="Comparison"
    title="Plastic vs concrete sewer maintenance structures"
    subtitle="Concrete sewer structures fail from the inside — sewer gas doesn't touch polypropylene. Here's the factor-by-factor case."
    image={installImage}
    imageAlt="Row of SMS polypropylene maintenance structures installed along a sewer trench"
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <section aria-labelledby="glance-heading">
      <h2 id="glance-heading" class="sr-only">At a glance</h2>
      <AtAGlance items={glance} />
    </section>

    <section aria-labelledby="table-heading" class="scroll-mt-24">
      <h2 id="table-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">Factor-by-factor comparison</h2>
      <div class="overflow-x-auto rounded-lg border border-sms-charcoal-100">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-sms-charcoal-900 text-white">
              <th scope="col" class="text-left px-4 py-3 font-semibold">Factor</th>
              <th scope="col" class="text-left px-4 py-3 font-semibold">SMS polypropylene structure</th>
              <th scope="col" class="text-left px-4 py-3 font-semibold">Precast concrete manhole</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-sms-charcoal-50', 'hover:bg-sms-green-50 transition-colors']}>
                <th scope="row" class="text-left px-4 py-3 font-medium text-sms-charcoal-900 align-top w-1/5">
                  {row.factor}
                </th>
                <td class="px-4 py-3 text-sms-charcoal-900 align-top border-l border-sms-charcoal-100">{row.plastic}</td>
                <td class="px-4 py-3 text-sms-charcoal-500 align-top border-l border-sms-charcoal-100">{row.concrete}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="tco-heading" class="scroll-mt-24">
      <h2 id="tco-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">The real cost difference isn't just the unit price</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        <div class="border-t border-sms-charcoal-100 pt-5">
          <h3 class="font-bold text-sms-charcoal-900 mb-2">Plant &amp; labour</h3>
          <p class="text-sm text-sms-charcoal-500 leading-relaxed">
            No separate crane or lifting rig to mobilise — the excavator already on site for the
            trench does the job, and a smaller install crew can handle a standard structure by hand.
          </p>
        </div>
        <div class="border-t border-sms-charcoal-100 pt-5">
          <h3 class="font-bold text-sms-charcoal-900 mb-2">Program time</h3>
          <p class="text-sm text-sms-charcoal-500 leading-relaxed">
            Modular assembly and on-site height trimming avoid the cure time, custom formwork or
            precast lead times that can hold up a concrete install.
          </p>
        </div>
        <div class="border-t border-sms-charcoal-100 pt-5">
          <h3 class="font-bold text-sms-charcoal-900 mb-2">Whole-of-life</h3>
          <p class="text-sm text-sms-charcoal-500 leading-relaxed">
            A 100-year design life with no corrosion-driven relining or rehabilitation cycle changes
            the maintenance budget over the life of the asset, not just the install cost.
          </p>
        </div>
      </div>
    </section>

    <section aria-labelledby="when-concrete-heading" class="scroll-mt-24">
      <h2 id="when-concrete-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">When does concrete still make sense?</h2>
      <p class="text-sms-charcoal-500 leading-relaxed max-w-[68ch]">
        A fair comparison cuts both ways. Precast or in-situ concrete can still be the right call for
        very large-diameter chambers or custom multi-pipe junction structures outside the SMS
        DN375–DN1000 range, sites where an existing concrete network standard mandates a like-for-like
        replacement, or highly bespoke configurations that don't suit a modular RRJ base. For the
        large majority of DN375–DN1000 gravity sewer maintenance access points, the factors above are
        the ones worth weighing up against a standard precast option.
      </p>
    </section>

    <FaqAccordion items={faqs} />
  </div>

  <CtaBand
    heading="Comparing options for an upcoming project?"
    subtitle="Send us your depth, load rating and inlet requirements and we'll confirm whether an SMS structure fits your spec."
  />
</BaseLayout>
