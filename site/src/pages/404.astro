---
import BaseLayout from '../layouts/BaseLayout.astro';
import company from '../data/company.json';
---

<BaseLayout
  title="Page Not Found | SMS"
  description="This page couldn't be found."
  canonicalPath="/404/"
>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-24 text-center">
    <h1 class="text-3xl font-bold text-sms-charcoal-900 mb-4">Page not found</h1>
    <p class="text-sms-charcoal-500 mb-8">
      The page you're looking for doesn't exist or has moved. Try the products range, or call us on
      <a href={`tel:${company.phoneHref}`} class="text-sms-green-600 font-semibold">{company.phone}</a>.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/" class="inline-flex items-center rounded-md bg-sms-green-600 px-6 py-3 text-base font-semibold text-white hover:bg-sms-green-700 transition-colors">
        Back to home
      </a>
      <a href="/products/" class="inline-flex items-center rounded-md border border-sms-charcoal-200 px-6 py-3 text-base font-semibold text-sms-charcoal-900 hover:bg-sms-charcoal-50 transition-colors">
        View products
      </a>
    </div>
  </div>
</BaseLayout>
