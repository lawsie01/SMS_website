---
import BaseLayout from '../layouts/BaseLayout.astro';
import company from '../data/company.json';
---

<BaseLayout
  title="Page Not Found | SMS"
  description="This page couldn't be found."
  canonicalPath="/404/"
>
  <div class="sms-contour text-white">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-24 text-center">
      <h1 class="text-3xl font-bold mb-4">Page not found</h1>
      <p class="text-sms-charcoal-100 mb-8">
        The page you're looking for doesn't exist or has moved. Try the products range, or call us on
        <a href={`tel:${company.phoneHref}`} class="sms-link font-semibold">{company.phone}</a>.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="inline-flex items-center rounded-md bg-sms-charcoal-900 px-6 py-3 text-base font-semibold text-white hover:bg-sms-charcoal-700 transition-colors">
          Back to home
        </a>
        <a href="/products/" class="inline-flex items-center rounded-md border border-white/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10 transition-colors">
          View products
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
