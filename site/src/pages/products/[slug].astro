---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import SpecTable from '../../components/SpecTable.astro';
import ConfigTable from '../../components/ConfigTable.astro';
import ConfigAccordion from '../../components/ConfigAccordion.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import SchemaProduct from '../../components/SchemaProduct.astro';
import Product3DViewer from '../../components/Product3DViewer.astro';
import { Image } from 'astro:assets';

const VIEWER_KEY_BY_SLUG: Record<string, 'shaft' | 'chamber' | 'hole'> = {
  'dn375-maintenance-shaft': 'shaft',
  'dn600-maintenance-chamber': 'chamber',
  'dn1000-maintenance-hole': 'hole',
};

export async function getStaticPaths() {
  const products = await getCollection('products');
  // Fittings & accessories aren't ready for launch — excluded here so no
  // page gets built (and nothing 404s from a stale nav/search/sitemap link).
  // The content files and this route's rendering logic are untouched;
  // dropping this filter re-enables them with no other changes needed.
  const launchable = products.filter((p) => p.data.category !== 'accessory');
  return launchable.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const data = product.data;
const path = `/products/${product.id}/`;
const isFamily = data.category !== 'accessory';
const viewerKey = VIEWER_KEY_BY_SLUG[product.id];
// The sidebar gets the more detailed shot (e.g. a cutaway) when the product
// has one; every card thumbnail elsewhere on the site still uses productImage.
// The detail shot is frequently a different asset type (real photography vs.
// a 3D render) to productImage, so its background is read from its own
// field, not productImage's — using the wrong one leaves a visible seam
// around the image (see --color-render-bg).
const sidebarImage = data.productImageDetail ?? data.productImage;
const sidebarImageAlt = data.productImageDetail ? data.productImageDetailAlt : data.productImageAlt;
const sidebarBackground = data.productImageDetail ? data.productImageDetailBackground : data.productImageBackground;
const sidebarBgClass = sidebarBackground === 'white' ? 'bg-white' : 'bg-render-bg';
// One gallery of real photographs, base configurations first then individual
// components, rendered above the assembly drawings.
const photos = [...data.configPhotos, ...data.componentPhotos];
// Assembly drawings fill the content column whatever their number, so a
// two-drawing product gets two half-width tiles rather than two thirds of a
// three-up row. Written out in full because Tailwind scans for whole class
// names and will not generate a class assembled from a variable.
// Two across at every size above mobile. Three across fits the DN375's three
// riser options on one row, but at this column width that leaves each drawing
// about 170px wide, which is too small to read the numbered parts. Two across
// nearly doubles it and costs a wrapped third tile.
const assemblyCols = data.assemblyRenders.length > 1 ? 'sm:grid-cols-2' : 'max-w-sm';
const assemblySizes =
  data.assemblyRenders.length > 1
    ? '(min-width: 1024px) 380px, (min-width: 640px) 45vw, 90vw'
    : '(min-width: 640px) 320px, 90vw';
---

<BaseLayout
  title={data.seoTitle ?? `${data.title} | SMS`}
  description={data.seoDescription ?? data.shortDescription}
  canonicalPath={path}
>
  <Breadcrumbs items={[{ label: 'Products', href: '/products/' }, { label: data.title, href: path }]} />

  <Hero
    eyebrow={`${data.brand}${data.dnSize ? ` · ${data.dnSize}` : ''}`}
    title={data.title}
    subtitle={data.shortDescription}
    image={data.heroImage}
    imageAlt={data.heroImageAlt}
    primaryCta={{ label: 'Request Pricing', href: `/contact/?product=${product.id}` }}
    compact
  />

  <SchemaProduct
    name={`SMS ${data.title}`}
    description={data.shortDescription}
    brand={data.brand}
    path={path}
  />

  {viewerKey && <Product3DViewer product={viewerKey} title={data.title} />}

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    {data.atAGlance.length > 0 && (
      <section aria-labelledby="glance-heading">
        <h2 id="glance-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">At a glance</h2>
        <AtAGlance items={data.atAGlance} />
      </section>
    )}

    <div class="grid lg:grid-cols-3 gap-12">
      {/* min-w-0: a grid item's default min-width is auto (= its content's
          intrinsic width), which lets a wide descendant (e.g. the config
          diagram below, or the spec table) inflate this whole column and
          push the page into horizontal scroll even though that descendant
          has its own overflow-x-auto. min-w-0 lets the column shrink to
          the track's actual size so the internal scroll takes over instead. */}
      <div class="lg:col-span-2 space-y-16 min-w-0">
        {data.specSections.length > 0 && (
          <section aria-labelledby="specs-heading">
            <h2 id="specs-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">Full specification</h2>
            <SpecTable sections={data.specSections} />
          </section>
        )}

        {isFamily && (data.configurations.length > 0 || data.configGroups.length > 0) && (
          <section aria-labelledby="config-heading">
            <h2 id="config-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">Configurations & part codes</h2>
            {data.configDiagram && (
              <figure class="mb-8 rounded-lg border border-sms-charcoal-100 bg-white p-4 sm:p-6">
                {/* The 8-panel diagram's per-icon angle labels get illegibly small if
                    forced to shrink to a narrow viewport — scroll it horizontally
                    below the breakpoint where 520px stops being "full width" instead,
                    same trade-off already made for wide spec tables on this site. */}
                <div class="overflow-x-auto">
                  <Image
                    src={data.configDiagram}
                    alt={data.configDiagramAlt ?? ''}
                    class="h-auto w-full min-w-[520px]"
                    widths={[640, 1024, 1600]}
                    sizes="(min-width: 1024px) 800px, 100vw"
                  />
                </div>
                {data.configDiagramCaption && (
                  <figcaption class="mt-3 text-sm text-sms-charcoal-400">{data.configDiagramCaption}</figcaption>
                )}
              </figure>
            )}

            {data.configGroups.length > 0 && (
              <div class="mb-12">
                <h3 class="font-semibold text-sms-charcoal-900 mb-3">Base part codes, by inlet/outlet size</h3>
                <ConfigAccordion groups={data.configGroups} intro={data.configGroupsIntro} />
              </div>
            )}

            {/* Base photos and individual component photos are two content
                fields but one thing to a reader: photographs of the real parts.
                They run as a single gallery here, above the assembly drawings,
                so the page goes photographs first and schematic second rather
                than splitting the photographs either side of the drawings. */}
            {photos.length > 0 && (
              <div class="mb-12">
                <h3 class="font-semibold text-sms-charcoal-900 mb-3">Components</h3>
                <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
                  {photos.map((photo) => (
                    <figure>
                      {/* Fixed aspect-square box + object-contain: source photos are
                          cropped tight to content but still vary in their own aspect
                          ratio, so a plain w-full/h-auto tile would render each photo
                          at a different height. This guarantees every tile in the
                          gallery is the same size, with the photo centred inside. */}
                      <div class="aspect-square rounded-lg border border-sms-charcoal-100 overflow-hidden bg-white flex items-center justify-center">
                        <Image src={photo.image} alt={photo.alt} class="max-h-full max-w-full w-full h-full object-contain p-4" widths={[400, 640]} sizes="(min-width: 1024px) 280px, (min-width: 640px) 45vw, 90vw" />
                      </div>
                      {photo.caption && <figcaption class="mt-2 text-sm text-sms-charcoal-400">{photo.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </div>
            )}

            {data.assemblyRenders.length > 0 && (
              <div class="mb-12">
                <h3 class="font-semibold text-sms-charcoal-900 mb-2">Assembly</h3>
                {data.assemblyRendersIntro && (
                  <p class="text-sm text-sms-charcoal-500 leading-relaxed mb-5 max-w-[68ch]">{data.assemblyRendersIntro}</p>
                )}
                {/* Column count follows the number of drawings, so two
                    drawings fill the same width as the part table below
                    rather than leaving a third of the row empty. */}
                <div class:list={["grid gap-5", assemblyCols]}>
                  {data.assemblyRenders.map((r) => (
                    <figure class="flex h-full flex-col">
                      {/* Symmetric px-10 keeps the drawing centred in the tile
                          while still clearing the badges, which sit 2.25rem
                          (36px) left of the image box and so fall inside that
                          40px of padding rather than against the tile edge.
                          Every callout coordinate is a percentage of the image
                          box, which keeps it locked to the part at any width. */}
                      <div class="rounded-lg border border-sms-charcoal-100 bg-white py-5 px-10">
                        <div class="relative">
                          <Image src={r.image} alt={r.alt} class="w-full h-auto" widths={[320, 640, 960]} sizes={assemblySizes} />
                          {r.callouts.map((c) => (
                            <>
                              <span
                                class="absolute block h-px bg-sms-charcoal-300"
                                style={`top:${c.y}%; left:-1.05rem; width:calc(${c.x}% + 1.05rem);`}
                                aria-hidden="true"
                              ></span>
                              <span
                                class="absolute flex items-center justify-center rounded-full bg-sms-charcoal-900 text-white font-semibold"
                                style={`top:${c.y}%; left:-2.25rem; width:1.25rem; height:1.25rem; font-size:0.6875rem; transform:translateY(-50%);`}
                              >{c.n}</span>
                            </>
                          ))}
                        </div>
                      </div>
                      {r.caption && <figcaption class="mt-auto pt-2 text-sm text-sms-charcoal-400">{r.caption}</figcaption>}
                    </figure>
                  ))}
                </div>
              </div>
            )}


            {data.configurations.length > 0 && (
              <div>
                {data.configGroups.length > 0 && (
                  <h3 class="font-semibold text-sms-charcoal-900 mb-3">Parts in the assembly</h3>
                )}
                <ConfigTable rows={data.configurations} intro={data.configurationsIntro} />
              </div>
            )}
          </section>
        )}

        {data.installationSections.length > 0 && (
          <section aria-labelledby="install-heading">
            <h2 id="install-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">
              Installation
            </h2>
            <div class="space-y-6">
              {data.installationSections.map((s) => (
                <div>
                  <h3 class="font-semibold text-sms-charcoal-900 mb-2">{s.heading}</h3>
                  <p class="text-sms-charcoal-500 leading-relaxed">{s.body}</p>
                  {s.bullets && (
                    <ul class="sms-list mt-3 text-sms-charcoal-500">
                      {s.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  )}
                  {s.images.length > 0 && (
                    <div class:list={["mt-4 grid gap-4", s.images.length > 1 ? "sm:grid-cols-2" : "max-w-sm"]}>
                      {s.images.map((photo) => (
                        <figure>
                          <div class="aspect-square rounded-lg border border-sms-charcoal-100 overflow-hidden bg-white flex items-center justify-center">
                            <Image src={photo.image} alt={photo.alt} class="max-h-full max-w-full w-full h-full object-contain p-4" widths={[400, 640]} sizes="(min-width: 1024px) 380px, 90vw" />
                          </div>
                          {photo.caption && <figcaption class="mt-2 text-sm text-sms-charcoal-400">{photo.caption}</figcaption>}
                        </figure>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        {data.standards.length > 0 && (
          <section aria-labelledby="standards-heading">
            <h2 id="standards-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">Standards & approvals</h2>
            <ul class="grid sm:grid-cols-2 gap-4">
              {data.standards.map((s) => (
                <li class="border-t border-sms-charcoal-100 pt-5">
                  <p class="font-mono font-medium text-sms-charcoal-900">{s.code}</p>
                  <p class="text-sm text-sms-charcoal-500 mt-1">{s.description}</p>
                </li>
              ))}
            </ul>
          </section>
        )}

        {data.faqs.length > 0 && <FaqAccordion items={data.faqs} />}
      </div>

      <aside class="space-y-8">
        <div class="rounded-xl border border-sms-green-300 bg-sms-charcoal-50 p-6">
          <h2 class="font-bold text-sms-charcoal-900 mb-2">Interested in the {data.title}?</h2>
          <p class="text-sm text-sms-charcoal-500 mb-4">
            Let us know which products you need and we'll confirm configuration, lead time and price.
          </p>
          <a
            href={`/contact/?product=${product.id}`}
            class="inline-flex items-center rounded-md bg-sms-charcoal-900 px-4 py-2.5 text-sm font-semibold text-white hover:bg-sms-charcoal-700 transition-colors"
          >
            Get Pricing &amp; Lead Time &rarr;
          </a>
        </div>

        {sidebarImage && (
          data.productImageBackground === 'dark' ? (
            <div class:list={["rounded-xl border border-sms-charcoal-100 p-6 flex items-center justify-center bg-sms-charcoal-900", data.productImageDetail ? "aspect-3/4" : "aspect-square"]}>
              <Image src={sidebarImage} alt={sidebarImageAlt ?? ''} class="max-h-full w-full object-contain" widths={[320, 480]} sizes="320px" />
            </div>
          ) : (
            <div class="sms-bracketed">
              <div class:list={["sms-bracketed__inner rounded-xl border border-sms-charcoal-100 p-6 flex items-center justify-center", sidebarBgClass, data.productImageDetail ? "aspect-3/4" : "aspect-square"]}>
                <Image src={sidebarImage} alt={sidebarImageAlt ?? ''} class="max-h-full w-full object-contain" widths={[320, 480]} sizes="320px" />
              </div>
            </div>
          )
        )}

        {data.downloads.length > 0 && (
          <div class="border-t border-sms-charcoal-100 pt-5">
            <h2 class="font-bold text-sms-charcoal-900 mb-4">Downloads</h2>
            <ul class="space-y-3">
              {data.downloads.map((d) => (
                <li>
                  {d.restricted ? (
                    <span class="text-sm text-sms-charcoal-400">
                      {d.label}: <a href={`/technical-resources/request-access/?product=${product.id}&asset=${encodeURIComponent(d.label.toLowerCase().includes('drawing') ? 'Full engineering drawings (PDF)' : 'CAD/BIM model (DWG/RVT/IFC)')}`} class="sms-link font-medium">request access</a>
                    </span>
                  ) : d.file ? (
                    <a href={d.file} class="text-sm sms-link font-medium" download>
                      {d.label} ({d.fileType})
                    </a>
                  ) : (
                    <span class="text-sm text-sms-charcoal-400">
                      {d.label} ({d.fileType}): coming soon
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}

        {data.countryOfManufacture && (
          <div class="border-t border-sms-charcoal-100 pt-5">
            <h2 class="font-bold text-sms-charcoal-900 mb-2">Manufacture</h2>
            <p class="text-sm text-sms-charcoal-500">{data.countryOfManufacture}</p>
            {data.manufacturerNote && <p class="text-xs text-sms-charcoal-400 mt-2">{data.manufacturerNote}</p>}
          </div>
        )}

        <div class="prose prose-sm max-w-none text-sms-charcoal-500">
          <Content />
        </div>
      </aside>
    </div>
  </div>

  <CtaBand
    heading={`Ready to spec the ${data.title}?`}
    subtitle="Send us your project depth, inlet sizes and load rating requirements and we'll confirm the right configuration."
    productContext={product.id}
  />
</BaseLayout>
