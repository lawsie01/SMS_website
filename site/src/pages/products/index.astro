---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const products = await getCollection('products');
const families = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);
// Fittings & accessories aren't ready for launch — see the "Fittings &
// accessories" section below (currently commented out) and getStaticPaths
// in [slug].astro, which is what actually keeps their pages from being
// built. Re-enable both together.
// const accessories = products
//   .filter((p) => p.data.category === 'accessory')
//   .sort((a, b) => a.data.order - b.data.order);

const whyPolypropylene = [
  {
    title: 'Corrosion & chemical resistant',
    body: 'Handles pH 1–13. The H2S and sulphuric acid that degrade concrete sewer structures don\'t attack polypropylene.',
  },
  {
    title: 'Lightweight, hand-installed',
    body: 'One or two installers place base, riser and cover by hand, using the excavator already there for the dig. No crane, no formwork, no cure time.',
  },
  {
    title: 'Watertight, ingress-free joints',
    body: 'Every connection is a rubber ring joint (RRJ) socket with an EPDM or SBR seal. That\'s what keeps groundwater and roots out.',
  },
  {
    title: '100-year design life',
    body: 'Appraised under WSAA PA 1317 to WSA 137:2019, with access covers rated Class D to AS 3996.',
  },
];
---

<BaseLayout
  title="Products | SMS Polypropylene Sewer Maintenance Structures"
  description="SMS AXEDO and SMS ROMOLD polypropylene maintenance shafts, chambers and holes. WSAA PA 1317 appraised, Class D rated."
  canonicalPath="/products/"
>
  <Breadcrumbs items={[{ label: 'Products', href: '/products/' }]} />
  <Hero
    eyebrow="Product range"
    title="Polypropylene maintenance structures, DN375 to DN1000"
    subtitle="DN375, DN600 and DN1000, all appraised under WSA 137:2019. The full range is held as stock."
    secondaryCta={{ label: 'Request a quote', href: '/contact/' }}
    compact
  />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <section aria-labelledby="overview-heading">
      <h2 id="overview-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">One system in three sizes</h2>
      <p class="text-sms-charcoal-500 leading-relaxed max-w-[68ch] mb-10">
        You need an access point wherever the line changes direction, picks up another line, changes
        diameter, or just runs far enough that it needs a way in. Three sizes cover all of it: the DN375
        Shaft, DN600 Chamber and DN1000 Hole. Same base-and-riser build in each, sized to the job, with a
        reducing cone on the DN1000 to bring it down to a 600mm opening.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyPolypropylene.map((item) => (
          <div class="border-t border-sms-charcoal-100 pt-5">
            <h3 class="font-bold text-sms-charcoal-900 mb-2">{item.title}</h3>
            <p class="text-sm text-sms-charcoal-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="families-heading">
      <h2 id="families-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-8">Maintenance structures</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {families.map((p) => (
          <ProductCard
            href={`/products/${p.id}/`}
            title={p.data.title}
            dnSize={p.data.dnSize}
            brand={p.data.brand}
            useCase={p.data.cardUseCase}
            image={p.data.productImage}
            imageAlt={p.data.productImageAlt}
            imageBackground={p.data.productImageBackground}
          />
        ))}
      </div>
    </section>

    {/* Fittings & accessories — not ready for launch. Section kept here,
        commented out, so it drops back in unchanged once the `accessories`
        const above and the [slug].astro getStaticPaths filter are both
        re-enabled.
    <section aria-labelledby="accessories-heading">
      <h2 id="accessories-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-8">Fittings & accessories</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {accessories.map((p) => (
          <ProductCard
            href={`/products/${p.id}/`}
            title={p.data.title}
            brand={p.data.brand}
            useCase={p.data.cardUseCase}
            image={p.data.productImage}
            imageAlt={p.data.productImageAlt}
            imageBackground={p.data.productImageBackground}
          />
        ))}
      </div>
    </section>
    */}
  </div>

  <CtaBand />
</BaseLayout>
