---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBand from '../../components/CtaBand.astro';

const products = await getCollection('products');
const families = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);
const accessories = products
  .filter((p) => p.data.category === 'accessory')
  .sort((a, b) => a.data.order - b.data.order);

const whyPolypropylene = [
  {
    title: 'Corrosion & chemical resistant',
    body: 'Resists pH 1–13 and the hydrogen sulphide/sulphuric acid attack that degrades concrete sewer structures over time.',
  },
  {
    title: 'Lightweight, hand-installed',
    body: '1–2 installers place base, riser and cover by hand using the excavator already on site — no crane, no formwork, no curing time.',
  },
  {
    title: 'Watertight, ingress-free joints',
    body: 'Rubber ring joint (RRJ) sockets and EPDM/SBR seals keep groundwater and root intrusion out at every connection.',
  },
  {
    title: '100-year design life',
    body: 'Appraised under WSAA Product Appraisal PA 1317 to WSA 137:2019, with access covers rated Class D to AS 3996.',
  },
];
---

<BaseLayout
  title="Products | SMS Polypropylene Sewer Maintenance Structures"
  description="SMS AXEDO and SMS ROMOLD polypropylene maintenance shafts, chambers and holes, plus fittings and accessories. WSAA PA 1317 appraised, Class D rated."
  canonicalPath="/products/"
>
  <Breadcrumbs items={[{ label: 'Products', href: '/products/' }]} />
  <Hero
    eyebrow="Product range"
    title="Polypropylene maintenance structures, DN375 to DN1000"
    subtitle="Three WSAA-appraised product families covering reticulation to trunk sewer access, plus the fittings and accessories to complete every installation — held as stock and ready to dispatch."
    secondaryCta={{ label: 'Request a quote', href: '/contact/' }}
    compact
  />

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <section aria-labelledby="overview-heading">
      <h2 id="overview-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">One system, engineered for every access point</h2>
      <p class="text-sms-charcoal-500 leading-relaxed max-w-[68ch] mb-10">
        A gravity sewer network needs a physical access point wherever a pipeline changes direction, joins
        another line, steps up or down in diameter, or simply runs far enough that inspection and
        maintenance need a way in. SMS covers every one of those points with one polypropylene system in
        three sizes — the DN375 Maintenance Shaft, DN600 Maintenance Chamber and DN1000 Maintenance Hole —
        each assembled from the same base-and-riser approach, sized to the job, with a reducing cone added
        on the DN1000 Hole for its smaller access opening.
      </p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {whyPolypropylene.map((item) => (
          <div class="border-t border-sms-charcoal-100 pt-5">
            <h3 class="font-bold text-sms-charcoal-900 mb-2">{item.title}</h3>
            <p class="text-sm text-sms-charcoal-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="families-heading">
      <h2 id="families-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-8">Maintenance structures</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {families.map((p) => (
          <ProductCard
            href={`/products/${p.id}/`}
            title={p.data.title}
            dnSize={p.data.dnSize}
            brand={p.data.brand}
            useCase={p.data.cardUseCase}
            image={p.data.productImage}
            imageAlt={p.data.productImageAlt}
            imageBackground={p.data.productImageBackground}
          />
        ))}
      </div>
    </section>

    <section aria-labelledby="accessories-heading">
      <h2 id="accessories-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-8">Fittings & accessories</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {accessories.map((p) => (
          <ProductCard
            href={`/products/${p.id}/`}
            title={p.data.title}
            brand={p.data.brand}
            useCase={p.data.cardUseCase}
            image={p.data.productImage}
            imageAlt={p.data.productImageAlt}
            imageBackground={p.data.productImageBackground}
          />
        ))}
      </div>
    </section>
  </div>

  <CtaBand />
</BaseLayout>
