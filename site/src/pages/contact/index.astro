---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import company from '../../data/company.json';

const products = await getCollection('products');
// Fittings & accessories aren't ready for launch — excluded from this
// enquiry picker so a visitor can't ask about a product with no live page.
const sortedProducts = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);

function mapsUrl(loc: { addressLine1?: string; addressLine2?: string }): string {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${loc.addressLine1}, ${loc.addressLine2}`)}`;
}
---

<BaseLayout
  title="Contact SMS | Enquire About Sewer Maintenance Structures"
  description="Enquire about SMS AXEDO and SMS ROMOLD polypropylene maintenance structures. Call 1300 482 228, email sales@sewerms.com.au, or send project details via the enquiry form."
  canonicalPath="/contact/"
>
  <Hero
    title="Talk to SMS about your project"
    subtitle="Send through your project details, or call. We'll confirm the configuration and the lead time."
    compact
    crumbs={[{ label: 'Contact', href: '/contact/' }]}
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-5 gap-12">
    <div class="lg:col-span-3">
      <h2 class="text-2xl font-bold text-sms-charcoal-900 mb-6">Send an enquiry</h2>
      <form
        name="enquiry"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contact/thank-you/"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="enquiry" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" autocomplete="off" tabindex="-1" /></label>
        </p>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Name *</label>
            <input type="text" id="name" name="name" required autocomplete="name" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2.5 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Company</label>
            <input type="text" id="company" name="company" autocomplete="organization" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2.5 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="email" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2.5 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Phone</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2.5 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
        </div>

        <div class="relative">
          <label id="product-label" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Product(s) of interest</label>
          <button
            type="button"
            id="product-toggle"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="product-panel"
            aria-labelledby="product-label product-summary"
            class="sms-press w-full flex items-center justify-between gap-2 rounded-md border border-sms-charcoal-200 px-3 py-2 text-sm text-left text-sms-charcoal-700 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none"
          >
            <span id="product-summary">Select product(s) (optional)</span>
            <svg id="product-chevron" class="w-4 h-4 shrink-0 text-sms-charcoal-400 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div
            id="product-panel"
            role="group"
            aria-labelledby="product-label"
            hidden
            class="absolute z-10 mt-1 w-full max-h-64 overflow-y-auto rounded-md border border-sms-charcoal-200 bg-white shadow-lg p-2 space-y-0.5"
          >
            {sortedProducts.map((p) => (
              <label class="flex items-center gap-2 rounded px-2 py-1.5 text-sm text-sms-charcoal-700 hover:bg-sms-charcoal-50 cursor-pointer">
                <input type="checkbox" name="product" value={p.id} data-product-title={p.data.title} class="rounded border-sms-charcoal-300 text-sms-green-600 focus:ring-sms-green-600" />
                {p.data.title}
              </label>
            ))}
          </div>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Project details *</label>
          <textarea id="message" name="message" required rows="5" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2.5 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" placeholder="Install depth, inlet sizes, load rating, timeframe, location..."></textarea>
        </div>

        <button type="submit" class="sms-press inline-flex items-center rounded-md bg-sms-charcoal-900 px-6 py-3 text-base font-semibold text-white hover:bg-sms-charcoal-700 transition-colors">
          Send enquiry
        </button>
      </form>

      <script>
        const toggle = document.getElementById('product-toggle');
        const panel = document.getElementById('product-panel');
        const summary = document.getElementById('product-summary');
        const chevron = document.getElementById('product-chevron');
        const checkboxes = document.querySelectorAll<HTMLInputElement>('#product-panel input[type="checkbox"]');

        function setOpen(open: boolean): void {
          if (!toggle || !panel || !chevron) return;
          toggle.setAttribute('aria-expanded', String(open));
          chevron.style.transform = open ? 'rotate(180deg)' : '';
          if (open) panel.removeAttribute('hidden');
          else panel.setAttribute('hidden', '');
        }

        function refreshSummary(): void {
          if (!summary) return;
          const checked = [...checkboxes].filter((c) => c.checked);
          if (checked.length === 0) summary.textContent = 'Select product(s) (optional)';
          else if (checked.length === 1) summary.textContent = checked[0].dataset.productTitle ?? checked[0].value;
          else summary.textContent = `${checked.length} products selected`;
        }

        toggle?.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        checkboxes.forEach((box) => box.addEventListener('change', refreshSummary));

        document.addEventListener('click', (e) => {
          if (!panel || !toggle) return;
          if (toggle.getAttribute('aria-expanded') === 'true' && !panel.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
            setOpen(false);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });

        const params = new URLSearchParams(window.location.search);
        const wanted = new Set(params.getAll('product'));
        if (wanted.size) {
          checkboxes.forEach((box) => {
            if (wanted.has(box.value)) box.checked = true;
          });
          refreshSummary();
        }
      </script>
    </div>

    <div class="lg:col-span-2 space-y-8">
      <div class="border-t border-sms-charcoal-100 pt-5">
        <h2 class="font-bold text-sms-charcoal-900 mb-4">Direct contact</h2>
        <ul class="space-y-3 text-sm">
          <li><a href={`tel:${company.phoneHref}`} class="sms-link font-semibold">{company.phone}</a></li>
          <li><a href={`mailto:${company.email}`} class="sms-link font-semibold">{company.email}</a></li>
          <li class="text-sms-charcoal-500">{company.addressLine1}, {company.addressLine2}</li>
        </ul>
      </div>

      <div class="border-t border-sms-charcoal-100 pt-5">
        <h2 class="font-bold text-sms-charcoal-900 mb-4">National coverage</h2>
        <ul class="flex flex-wrap gap-2 mb-3">
          {company.coverage.map((c) => (
            <li class="rounded-full border border-sms-charcoal-200 px-3 py-1 text-xs font-medium text-sms-charcoal-700">{c}</li>
          ))}
        </ul>
        <a href="#locations" class="sms-link text-sm font-semibold">See branch addresses &rarr;</a>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pb-16">
    <section id="locations" aria-labelledby="locations-heading" class="scroll-mt-24 border-t border-sms-charcoal-100 pt-12">
      <h2 id="locations-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">Our locations</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
        {company.locations.map((loc) => (
          <div>
            <h3 class="font-bold text-sms-charcoal-900 mb-2">{loc.region}</h3>
            <p class="text-sm text-sms-charcoal-500 leading-relaxed">
              {loc.addressLine1}<br />{loc.addressLine2}
            </p>
            {loc.note && <p class="text-xs text-sms-charcoal-400 mt-1">{loc.note}</p>}
            <a
              href={mapsUrl(loc)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-2 sms-link text-sm font-semibold"
              aria-label={`Get directions to SMS's ${loc.region} location on Google Maps`}
            >
              Get directions &rarr;
            </a>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
