---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';

const approvals = [
  {
    code: 'WSAA Product Appraisal PA 1317',
    icon: 'wsaa' as const,
    body: 'Independent Water Services Association of Australia appraisal covering SMS polypropylene sewer maintenance shafts, chambers and holes against WSA 137:2019.',
  },
  {
    code: 'WSA 137:2019',
    body: 'Industry standard for unplasticised PVC, polypropylene and polyethylene maintenance shafts, chambers and holes for sewerage — the core standard the SMS range is manufactured and appraised against.',
  },
  {
    code: 'AS 3996',
    body: 'Access covers and grates. All SMS access cover arrangements (Top Hat, concrete cover plate, concrete load distribution ring) are rated Class D — trafficable — to this standard.',
  },
  {
    code: 'EN 13598-2',
    body: 'European standard for plastics piping systems used in manholes and inspection chambers, in traffic areas and deep underground installations.',
  },
  {
    code: 'AS 1646',
    body: 'Elastomeric seals for waterworks purposes — governs the EPDM/SBR seals used throughout the SMS range.',
  },
  {
    code: 'AS/NZS 2566',
    body: 'Buried flexible pipelines — referenced for installation practice (bedding, backfill, compaction) around SMS structures.',
  },
  {
    code: 'AS/NZS 5065',
    body: 'Polyethylene and polypropylene pipes and fittings for drainage and sewerage applications.',
  },
  {
    code: 'EN 14396',
    body: 'Fixed ladders for manholes — applies to the DN1000 Maintenance Hole\'s person-entry ladder.',
  },
];

const matrix = [
  { code: 'WSA 137:2019', shaft: true, chamber: true, hole: true },
  { code: 'WSAA PA 1317', shaft: true, chamber: true, hole: true },
  { code: 'EN 13598-2', shaft: true, chamber: true, hole: true },
  { code: 'AS 3996 (Class D covers)', shaft: true, chamber: true, hole: true },
  { code: 'AS 1646 (seals)', shaft: true, chamber: true, hole: true },
  { code: 'AS/NZS 2566 (buried pipelines)', shaft: true, chamber: true, hole: true },
  { code: 'AS/NZS 5065 (PP/PE pipes)', shaft: false, chamber: true, hole: true },
  { code: 'EN 14396 (fixed ladders)', shaft: false, chamber: false, hole: true },
];

const faqs = [
  {
    question: 'What is WSAA Product Appraisal PA 1317?',
    answer: 'PA 1317 is the Water Services Association of Australia\'s independent appraisal of the SMS range of PP sewer maintenance shafts, chambers and holes against WSA 137:2019, the industry standard water utilities use to assess these products for network use.',
  },
  {
    question: 'What load class are SMS access covers rated to?',
    answer: 'Class D (trafficable) to AS 3996, across the standard Top Hat, concrete cover plate and concrete load distribution ring options, on all three SMS product families.',
  },
  {
    question: 'Does the SMS range meet European as well as Australian standards?',
    answer: 'Yes. In addition to WSA 137:2019 and the referenced Australian Standards (AS 3996, AS 1646, AS/NZS 2566, AS/NZS 5065), the range is manufactured to EN 13598-2, and the DN1000 Hole\'s ladder to EN 14396.',
  },
  {
    question: 'Where can I see the current WSAA appraisal certificate?',
    answer: 'Contact SMS or download it from the Technical Resources hub.',
  },
];
---

<BaseLayout
  title="Approvals & Standards | SMS WSAA PA 1317, WSA 137, AS 3996"
  description="SMS polypropylene sewer maintenance structures are appraised under WSAA PA 1317 to WSA 137:2019, with access covers rated Class D to AS 3996 and construction to EN 13598-2."
  canonicalPath="/approvals/"
>
  <Breadcrumbs items={[{ label: 'Approvals', href: '/approvals/' }]} />
  <Hero
    eyebrow="Approvals & standards"
    title="Backed by WSAA"
    subtitle="Every claim on this page is backed by a named standard or appraisal — not marketing language. Full certificates are available in the Technical Resources hub."
    compact
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <section aria-labelledby="approvals-grid-heading">
      <h2 id="approvals-grid-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">Standards & appraisals</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {approvals.map((a) => (
          <div class="border-t border-sms-charcoal-100 pt-5">
            {'icon' in a && a.icon ? (
              <div class="flex items-center gap-2 mb-2">
                <Icon name={a.icon} class="w-5 h-5 shrink-0 text-sms-green-600" />
                <p class="font-mono font-medium text-sms-green-600">{a.code}</p>
              </div>
            ) : (
              <p class="font-mono font-medium text-sms-green-600 mb-2">{a.code}</p>
            )}
            <p class="text-sm text-sms-charcoal-500 leading-relaxed">{a.body}</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-sms-charcoal-400 mt-6 max-w-[68ch]">
        Quality management certification (AS/NZS ISO 9001) and any current WaterMark licensing referenced on
        prior SMS materials are being reconfirmed for the current AXEDO/ROMOLD range — contact SMS for the
        latest certificate if this is required for your project's documentation.
      </p>
    </section>

    <section aria-labelledby="matrix-heading">
      <h2 id="matrix-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">Compliance at a glance, by product</h2>
      <p class="text-sm text-sms-charcoal-500 mb-6 max-w-[68ch]">
        Not every standard applies to every product — this is the same data published on each
        product's own Standards &amp; Approvals section, side by side for quick reference.
      </p>
      <div class="overflow-x-auto rounded-lg border border-sms-charcoal-100">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-sms-charcoal-900 text-white">
              <th scope="col" class="text-left px-4 py-3 font-semibold">Standard</th>
              <th scope="col" class="text-center px-4 py-3 font-semibold">DN375 Shaft</th>
              <th scope="col" class="text-center px-4 py-3 font-semibold">DN600 Chamber</th>
              <th scope="col" class="text-center px-4 py-3 font-semibold">DN1000 Hole</th>
            </tr>
          </thead>
          <tbody>
            {matrix.map((row, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-sms-charcoal-50', 'hover:bg-sms-green-50 transition-colors']}>
                <th scope="row" class="text-left px-4 py-3 font-mono font-medium text-sms-charcoal-900 border-l border-sms-charcoal-100">{row.code}</th>
                <td class="text-center px-4 py-3 border-l border-sms-charcoal-100">{row.shaft ? <span class="text-sms-green-600 font-bold">&check;</span> : <span class="text-sms-charcoal-300">&mdash;</span>}</td>
                <td class="text-center px-4 py-3 border-l border-sms-charcoal-100">{row.chamber ? <span class="text-sms-green-600 font-bold">&check;</span> : <span class="text-sms-charcoal-300">&mdash;</span>}</td>
                <td class="text-center px-4 py-3 border-l border-sms-charcoal-100">{row.hole ? <span class="text-sms-green-600 font-bold">&check;</span> : <span class="text-sms-charcoal-300">&mdash;</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="process-heading">
      <h2 id="process-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">What a WSAA Product Appraisal actually checks</h2>
      <p class="text-sms-charcoal-500 leading-relaxed max-w-[68ch]">
        A WSAA Product Appraisal is an independent review process run by the Water Services
        Association of Australia — it isn't SMS grading its own homework. The appraisal assesses a
        product against the relevant WSA specification (WSA 137:2019 for maintenance shafts,
        chambers and holes), covering material properties, structural performance and manufacturing
        quality control, and results in a formal certificate with a defined validity period that
        water utilities can rely on when accepting a product onto their network. Download the
        current PA 1317 certificate from the <a href="/technical-resources/" class="text-sms-green-600 font-medium hover:underline">Technical Resources hub</a>.
      </p>
    </section>

    <FaqAccordion items={faqs} />
  </div>

  <CtaBand
    heading="Need a certificate for your project file?"
    subtitle="Request the current WSAA appraisal certificate or a specific standard's compliance documentation."
  />
</BaseLayout>
