---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/Hero.astro';
import company from '../../../data/company.json';

const products = await getCollection('products');
const sortedProducts = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Request CAD/BIM & Engineering Drawings | SMS Technical Resources"
  description="Request CAD/BIM models and full engineering drawings for SMS AXEDO and SMS ROMOLD maintenance structures. Commercial-in-confidence assets, verified and sent directly to your project team."
  canonicalPath="/technical-resources/request-access/"
>
  <Breadcrumbs
    items={[
      { label: 'Technical Resources', href: '/technical-resources/' },
      { label: 'Request CAD & Drawings', href: '/technical-resources/request-access/' },
    ]}
  />
  <Hero
    title="Request CAD/BIM files and engineering drawings"
    subtitle="Full dimensional CAD/BIM models and engineering drawings are commercial-in-confidence and supplied directly to the engineer or contractor working on a specific project. Tell us what you need and we'll verify and send it through."
    compact
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 grid lg:grid-cols-5 gap-12">
    <div class="lg:col-span-3">
      <h2 class="text-2xl font-bold text-sms-charcoal-900 mb-2">Request access</h2>
      <p class="text-sm text-sms-charcoal-500 mb-6">
        Fields marked * are required. We'll only use these details to verify your request and send
        the files. See our note on data use below the form.
      </p>

      <form
        name="download-request"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/technical-resources/request-access/thank-you/"
        class="space-y-5"
      >
        <input type="hidden" name="form-name" value="download-request" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Full name *</label>
            <input type="text" id="name" name="name" required class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Company *</label>
            <input type="text" id="company" name="company" required class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="email" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Work email *</label>
            <input type="email" id="email" name="email" required class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Phone</label>
            <input type="tel" id="phone" name="phone" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label for="role" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Your role *</label>
            <select id="role" name="role" required class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none">
              <option value="">Select one</option>
              <option value="Design engineer / specifier">Design engineer / specifier</option>
              <option value="Civil contractor / installer">Civil contractor / installer</option>
              <option value="Water utility / asset owner">Water utility / asset owner</option>
              <option value="Distributor / reseller">Distributor / reseller</option>
              <option value="Other">Other</option>
            </select>
          </div>
          <div>
            <label for="product" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Product</label>
            <select id="product" name="product" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none">
              <option value="">Not sure / multiple products</option>
              {sortedProducts.map((p) => (
                <option value={p.id}>{p.data.title}</option>
              ))}
            </select>
          </div>
        </div>

        <fieldset>
          <legend class="block text-sm font-medium text-sms-charcoal-700 mb-2">What do you need? *</legend>
          <div class="space-y-2">
            <label class="flex items-center gap-2 text-sm text-sms-charcoal-700">
              <input type="checkbox" name="asset" value="CAD/BIM model (DWG/RVT/IFC)" class="rounded border-sms-charcoal-300 text-sms-green-600 focus:ring-sms-green-600" />
              CAD/BIM model (DWG / Revit / IFC)
            </label>
            <label class="flex items-center gap-2 text-sm text-sms-charcoal-700">
              <input type="checkbox" name="asset" value="Full engineering drawings (PDF)" class="rounded border-sms-charcoal-300 text-sms-green-600 focus:ring-sms-green-600" />
              Full engineering drawings (PDF)
            </label>
            <label class="flex items-center gap-2 text-sm text-sms-charcoal-700">
              <input type="checkbox" name="asset" value="Something else" class="rounded border-sms-charcoal-300 text-sms-green-600 focus:ring-sms-green-600" />
              Something else (tell us in the notes below)
            </label>
          </div>
        </fieldset>

        <div>
          <label for="project" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Project name / notes</label>
          <textarea id="project" name="project" rows="4" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" placeholder="Project name, location, install depth, timeframe: anything that helps us send the right files"></textarea>
        </div>

        <label class="flex items-start gap-2 text-sm text-sms-charcoal-500">
          <input type="checkbox" name="consent" required class="mt-1 rounded border-sms-charcoal-300 text-sms-green-600 focus:ring-sms-green-600" />
          <span>
            I understand SMS CAD/BIM files and engineering drawings are commercial-in-confidence,
            provided for use on a specific project, and my details will be used to verify this
            request and get the right files to me. *
          </span>
        </label>

        <button type="submit" class="inline-flex items-center rounded-md bg-sms-charcoal-900 px-6 py-3 text-base font-semibold text-white hover:bg-sms-charcoal-700 transition-colors">
          Send request
        </button>
      </form>

      <script>
        const params = new URLSearchParams(window.location.search);
        const product = params.get('product');
        if (product) {
          const select = document.getElementById('product');
          if (select instanceof HTMLSelectElement && [...select.options].some((o) => o.value === product)) {
            select.value = product;
          }
        }
        const asset = params.get('asset');
        if (asset) {
          document.querySelectorAll('input[name="asset"]').forEach((el) => {
            if (el instanceof HTMLInputElement && el.value === asset) el.checked = true;
          });
        }
      </script>
    </div>

    <div class="lg:col-span-2 space-y-8">
      <div class="border-t border-sms-charcoal-100 pt-5">
        <h2 class="font-bold text-sms-charcoal-900 mb-3">Why this is a request form, not a direct download</h2>
        <p class="text-sm text-sms-charcoal-500 leading-relaxed">
          CAD/BIM models and full engineering drawings are commercial-in-confidence documents. They
          go directly to the specifier or contractor working on a real project, not into a public
          download library. Most requests are reviewed and sent within one business day.
        </p>
      </div>

      <div class="border-t border-sms-charcoal-100 pt-5">
        <h2 class="font-bold text-sms-charcoal-900 mb-3">In a hurry?</h2>
        <p class="text-sm text-sms-charcoal-500 leading-relaxed mb-4">
          Call the team directly and we'll get the right file moving straight away.
        </p>
        <a href={`tel:${company.phoneHref}`} class="sms-link font-semibold">{company.phone}</a>
      </div>

      <div class="border-t border-sms-charcoal-100 pt-5">
        <h2 class="font-bold text-sms-charcoal-900 mb-3">Already public</h2>
        <p class="text-sm text-sms-charcoal-500 leading-relaxed">
          Product brochures and the WSAA appraisal certificate don't need a request. Download them
          directly from the <a href="/technical-resources/" class="sms-link font-medium">Technical Resources hub</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
