---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import CtaBand from '../../components/CtaBand.astro';

const products = await getCollection('products');
// Fittings & accessories aren't ready for launch — excluded so this list
// doesn't link to a product page that [slug].astro's getStaticPaths won't
// build. Re-enable together with that filter.
const withDownloads = products
  .filter((p) => p.data.category !== 'accessory' && p.data.downloads.length > 0)
  .sort((a, b) => a.data.order - b.data.order);
const withRestricted = withDownloads.filter((p) => p.data.downloads.some((d) => d.restricted));

const certificate = {
  label: 'WSAA Product Appraisal PA 1317 Certificate',
  file: '/downloads/WSAA-PA1317-Issue5-Certificate.pdf',
};

const assetToParam = (label: string) =>
  label.toLowerCase().includes('drawing') ? 'Full engineering drawings (PDF)' : 'CAD/BIM model (DWG/RVT/IFC)';
---

<BaseLayout
  title="Technical Resources | SMS Brochures, Drawings & Approvals"
  description="Download SMS product brochures and the WSAA PA 1317 appraisal certificate directly, or request CAD/BIM models and full engineering drawings for an active project."
  canonicalPath="/technical-resources/"
>
  <Breadcrumbs items={[{ label: 'Technical Resources', href: '/technical-resources/' }]} />
  <Hero
    eyebrow="Technical resources"
    title="Brochures, drawings, CAD/BIM and approvals in one place"
    subtitle="Brochures and the current WSAA appraisal certificate download straight from here. CAD/BIM models and full engineering drawings are commercial-in-confidence, so those go out on request."
    compact
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <section aria-labelledby="certs-heading">
      <h2 id="certs-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">Public downloads</h2>
      <p class="text-sm text-sms-charcoal-500 mb-6 max-w-[68ch]">No form required. These are free to download for anyone.</p>
      <a href={certificate.file} download class="flex items-center gap-3 rounded-lg border border-sms-charcoal-100 p-5 hover:border-sms-green-300 hover:shadow-md transition-all mb-4">
        <span class="font-semibold text-sms-charcoal-900">{certificate.label}</span>
        <span class="sms-link text-sm font-medium ml-auto">Download PDF &rarr;</span>
      </a>
      <div class="grid sm:grid-cols-2 gap-4">
        {withDownloads.map((p) =>
          p.data.downloads.filter((d) => !d.restricted).map((d) =>
            d.file ? (
              <a href={d.file} download class="flex items-center gap-3 rounded-lg border border-sms-charcoal-100 p-5 hover:border-sms-green-300 hover:shadow-md transition-all">
                <span>
                  <span class="block font-semibold text-sms-charcoal-900 text-sm">{d.label}</span>
                  <span class="block text-xs text-sms-charcoal-400 mt-1">{p.data.title} &middot; {d.fileType}</span>
                </span>
                <span class="sms-link text-sm font-medium ml-auto shrink-0">Download &rarr;</span>
              </a>
            ) : (
              <div class="flex items-center gap-3 rounded-lg border border-dashed border-sms-charcoal-200 p-5" aria-disabled="true">
                <span>
                  <span class="block font-semibold text-sms-charcoal-400 text-sm">{d.label}</span>
                  <span class="block text-xs text-sms-charcoal-400 mt-1">{p.data.title} &middot; {d.fileType}</span>
                </span>
                <span class="text-sm text-sms-charcoal-300 font-medium ml-auto shrink-0">Coming soon</span>
              </div>
            )
          )
        )}
      </div>
    </section>

    <section aria-labelledby="gated-heading" class="rounded-2xl border border-sms-charcoal-100 bg-sms-charcoal-50 p-8">
      <h2 id="gated-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">CAD/BIM files & full engineering drawings</h2>
      <p class="text-sm text-sms-charcoal-500 mb-6 max-w-[68ch]">
        These go to the person working on the actual project, not into a public library. Tell us the
        product, the file type and roughly what the job is. Usually back to you within one business day.
      </p>
      <div class="grid sm:grid-cols-2 gap-4 mb-6">
        {withRestricted.map((p) =>
          p.data.downloads.filter((d) => d.restricted).map((d) => (
            <a
              href={`/technical-resources/request-access/?product=${p.id}&asset=${encodeURIComponent(assetToParam(d.label))}`}
              class="flex items-center gap-3 rounded-lg border border-sms-charcoal-200 bg-white p-5 hover:border-sms-green-300 hover:shadow-md transition-all"
            >
              <span>
                <span class="block font-semibold text-sms-charcoal-900 text-sm">{d.label}</span>
                <span class="block text-xs text-sms-charcoal-400 mt-1">{p.data.title}</span>
              </span>
              <span class="sms-link text-sm font-medium ml-auto shrink-0">Request &rarr;</span>
            </a>
          ))
        )}
      </div>
      <a href="/technical-resources/request-access/" class="inline-flex items-center rounded-md bg-sms-charcoal-900 px-6 py-3 text-sm font-semibold text-white hover:bg-sms-charcoal-700 transition-colors">
        Request CAD/BIM or drawings &rarr;
      </a>
    </section>
  </div>

  <CtaBand
    heading="Need drawings or specs for a tender?"
    subtitle="Tell us the product and project and we'll get the right documentation to you."
  />
</BaseLayout>
