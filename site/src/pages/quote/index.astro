---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import company from '../../data/company.json';

const products = await getCollection('products');
const families = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);
const accessories = products
  .filter((p) => p.data.category === 'accessory')
  .sort((a, b) => a.data.order - b.data.order);

const steps = [
  { n: '1', title: 'Add products to your quote', body: 'Pick a quantity (and configuration, where relevant) for each product you need and add it to your quote list below.' },
  { n: '2', title: 'Submit your request', body: 'Add your contact and project details and send it through. No pricing is generated automatically.' },
  { n: '3', title: 'SMS reviews & replies', body: 'Our team checks pricing, availability and lead time for every line item and sends your formal quote by email within 2 business days.' },
];
---

<BaseLayout
  title="Get a Quote | SMS Sewer Maintenance Structures"
  description="Build a quote from the SMS AXEDO and SMS ROMOLD product range. Add products and quantities, submit your request, and our team will send a reviewed quote within 2 business days."
  canonicalPath="/quote/"
>
  <Breadcrumbs items={[{ label: 'Get a Quote', href: '/quote/' }]} />
  <Hero
    eyebrow="Get a quote"
    title="Build your own quote"
    subtitle="Add the products and quantities you need, tell us about your project, and an SMS team member will review it and send your formal quote within 2 business days."
    compact
  />

  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12">
    <section aria-labelledby="how-it-works-heading" class="mb-16">
      <h2 id="how-it-works-heading" class="sr-only">How it works</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        {steps.map((s) => (
          <div class="border-t border-sms-charcoal-100 pt-5">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-sms-green-600 text-white font-bold text-sm mb-3">{s.n}</span>
            <h3 class="font-bold text-sms-charcoal-900 mb-2">{s.title}</h3>
            <p class="text-sm text-sms-charcoal-500 leading-relaxed">{s.body}</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="picker-heading" class="mb-16">
      <h2 id="picker-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">1. Select your products</h2>
      <p class="text-sm text-sms-charcoal-500 mb-8 max-w-[68ch]">
        Not sure which configuration you need? Leave it on "Not sure / standard" and SMS will confirm the
        right part code when reviewing your request. See each product's full spec page for details.
      </p>

      <h3 class="text-sm font-bold uppercase tracking-wide text-sms-charcoal-400 mb-4">Maintenance structures</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        {families.map((p) => (
          <div data-product-card data-slug={p.id} class="rounded-xl border border-sms-charcoal-100 p-5 transition-shadow">
            <div class:list={["aspect-4/3 rounded-lg flex items-center justify-center overflow-hidden mb-4", p.data.productImageBackground === 'dark' ? 'bg-sms-charcoal-900' : 'bg-sms-charcoal-50']}>
              {p.data.productImage ? (
                <Image src={p.data.productImage} alt={p.data.productImageAlt ?? ''} class="h-full w-full object-contain p-3" widths={[240, 320]} sizes="240px" />
              ) : (
                <span class="text-xs text-sms-charcoal-300">Product render</span>
              )}
            </div>
            <p class="text-xs font-semibold tracking-wide uppercase text-sms-green-600">{p.data.brand}{p.data.dnSize ? ` · ${p.data.dnSize}` : ''}</p>
            <h4 class="font-bold text-sms-charcoal-900 mb-3">{p.data.title}</h4>

            {p.data.configurations.length > 0 && (
              <div class="mb-3">
                <label class="block text-xs font-medium text-sms-charcoal-700 mb-1">Configuration</label>
                <select data-config class="w-full rounded-md border border-sms-charcoal-200 px-2 py-1.5 text-sm focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none">
                  <option value="">Not sure / standard</option>
                  {p.data.configurations.map((c) => (
                    <option value={c.code}>{c.code} — {c.configuration}{c.size ? ` (${c.size})` : ''}</option>
                  ))}
                </select>
              </div>
            )}

            <div class="flex items-end gap-3">
              <div class="w-20">
                <label class="block text-xs font-medium text-sms-charcoal-700 mb-1">Qty</label>
                <input data-qty type="number" min="1" step="1" value="1" class="w-full rounded-md border border-sms-charcoal-200 px-2 py-1.5 text-sm focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
              </div>
              <button
                type="button"
                data-add-product
                data-slug={p.id}
                data-title={p.data.title}
                class="grow inline-flex items-center justify-center rounded-md bg-sms-green-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-sms-green-700 transition-colors"
              >
                Add to quote
              </button>
            </div>
            <p data-added-feedback class="hidden mt-2 text-xs font-medium text-sms-green-600">Added to your quote &check;</p>
          </div>
        ))}
      </div>

      <h3 class="text-sm font-bold uppercase tracking-wide text-sms-charcoal-400 mb-4">Fittings & accessories</h3>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {accessories.map((p) => (
          <div data-product-card data-slug={p.id} class="rounded-xl border border-sms-charcoal-100 p-5 transition-shadow">
            <div class:list={["aspect-4/3 rounded-lg flex items-center justify-center overflow-hidden mb-4", p.data.productImageBackground === 'dark' ? 'bg-sms-charcoal-900' : 'bg-sms-charcoal-50']}>
              {p.data.productImage ? (
                <Image src={p.data.productImage} alt={p.data.productImageAlt ?? ''} class="h-full w-full object-contain p-3" widths={[240, 320]} sizes="240px" />
              ) : (
                <span class="text-xs text-sms-charcoal-300">Product render</span>
              )}
            </div>
            <p class="text-xs font-semibold tracking-wide uppercase text-sms-green-600">{p.data.brand}</p>
            <h4 class="font-bold text-sms-charcoal-900 mb-3">{p.data.title}</h4>

            {p.data.configurations.length > 0 && (
              <div class="mb-3">
                <label class="block text-xs font-medium text-sms-charcoal-700 mb-1">Configuration</label>
                <select data-config class="w-full rounded-md border border-sms-charcoal-200 px-2 py-1.5 text-sm focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none">
                  <option value="">Not sure / standard</option>
                  {p.data.configurations.map((c) => (
                    <option value={c.code}>{c.code} — {c.configuration}{c.size ? ` (${c.size})` : ''}</option>
                  ))}
                </select>
              </div>
            )}

            <div class="flex items-end gap-3">
              <div class="w-20">
                <label class="block text-xs font-medium text-sms-charcoal-700 mb-1">Qty</label>
                <input data-qty type="number" min="1" step="1" value="1" class="w-full rounded-md border border-sms-charcoal-200 px-2 py-1.5 text-sm focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
              </div>
              <button
                type="button"
                data-add-product
                data-slug={p.id}
                data-title={p.data.title}
                class="grow inline-flex items-center justify-center rounded-md bg-sms-green-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-sms-green-700 transition-colors"
              >
                Add to quote
              </button>
            </div>
            <p data-added-feedback class="hidden mt-2 text-xs font-medium text-sms-green-600">Added to your quote &check;</p>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="list-heading" class="mb-16 scroll-mt-24" id="quote-list">
      <h2 id="list-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">
        2. Your quote list <span class="text-sms-charcoal-400 font-normal">(<span id="quote-count">0</span> items)</span>
      </h2>
      {/* Toggling an element's visibility with unchanged text doesn't reliably
          announce, so add/remove confirmations are written into this region
          instead. The visible green tick stays for sighted users. */}
      <p id="quote-live" role="status" aria-live="polite" class="sr-only"></p>
      <div class="rounded-xl border border-sms-charcoal-100 overflow-hidden">
        <p id="quote-empty-state" class="p-6 text-sm text-sms-charcoal-400">
          You haven't added anything yet. Add products above to start your quote.
        </p>
        <ul id="quote-items-list" class="divide-y divide-sms-charcoal-100"></ul>
      </div>
      <button type="button" id="quote-clear-btn" class="hidden mt-4 text-sm font-medium text-sms-charcoal-400 hover:text-sms-charcoal-700">
        Clear all items
      </button>
    </section>

    <section aria-labelledby="submit-heading" class="grid lg:grid-cols-5 gap-12">
      <div class="lg:col-span-3">
        <h2 id="submit-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">3. Submit your quote request</h2>
        <p class="text-sm text-sms-charcoal-500 mb-6 max-w-[68ch]">
          Fields marked * are required. This sends your itemised list above to SMS for review; it does
          not generate pricing automatically.
        </p>

        <p id="quote-empty-error" role="alert" class="hidden mb-4 rounded-md border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700">
          Add at least one product to your quote list before submitting.
        </p>

        <form
          id="quote-form"
          name="quote-request"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/quote/thank-you/"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="quote-request" />
          <input type="hidden" name="quote-items" id="quote-items-field" />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Full name *</label>
              <input type="text" id="name" name="name" required class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Company *</label>
              <input type="text" id="company" name="company" required class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Work email *</label>
              <input type="email" id="email" name="email" required class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Phone</label>
              <input type="tel" id="phone" name="phone" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="project" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Project name / site address</label>
              <input type="text" id="project" name="project" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
            <div>
              <label for="timeframe" class="block text-sm font-medium text-sms-charcoal-700 mb-1">When do you need this?</label>
              <select id="timeframe" name="timeframe" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none">
                <option value="">Select one</option>
                <option value="As soon as possible">As soon as possible</option>
                <option value="1-2 weeks">1–2 weeks</option>
                <option value="1-3 months">1–3 months</option>
                <option value="Just researching / budgeting">Just researching / budgeting</option>
              </select>
            </div>
          </div>

          <div>
            <label for="notes" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Anything else we should know?</label>
            <textarea id="notes" name="notes" rows="4" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" placeholder="Install depth, inlet sizes, site access constraints, delivery location, or anything else that helps us quote accurately"></textarea>
          </div>

          <label class="flex items-start gap-2 text-sm text-sms-charcoal-500">
            <input type="checkbox" name="consent" required class="mt-1 rounded border-sms-charcoal-300 text-sms-green-600 focus:ring-sms-green-600" />
            <span>
              I understand this is a quote request, not an order, and that SMS will review it and reply
              by email, usually within 2 business days. *
            </span>
          </label>

          <button
            type="submit"
            id="quote-submit-btn"
            disabled
            class="inline-flex items-center rounded-md bg-sms-green-600 px-6 py-3 text-base font-semibold text-white hover:bg-sms-green-700 transition-colors disabled:bg-sms-charcoal-100 disabled:text-sms-charcoal-500 disabled:cursor-not-allowed"
          >
            Submit quote request
          </button>
        </form>
      </div>

      <div class="lg:col-span-2 space-y-8">
        <div class="border-t border-sms-charcoal-100 pt-5">
          <h2 class="font-bold text-sms-charcoal-900 mb-3">What happens after you submit</h2>
          <p class="text-sm text-sms-charcoal-500 leading-relaxed">
            An SMS team member checks pricing, stock availability and lead time for every item on your
            list, confirms the right configuration for anything marked "not sure", and emails your
            formal quote back to you, usually within <strong>2 business days</strong>.
          </p>
        </div>

        <div class="border-t border-sms-charcoal-100 pt-5">
          <h2 class="font-bold text-sms-charcoal-900 mb-3">Need it faster?</h2>
          <p class="text-sm text-sms-charcoal-500 leading-relaxed mb-4">
            Call the team directly and we'll get your quote moving straight away.
          </p>
          <a href={`tel:${company.phoneHref}`} class="text-sms-green-600 font-semibold">{company.phone}</a>
        </div>

        <div class="border-t border-sms-charcoal-100 pt-5">
          <h2 class="font-bold text-sms-charcoal-900 mb-3">Still comparing options?</h2>
          <p class="text-sm text-sms-charcoal-500 leading-relaxed">
            Browse full spec tables and part codes on the <a href="/products/" class="text-sms-green-600 font-medium hover:underline">product range</a> page, or check <a href="/applications/" class="text-sms-green-600 font-medium hover:underline">which product fits your application</a> before you add items to your quote.
          </p>
        </div>
      </div>
    </section>
  </div>

  <script>
    interface QuoteItem {
      title: string;
      qty: number;
      configLabel: string;
    }

    const STORAGE_KEY = 'sms-quote-items';

    function loadItems(): QuoteItem[] {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch {
        return [];
      }
    }

    function saveItems(items: QuoteItem[]): void {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
      // The header badge lives in a separate script; storage events only fire in
      // *other* tabs, so tell this page's header directly.
      window.dispatchEvent(new CustomEvent('sms-quote-change', { detail: { count: items.length } }));
    }

    function announce(message: string): void {
      const region = document.getElementById('quote-live');
      if (region) region.textContent = message;
    }

    function renderList(): void {
      const items = loadItems();
      const list = document.getElementById('quote-items-list');
      const emptyState = document.getElementById('quote-empty-state');
      const countEl = document.getElementById('quote-count');
      const submitBtn = document.getElementById('quote-submit-btn');
      const clearBtn = document.getElementById('quote-clear-btn');
      const hiddenField = document.getElementById('quote-items-field');
      if (
        !list ||
        !emptyState ||
        !countEl ||
        !(submitBtn instanceof HTMLButtonElement) ||
        !(hiddenField instanceof HTMLInputElement) ||
        !clearBtn
      ) return;

      list.innerHTML = '';
      if (items.length === 0) {
        emptyState.classList.remove('hidden');
        clearBtn.classList.add('hidden');
      } else {
        emptyState.classList.add('hidden');
        clearBtn.classList.remove('hidden');
        items.forEach((item, index) => {
          const li = document.createElement('li');
          li.className = 'flex items-center justify-between gap-4 p-4';
          const info = document.createElement('div');
          const titleEl = document.createElement('p');
          titleEl.className = 'font-semibold text-sms-charcoal-900';
          titleEl.textContent = item.title;
          const metaEl = document.createElement('p');
          metaEl.className = 'text-sm text-sms-charcoal-500';
          metaEl.textContent = `Qty: ${item.qty}${item.configLabel ? ' · ' + item.configLabel : ''}`;
          info.appendChild(titleEl);
          info.appendChild(metaEl);

          const removeBtn = document.createElement('button');
          removeBtn.type = 'button';
          removeBtn.className = 'shrink-0 text-sm font-medium text-sms-charcoal-400 hover:text-red-600';
          removeBtn.textContent = 'Remove';
          removeBtn.dataset.removeIndex = String(index);

          li.appendChild(info);
          li.appendChild(removeBtn);
          list.appendChild(li);
        });
      }

      countEl.textContent = String(items.length);
      submitBtn.disabled = items.length === 0;
      hiddenField.value = items
        .map((item, i) => `${i + 1}. ${item.title} — Qty: ${item.qty}${item.configLabel ? ' — Config: ' + item.configLabel : ' — Config: not specified'}`)
        .join('\n');
    }

    document.querySelectorAll('[data-add-product]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const card = btn.closest('[data-product-card]');
        if (!card) return;
        const title = btn.getAttribute('data-title') || '';
        const qtyInput = card.querySelector('[data-qty]');
        const configSelect = card.querySelector('[data-config]');
        const qty = qtyInput instanceof HTMLInputElement
          ? Math.max(1, parseInt(qtyInput.value || '1', 10) || 1)
          : 1;
        const configLabel = configSelect instanceof HTMLSelectElement && configSelect.value
          ? configSelect.options[configSelect.selectedIndex].text
          : '';

        const items = loadItems();
        items.push({ title, qty, configLabel });
        saveItems(items);
        renderList();
        announce(`${title} added. ${items.length} ${items.length === 1 ? 'item' : 'items'} in your quote.`);

        const feedback = card.querySelector('[data-added-feedback]');
        if (feedback) {
          feedback.classList.remove('hidden');
          setTimeout(() => feedback.classList.add('hidden'), 1500);
        }
      });
    });

    const listEl = document.getElementById('quote-items-list');
    if (listEl) {
      listEl.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof HTMLElement)) return;
        const btn = target.closest('[data-remove-index]');
        if (!(btn instanceof HTMLElement)) return;
        const index = parseInt(btn.dataset.removeIndex || '-1', 10);
        const items = loadItems();
        if (index >= 0 && index < items.length) {
          const [removed] = items.splice(index, 1);
          saveItems(items);
          renderList();
          announce(`${removed.title} removed. ${items.length} ${items.length === 1 ? 'item' : 'items'} in your quote.`);
        }
      });
    }

    const clearBtn = document.getElementById('quote-clear-btn');
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        saveItems([]);
        renderList();
        announce('Quote list cleared.');
      });
    }

    const form = document.getElementById('quote-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        const items = loadItems();
        if (items.length === 0) {
          e.preventDefault();
          const err = document.getElementById('quote-empty-error');
          if (err) {
            err.classList.remove('hidden');
            err.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      });
    }

    renderList();

    const params = new URLSearchParams(window.location.search);
    const addSlug = params.get('add');
    if (addSlug) {
      const card = document.querySelector(`[data-product-card][data-slug="${CSS.escape(addSlug)}"]`);
      if (card instanceof HTMLElement) {
        const addBtn = card.querySelector('[data-add-product]');
        if (addBtn instanceof HTMLElement) addBtn.click();
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('ring-2', 'ring-sms-green-500');
      }
    }
  </script>
</BaseLayout>
