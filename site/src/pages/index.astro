---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import heroImage from '../assets/images/hero-install-chamber.jpg';

const products = await getCollection('products');
const families = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);

const whyPlastic = [
  {
    title: 'Corrosion & H2S resistant',
    body: 'Polypropylene handles pH 1–13. The hydrogen sulphide and sulphuric acid that eat concrete sewer structures don\'t touch it.',
  },
  {
    title: 'Manual install, faster on site',
    body: 'One or two installers place the base, riser and cover using the excavator already there for the dig. No formwork, no cure time. Backfill the same day.',
  },
  {
    title: '100-year design life',
    body: 'Appraised under WSAA PA 1317 to WSA 137:2019. The certificate is on this site if you need it for a submission.',
  },
];

const applications = [
  {
    audience: 'Water utilities & asset owners',
    body: 'PA 1317 to WSA 137:2019 means it goes on the asset register with the paperwork already done. 100-year design life and no H2S corrosion, so it stays off the renewals program.',
    href: '/applications/#utilities',
  },
  {
    audience: 'Civil contractors & plumbers',
    body: 'Base, riser and cover come as separate parts, all light enough to place by hand. No pit-builder to book, no cure time, backfill the same day.',
    href: '/applications/#contractors',
  },
];
---

<BaseLayout
  title="SMS | WSAA-Approved Polypropylene Sewer Maintenance Structures Australia"
  description="SMS AXEDO and SMS ROMOLD polypropylene sewer maintenance shafts, chambers and holes. WSAA PA 1317 appraised, Class D rated, 100-year design life, installed by hand. National coverage."
  canonicalPath="/"
>
  <Hero
    title="Sewer access systems, engineered to outlast concrete."
    subtitle="Polypropylene maintenance holes, chambers and shafts from DN375 to DN1000. Appraised to WSA 137:2019, rated to Class D maximum, light enough to install by hand."
    image={heroImage}
    imageAlt="SMS technician hand-installing a polypropylene maintenance structure base into a sewer trench, excavator in background"
    primaryCta={{ label: 'Explore the Range', href: '/products/' }}
  />

  <TrustStrip />

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16" aria-labelledby="products-heading">
    <div class="flex items-end justify-between gap-4 mb-4">
      <h2 id="products-heading" class="text-2xl sm:text-3xl font-bold text-sms-charcoal-900">The SMS range</h2>
      <a href="/products/" class="sms-link text-sm font-semibold shrink-0">All products &rarr;</a>
    </div>
    <p class="text-sms-charcoal-500 leading-relaxed max-w-[68ch] mb-8">
      DN375, DN600 and DN1000. That covers reticulation through to trunk sewer access, and all three are
      appraised under WSA 137:2019.
    </p>
    <div id="range-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {families.map((p, i) => (
        <div class="range-tile" style={`transition-delay: ${i * 120}ms`}>
          <ProductCard
            href={`/products/${p.id}/`}
            title={p.data.title}
            dnSize={p.data.dnSize}
            brand={p.data.brand}
            useCase={p.data.cardUseCase}
            image={p.data.productImage}
            imageAlt={p.data.productImageAlt}
            imageBackground={p.data.productImageBackground}
          />
        </div>
      ))}
    </div>
  </section>

  <style>
    .range-tile {
      opacity: 0;
      transform: translateY(2.5rem);
      transition: opacity 0.6s ease-out, transform 0.6s ease-out;
    }
    .range-tile.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
    @media (prefers-reduced-motion: reduce) {
      .range-tile {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    const tiles = document.querySelectorAll<HTMLElement>('#range-grid .range-tile');
    if (tiles.length) {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) {
        tiles.forEach((tile) => tile.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 }
        );
        tiles.forEach((tile) => observer.observe(tile));
      }
    }
  </script>

  <section class="bg-sms-charcoal-50 py-16" aria-labelledby="why-plastic-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 id="why-plastic-heading" class="text-2xl sm:text-3xl font-bold text-sms-charcoal-900">Why plastic vs concrete</h2>
        <a href="/why-plastic-vs-concrete/" class="sms-link text-sm font-semibold shrink-0">Full comparison &rarr;</a>
      </div>
      <p class="text-sms-charcoal-500 leading-relaxed max-w-[68ch] mb-8">
        Sewer gas corrodes concrete from the inside out. It's the main reason these structures fail, and
        polypropylene doesn't react to it at all. What that means on site:
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {whyPlastic.map((item) => (
          <div class="border-t border-sms-charcoal-100 pt-5">
            <h3 class="font-bold text-sms-charcoal-900 mb-2">{item.title}</h3>
            <p class="text-sm text-sms-charcoal-500 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16" aria-labelledby="applications-heading">
    <h2 id="applications-heading" class="text-2xl sm:text-3xl font-bold text-sms-charcoal-900 mb-4">Built for utilities and contractors</h2>
    <p class="text-sms-charcoal-500 leading-relaxed max-w-[68ch] mb-8">
      Same structure, different reasons for specifying it.
    </p>
    <div class="grid sm:grid-cols-2 gap-8">
      {applications.map((item) => (
        <a href={item.href} class="block rounded-xl border border-sms-charcoal-100 p-6 hover:border-sms-green-300 hover:shadow-md transition-all">
          <h3 class="font-bold text-sms-charcoal-900 mb-2">{item.audience}</h3>
          <p class="text-sm text-sms-charcoal-500 leading-relaxed">{item.body}</p>
          <span class="mt-4 inline-block text-sm font-semibold text-sms-charcoal-900 sms-link">Learn more &rarr;</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-sms-charcoal-50 py-16" aria-labelledby="approvals-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 id="approvals-heading" class="text-2xl sm:text-3xl font-bold text-sms-charcoal-900 mb-4">WSAA Appraised</h2>
        <p class="text-sms-charcoal-500 leading-relaxed mb-6">
          The range holds WSAA Product Appraisal PA 1317, is manufactured to WSA 137:2019 and EN 13598-2,
          and takes access covers rated to Class D maximum to AS 3996. Certificates download from this site.
        </p>
        <a href="/approvals/" class="inline-flex items-center rounded-md bg-sms-charcoal-900 px-6 py-3 text-sm font-semibold text-white hover:bg-sms-charcoal-700 transition-colors">
          View approvals & standards &rarr;
        </a>
      </div>
      <ul class="grid grid-cols-2 gap-4">
        {['WSAA PA 1317', 'WSA 137:2019', 'AS 3996 Class D', 'EN 13598-2', 'AS 1646', 'AS/NZS 5065'].map((s) => (
          <li class="rounded-lg border border-sms-charcoal-200 bg-white p-4 text-center font-semibold text-sms-charcoal-900">{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
