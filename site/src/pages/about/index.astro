---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import CtaBand from '../../components/CtaBand.astro';
import LinkedInBadge from '../../components/LinkedInBadge.astro';
import company from '../../data/company.json';
import heroImage from '../../assets/images/hero-install-chamber.jpg';

const products = await getCollection('products');
const families = products
  .filter((p) => p.data.category !== 'accessory' && p.data.countryOfManufacture)
  .sort((a, b) => a.data.order - b.data.order);
// Fittings & accessories aren't ready for launch — excluded so this pill
// list doesn't link to a page that [slug].astro's getStaticPaths won't
// build. Re-enable together with that filter.
const range = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);

const facts = [
  { label: 'Specialising since', value: String(company.foundingYear) },
  { label: 'Design service life', value: '100 years' },
  { label: 'Product appraisal', value: 'PA 1317' },
];
---

<BaseLayout
  title="About SMS | Australia's Sewer Maintenance Structure Specialists"
  description="SMS has specialised in sewer maintenance shafts, chambers and holes since 2003. Part of the Clover group, with a complete range held as stock and in-house technical support."
  canonicalPath="/about/"
>
  <Breadcrumbs items={[{ label: 'About', href: '/about/' }]} />
  <Hero
    eyebrow="About SMS"
    title="One appraised range, from reticulation shafts to person-entry trunk sewer access"
    subtitle="Since 2003 we've supplied one thing: the shafts, chambers and maintenance holes that give a sewer network its access points. Appraised to WSA 137:2019, held as stock, part of the Clover group."
    image={heroImage}
    imageAlt="SMS technician hand-installing a polypropylene maintenance structure base into a sewer trench"
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <section aria-labelledby="intro-heading" class="max-w-[68ch]">
      <h2 id="intro-heading" class="sr-only">Who we are</h2>
      <p class="text-lg text-sms-charcoal-700 leading-relaxed mb-4">
        SMS started in {company.foundingYear} supplying specialist products to the Australian water
        industry, and is now part of the {company.parentCompany} group. Day to day that means you're
        dealing with people who only do maintenance structures, with a national pipeline infrastructure
        group's warehousing and freight behind them.
      </p>
      <p class="text-sms-charcoal-500 leading-relaxed">
        The structures are polypropylene rather than concrete, which makes them lighter to handle and
        immune to sewer gas corrosion. They're accepted by water authorities across Australia. Councils,
        utilities, civil contractors and hydraulic consultants all buy them, usually for different
        reasons.{' '}
        <a href="/applications/" class="sms-link font-medium">See which case applies to you</a>.
      </p>
    </section>

    <section aria-labelledby="facts-heading">
      <h2 id="facts-heading" class="sr-only">SMS at a glance</h2>
      <AtAGlance items={facts} />
    </section>

    <section aria-labelledby="range-heading" class="scroll-mt-24">
      <h2 id="range-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">A complete range, held as stock</h2>
      <div class="max-w-[68ch] space-y-4 mb-8">
        <p class="text-sms-charcoal-500 leading-relaxed">
          Maintenance structures are all we do, so we carry more of them than a general supplier will.
          Shafts, chambers and maintenance holes across every size a gravity sewer network needs, held as
          stock. Custom-angled shafts are assembled to order the same day. Nothing goes to a workshop.
        </p>
        <p class="text-sms-charcoal-500 leading-relaxed">
          Stock is the whole point. If the part is on the shelf, your lead time is freight, not
          manufacturing.
        </p>
      </div>
      <ul class="flex flex-wrap gap-2">
        {range.map((p) => (
          <li>
            <a
              href={`/products/${p.id}/`}
              class="inline-flex items-center rounded-full border border-sms-charcoal-200 px-4 py-2 text-sm font-medium text-sms-charcoal-700 hover:border-sms-green-400 hover:text-sms-charcoal-900 transition-colors"
            >
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="technical-heading" class="max-w-[68ch] scroll-mt-24">
      <h2 id="technical-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">Technical support and R&amp;D</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-4">
        Our in-house team handles product selection, standards compliance and system design questions from
        specifiers, consultants and asset owners. They work directly with Dyka and Romold, who manufacture
        the range and do the research and development behind it.
      </p>
      <p class="text-sms-charcoal-500 leading-relaxed">
        The range is appraised and certified to WSA 137 and the relevant Australian standards. If a project
        needs something the catalogue doesn't cover, ask us before you design around it. Full{' '}
        <a href="/approvals/" class="sms-link font-medium">approvals &amp; standards</a> breakdown.
      </p>
    </section>

    <section aria-labelledby="manufacturing-heading" class="scroll-mt-24">
      <h2 id="manufacturing-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">Our manufacturing partners</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-6 max-w-[68ch]">
        Two European specialists build the range between them under exclusive supply arrangements.
        Dyka BV makes the shaft and the chamber under the AXEDO brand, Romold the maintenance hole.
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {families.map((p) => (
          <a href={`/products/${p.id}/`} class="group rounded-xl border border-sms-charcoal-100 bg-white overflow-hidden hover:border-sms-green-300 hover:shadow-lg transition-all">
            {p.data.productImage && (
              <div class:list={["aspect-4/3 flex items-center justify-center overflow-hidden", p.data.productImageBackground === 'dark' ? 'bg-sms-charcoal-900' : p.data.productImageBackground === 'white' ? 'bg-white' : 'bg-render-bg']}>
                <Image src={p.data.productImage} alt={p.data.productImageAlt ?? ''} class="h-full w-full object-contain p-4" widths={[320, 480]} sizes="(min-width: 640px) 320px, 50vw" />
              </div>
            )}
            {/* The same five facts on every card, in the same order, rather
                than a sentence of manufacturer prose whose shape changed from
                product to product. Read straight off the product data, so a
                spec change upstream carries through here. Depth comes from the
                At a glance row the product pages already publish. */}
            <div class="p-5">
              <span class="block font-semibold text-sms-charcoal-900 transition-colors">{p.data.title}</span>
              <dl class="mt-3 text-sm">
                {[
                  ['Brand', p.data.brand],
                  ['Manufacturer', p.data.manufacturer],
                  ['Made in', p.data.countryOfManufacture],
                  ['Diameter', p.data.dnSize],
                  ['Max depth', p.data.atAGlance.find((r) => r.label === 'Depth')?.value],
                ].map(([label, value]) => (
                  <div class="flex items-baseline justify-between gap-3 border-t border-sms-charcoal-100 py-1.5">
                    <dt class="text-sms-charcoal-400 text-xs uppercase tracking-wide shrink-0">{label}</dt>
                    <dd class:list={['text-right', value ? 'text-sms-charcoal-900 font-medium' : 'text-sms-charcoal-400 italic']}>
                      {value ?? 'To be confirmed'}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="clover-heading" class="border-l-2 border-sms-green-600 pl-6 sm:pl-8 scroll-mt-24">
      <h2 id="clover-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">Part of the {company.parentCompany} group</h2>
      <div class="max-w-[68ch] space-y-4">
        <p class="text-sms-charcoal-700 leading-relaxed">
          Being part of {company.parentCompany} gives SMS the group's warehousing and freight network. That's
          what makes the stock position above possible, and it's why product can get to a regional site
          without a specialist freight run.
        </p>
      </div>
    </section>

    <section aria-labelledby="coverage-heading" class="scroll-mt-24">
      <h2 id="coverage-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">Where we supply</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-4 max-w-[68ch]">
        SMS supplies water utilities and contractors nationally, with active coverage across:
      </p>
      <ul class="flex flex-wrap gap-3">
        {company.coverage.map((c) => (
          <li class="rounded-full border border-sms-charcoal-200 px-4 py-2 text-sm font-medium text-sms-charcoal-700">{c}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="team-heading" class="max-w-[68ch] scroll-mt-24">
      <h2 id="team-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">Talk to the team</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-4">
        Call for product selection, technical data, stock and lead times. If you have a drawing, send it
        through and we'll check the configuration against it.
      </p>
      <ul class="space-y-2 text-sms-charcoal-700">
        <li><a href={`tel:${company.phoneHref}`} class="sms-link font-semibold">{company.phone}</a></li>
        <li><a href={`mailto:${company.email}`} class="sms-link font-semibold">{company.email}</a></li>
        <li class="text-sms-charcoal-500">{company.addressLine1}, {company.addressLine2}</li>
      </ul>
      <LinkedInBadge class="mt-4" />
      <p class="mt-4">
        <a href="/contact/" class="sms-link text-sm font-semibold">Get in touch &rarr;</a>
      </p>
    </section>
  </div>

  <CtaBand />
</BaseLayout>
