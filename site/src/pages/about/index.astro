---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import AtAGlance from '../../components/AtAGlance.astro';
import CtaBand from '../../components/CtaBand.astro';
import company from '../../data/company.json';
import heroImage from '../../assets/images/hero-install-chamber.jpg';

const products = await getCollection('products');
const families = products
  .filter((p) => p.data.category !== 'accessory' && p.data.countryOfManufacture)
  .sort((a, b) => a.data.order - b.data.order);
// Fittings & accessories aren't ready for launch — excluded so this pill
// list doesn't link to a page that [slug].astro's getStaticPaths won't
// build. Re-enable together with that filter.
const range = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);

const facts = [
  { label: 'Specialising since', value: String(company.foundingYear) },
  { label: 'Design service life', value: '100 years' },
  { label: 'Product appraisal', value: 'PA 1317' },
];
---

<BaseLayout
  title="About SMS | Australia's Sewer Maintenance Structure Specialists"
  description="SMS has specialised in sewer maintenance shafts, chambers and holes since 2003. Part of the Clover group, with a complete range held as stock and in-house technical support."
  canonicalPath="/about/"
>
  <Breadcrumbs items={[{ label: 'About', href: '/about/' }]} />
  <Hero
    eyebrow="About SMS"
    title="One appraised range, from reticulation shafts to person-entry trunk sewer access"
    subtitle="For more than two decades we've specialised in one thing — the shafts, chambers and maintenance holes that keep sewerage and drainage networks accessible, serviceable and sound, appraised to WSA 137:2019 and backed by the Clover group."
    image={heroImage}
    imageAlt="SMS technician hand-installing a polypropylene maintenance structure base into a sewer trench"
  />

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <section aria-labelledby="intro-heading" class="max-w-[68ch]">
      <h2 id="intro-heading" class="sr-only">Who we are</h2>
      <p class="text-lg text-sms-charcoal-700 leading-relaxed mb-4">
        Established in {company.foundingYear} to develop and supply specialist products for the Australian
        water industry, SMS is now part of the {company.parentCompany} group of companies. That gives our
        clients the best of both: the focus and product knowledge of a dedicated specialist, backed by the
        scale, resources and engineering depth of one of the country's leading pipeline infrastructure
        providers.
      </p>
      <p class="text-sms-charcoal-500 leading-relaxed">
        Our polypropylene maintenance structures offer a lightweight, safe and cost-effective alternative
        to traditional concrete, and are approved by water authorities across Australia. Whether you're a
        council or water utility maintaining a network, a civil contractor working to a program, or a
        specifier or hydraulic consultant drawing up a system, SMS is built to{' '}
        <a href="/applications/" class="text-sms-green-600 font-medium hover:underline">support the way you work</a>.
      </p>
    </section>

    <section aria-labelledby="facts-heading">
      <h2 id="facts-heading" class="sr-only">SMS at a glance</h2>
      <AtAGlance items={facts} />
    </section>

    <section aria-labelledby="range-heading" class="scroll-mt-24">
      <h2 id="range-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">A complete range, ready when you need it</h2>
      <div class="max-w-[68ch] space-y-4 mb-8">
        <p class="text-sms-charcoal-500 leading-relaxed">
          Specialisation is our advantage. Because sewer maintenance structures are all we do, we carry a
          depth of range that broader suppliers can't — shafts, chambers and maintenance holes across every
          size a gravity sewer network needs, all held as stock and ready to dispatch. Custom-angled shafts
          are assembled to order on the day, with no fabrication and no waiting on the workshop.
        </p>
        <p class="text-sms-charcoal-500 leading-relaxed">
          In a project-based industry, availability is everything. Our commitment to holding genuine stock
          means fewer delays on site, shorter lead times, and the confidence that the part you need is the
          part we have on the shelf.
        </p>
      </div>
      <ul class="flex flex-wrap gap-2">
        {range.map((p) => (
          <li>
            <a
              href={`/products/${p.id}/`}
              class="inline-flex items-center rounded-full border border-sms-charcoal-200 px-4 py-2 text-sm font-medium text-sms-charcoal-700 hover:border-sms-green-400 hover:text-sms-green-600 transition-colors"
            >
              {p.data.title}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="technical-heading" class="max-w-[68ch] scroll-mt-24">
      <h2 id="technical-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">Technical and R&amp;D capability you can build on</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-4">
        Behind every product is real technical depth. Our in-house team supports specifiers, consultants and
        asset owners through product selection, standards compliance and system design — and works
        hand-in-hand with our exclusive manufacturing partners, including Dyka and Romold, whose research
        and development capabilities are among the most advanced in the field.
      </p>
      <p class="text-sms-charcoal-500 leading-relaxed">
        That combination keeps our range at the forefront of the market and firmly aligned to Australian
        requirements, with products appraised and certified to WSA 137 and accredited to the relevant
        industry standards. When a project calls for something beyond the catalogue, we have the people and
        the partnerships to engineer it — see the full{' '}
        <a href="/approvals/" class="text-sms-green-600 font-medium hover:underline">approvals &amp; standards</a> breakdown.
      </p>
    </section>

    <section aria-labelledby="manufacturing-heading" class="scroll-mt-24">
      <h2 id="manufacturing-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">Our manufacturing partners</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-6 max-w-[68ch]">
        Each product family is engineered and manufactured by a specialist European partner under an
        exclusive supply arrangement, rather than one blanket production line for the whole range:
      </p>
      <div class="grid sm:grid-cols-3 gap-6">
        {families.map((p) => (
          <a href={`/products/${p.id}/`} class="group rounded-xl border border-sms-charcoal-100 bg-white overflow-hidden hover:border-sms-green-300 hover:shadow-lg transition-all">
            {p.data.productImage && (
              <div class:list={["aspect-4/3 flex items-center justify-center overflow-hidden", p.data.productImageBackground === 'dark' ? 'bg-sms-charcoal-900' : p.data.productImageBackground === 'white' ? 'bg-white' : 'bg-render-bg']}>
                <Image src={p.data.productImage} alt={p.data.productImageAlt ?? ''} class="h-full w-full object-contain p-4" widths={[320, 480]} sizes="(min-width: 640px) 320px, 50vw" />
              </div>
            )}
            <div class="p-5">
              <span class="font-semibold text-sms-charcoal-900 group-hover:text-sms-green-600 transition-colors">{p.data.title}</span>
              <span class="block text-sm text-sms-green-600 font-medium mt-1">{p.data.countryOfManufacture}</span>
              {p.data.manufacturerNote && <p class="text-xs text-sms-charcoal-400 mt-2">{p.data.manufacturerNote}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="clover-heading" class="border-l-2 border-sms-green-600 pl-6 sm:pl-8 scroll-mt-24">
      <h2 id="clover-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">The strength of the {company.parentCompany} group</h2>
      <div class="max-w-[68ch] space-y-4">
        <p class="text-sms-charcoal-700 leading-relaxed">
          As part of {company.parentCompany}, SMS draws on the same group resources, logistics network and
          service ethos that {company.parentCompany}'s clients rely on — an approach grounded in
          responsiveness, technical rigour and long-standing partnerships. It's a customer-first way of
          working, and it doesn't end at the first order: we deliver on our commitments so you can deliver
          on yours.
        </p>
        <p class="text-sms-charcoal-700 leading-relaxed font-medium">
          The result is a specialist who knows sewer maintenance structures inside out, with the reach and
          reliability of a national infrastructure group standing behind every job.
        </p>
      </div>
    </section>

    <section aria-labelledby="coverage-heading" class="scroll-mt-24">
      <h2 id="coverage-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">Where we supply</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-4 max-w-[68ch]">
        SMS supplies water utilities and contractors nationally, with active coverage across:
      </p>
      <ul class="flex flex-wrap gap-3">
        {company.coverage.map((c) => (
          <li class="rounded-full border border-sms-charcoal-200 px-4 py-2 text-sm font-medium text-sms-charcoal-700">{c}</li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="team-heading" class="max-w-[68ch] scroll-mt-24">
      <h2 id="team-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-4">Get in touch with our team</h2>
      <p class="text-sms-charcoal-500 leading-relaxed mb-4">
        Talk to us about product selection, technical data, stock availability and project support — we're
        here to help you get it right the first time.
      </p>
      <ul class="space-y-2 text-sms-charcoal-700">
        <li><a href={`tel:${company.phoneHref}`} class="font-semibold text-sms-green-600 hover:underline">{company.phone}</a></li>
        <li><a href={`mailto:${company.email}`} class="font-semibold text-sms-green-600 hover:underline">{company.email}</a></li>
      </ul>
      <p class="mt-4">
        <a href="/contact/" class="text-sm font-semibold text-sms-green-600 hover:underline">Get in touch &rarr;</a>
      </p>
    </section>
  </div>

  <CtaBand />
</BaseLayout>
