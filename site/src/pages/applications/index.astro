---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/Hero.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import CtaBand from '../../components/CtaBand.astro';
import applicationsImage from '../../assets/images/brand-lookup-manhole.jpg';

const jumpNav = [
  { id: 'utilities', label: 'Water utilities' },
  { id: 'contractors', label: 'Contractors & plumbers' },
  { id: 'fit-guide', label: 'Which product fits?' },
];

const fitGuide = [
  {
    scenario: 'Standard gravity reticulation access, single inlet/outlet run',
    product: 'DN375 Maintenance Shaft',
    href: '/products/dn375-maintenance-shaft/',
  },
  {
    scenario: 'Larger reticulation junction, multiple inlets or a deeper install',
    product: 'DN600 Maintenance Chamber',
    href: '/products/dn600-maintenance-chamber/',
  },
  {
    scenario: 'Trunk sewer access where person entry is required for inspection or maintenance',
    product: 'DN1000 Maintenance Hole',
    href: '/products/dn1000-maintenance-hole/',
  },
  // Fittings & accessories aren't ready for launch — the two scenarios that
  // pointed at connectors-drop-tee-junctions and bends are removed rather
  // than left linking to a page [slug].astro won't build. Re-add once those
  // products go live.
];

const faqs = [
  {
    question: 'Which SMS product should I use for a standard reticulation connection?',
    answer: 'For most single-inlet reticulation-depth connections, the DN375 Maintenance Shaft is the standard choice. Step up to the DN600 Maintenance Chamber for a larger junction with multiple inlets, and to the DN1000 Maintenance Hole where person entry is required for trunk sewer inspection or maintenance.',
  },
  {
    question: 'Can SMS structures be used on remote or mining sites with limited plant access?',
    answer: 'Yes — this is one of the main reasons contractors specify the range for remote and program works. Base, riser and access cover elements are supplied separately and light enough for 1–2 installers to place by hand using the excavator already on site, so a standard installation doesn\'t need any additional plant mobilised.',
  },
  {
    question: 'What if my project needs a configuration outside the standard part-code tables?',
    answer: 'Base-socket angle tolerance (±2° to ±7.5° depending on product) and the published RRJ configuration tables cover most alignment and inlet/outlet changes with a standard part code. For anything outside that range, contact SMS directly with your project specifics.',
  },
];

const sections = [
  {
    id: 'utilities',
    heading: 'Water utilities & asset owners',
    intro: 'Whole-of-life cost, documented standards compliance and supplier credibility are the priorities for network owners and their procurement teams.',
    points: [
      'WSAA Product Appraisal PA 1317 to WSA 137:2019 — an independent, water-industry-recognised assessment, not just a manufacturer claim.',
      '100-year design life engineered specifically for sewer gas exposure (pH 1–13, H2S/H2SO4 resistant), reducing the corrosion-driven rehabilitation cycle typical of unprotected concrete assets.',
      'Consistent part-code configurations and full spec tables per product family, simplifying asset register and GIS attribute data entry.',
      'National supply across every major Australian market plus the Pacific region, supporting standardisation across a multi-region network.',
    ],
    projectTypes: ['Sewer backlog/renewal programs', 'Reticulation network extensions', 'Failed concrete manhole replacement', 'New development handover assets'],
    bestFit: 'Standardising on one appraised range across DN375–DN1000 covers reticulation through to trunk sewer access with a single set of WSA 137 documentation.',
    cta: { label: 'View approvals & standards', href: '/approvals/' },
  },
  {
    id: 'contractors',
    heading: 'Civil contractors & plumbers',
    intro: 'Install speed, weight, and site availability are what matter when a structure has to go in on program.',
    points: [
      'Base, riser and access cover elements are supplied separately and light enough for 1–2 installers to place by hand, using the excavator already on site for the dig.',
      'On-site height adjustment (riser trimming) and angled base configurations reduce the need for custom fabrication or return trips.',
      'DN100–DN150 lateral drop-in connections can be added on-site with a hole saw and rubber collar kit if an extra inlet is needed after the base is set.',
      'The full range is held as stock and ready to dispatch, and custom-angled shafts are assembled to order on the day — no fabrication lead time waiting on a workshop.',
      'Step-by-step installation guides (bedding, backfill, compaction, access cover fitting) are published on each product page and in the technical resources hub.',
    ],
    projectTypes: ['Residential subdivision developments', 'Remote/mining camp installations', 'Program works with tight install windows', 'Sites with limited plant access'],
    bestFit: 'The DN375 Shaft and DN600 Chamber cover most reticulation-depth connections by hand with the excavator already on site; the DN1000 Hole is the one to reach for once a job needs person entry.',
    cta: { label: 'Installation & depth guidance', href: '/technical-resources/' },
  },
];
---

<BaseLayout
  title="Applications | Who SMS Maintenance Structures Are Built For"
  description="How SMS AXEDO and SMS ROMOLD polypropylene maintenance structures serve water utilities and civil contractors across Australia."
  canonicalPath="/applications/"
>
  <Breadcrumbs items={[{ label: 'Applications', href: '/applications/' }]} />
  <Hero
    eyebrow="Applications"
    title="Built for utilities and contractors"
    subtitle="Different roles need different things from a sewer maintenance structure. Here's how the SMS range answers each — and which product fits your project."
    image={applicationsImage}
    imageAlt="Looking up through an installed SMS maintenance structure and access ladder to street level"
  />

  <nav aria-label="Jump to section" class="border-b border-sms-charcoal-100 bg-sms-charcoal-50">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-4 flex flex-wrap gap-3">
      {jumpNav.map((item) => (
        <a
          href={`#${item.id}`}
          class="inline-flex items-center rounded-full border border-sms-charcoal-200 bg-white px-4 py-1.5 text-sm font-medium text-sms-charcoal-700 hover:border-sms-green-400 hover:text-sms-green-600 transition-colors"
        >
          {item.label}
        </a>
      ))}
    </div>
  </nav>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    {sections.map((s, i) => (
      <Fragment>
      <section id={s.id} aria-labelledby={`${s.id}-heading`} class="scroll-mt-24">
        <h2 id={`${s.id}-heading`} class="text-2xl font-bold text-sms-charcoal-900 mb-3">{s.heading}</h2>
        <p class="text-sms-charcoal-500 mb-6 max-w-[68ch]">{s.intro}</p>
        <ul class="sms-list mb-8">
          {s.points.map((p) => (
            <li class="text-sms-charcoal-700">{p}</li>
          ))}
        </ul>

        <div class="grid sm:grid-cols-2 gap-6 mb-6">
          <div class="border-t border-sms-charcoal-100 pt-5">
            <h3 class="text-sm font-bold uppercase tracking-wide text-sms-charcoal-400 mb-3">Typical project types</h3>
            <ul class="sms-list text-sm text-sms-charcoal-700">
              {s.projectTypes.map((pt) => <li>{pt}</li>)}
            </ul>
          </div>
          <div class="border-l-2 border-sms-green-600 pl-5">
            <h3 class="text-sm font-bold uppercase tracking-wide text-sms-green-600 mb-3">Where to start looking</h3>
            <p class="text-sm text-sms-charcoal-700 leading-relaxed">{s.bestFit}</p>
          </div>
        </div>

        <a href={s.cta.href} class="text-sm font-semibold text-sms-green-600 hover:underline">{s.cta.label} &rarr;</a>
      </section>
      {i < sections.length - 1 && (
        <div class="sms-endmark" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      )}
      </Fragment>
    ))}

    <section id="fit-guide" aria-labelledby="fit-guide-heading" class="scroll-mt-24">
      <h2 id="fit-guide-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-2">Which product fits your application?</h2>
      <p class="text-sm text-sms-charcoal-500 mb-6 max-w-[68ch]">
        A quick cross-reference from project scenario to the SMS product most likely to fit. Check the
        full spec table on each product page to confirm against your exact depth and inlet requirements.
      </p>
      <div class="overflow-x-auto rounded-lg border border-sms-charcoal-100">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-sms-charcoal-900 text-white">
              <th scope="col" class="text-left px-4 py-3 font-semibold">Project scenario</th>
              <th scope="col" class="text-left px-4 py-3 font-semibold">Likely fit</th>
            </tr>
          </thead>
          <tbody>
            {fitGuide.map((row, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-sms-charcoal-50', 'hover:bg-sms-green-50 transition-colors']}>
                <td class="px-4 py-3 text-sms-charcoal-700 align-top">{row.scenario}</td>
                <td class="px-4 py-3 align-top border-l border-sms-charcoal-100">
                  <a href={row.href} class="font-semibold text-sms-green-600 hover:underline">{row.product}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <FaqAccordion items={faqs} />
  </div>

  <CtaBand />
</BaseLayout>
