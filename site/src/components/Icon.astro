---
export type IconName =
  | 'chemical'
  | 'service-life'
  | 'depth'
  | 'ladder'
  | 'load'
  | 'diameter'
  | 'feather'
  | 'joint'
  | 'shield'
  | 'wsaa';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

{name === 'chemical' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="3" aria-hidden="true">
    <path d="M24 6C24 6 12 21 12 29a12 12 0 0024 0C36 21 24 6 24 6Z" stroke="currentColor" stroke-linejoin="round"/>
    <path d="M16 26h16" stroke="currentColor" stroke-linecap="round"/>
  </svg>
)}

{name === 'service-life' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="3" aria-hidden="true">
    <circle cx="24" cy="24" r="18" stroke="currentColor"/>
    <path d="M16 24l6 6 12-12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === 'depth' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="3" aria-hidden="true">
    <line x1="24" y1="6" x2="24" y2="42" stroke="currentColor"/>
    <path d="M19 11l5-5 5 5M19 37l5 5 5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === 'ladder' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="3" aria-hidden="true">
    <circle cx="24" cy="24" r="18" stroke="currentColor"/>
    <path d="M19 14v20M29 14v20M19 20h10M19 28h10" stroke="currentColor" stroke-linecap="round"/>
  </svg>
)}

{name === 'load' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="3" aria-hidden="true">
    <path d="M12 18l4 5 4-5M20 18l4 5 4-5M28 18l4 5 4-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
    <line x1="8" y1="34" x2="40" y2="34" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
  </svg>
)}

{name === 'diameter' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="3" aria-hidden="true">
    <circle cx="24" cy="24" r="16" stroke="currentColor"/>
    <line x1="10" y1="24" x2="38" y2="24" stroke="currentColor" stroke-linecap="round"/>
  </svg>
)}

{name === 'feather' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="2.5" aria-hidden="true">
    <path d="M36 6Q6 10 14 38" stroke="currentColor" stroke-linecap="round"/>
    <path d="M36 6Q18 20 14 38" stroke="currentColor" stroke-linecap="round"/>
    <line x1="30" y1="13" x2="21" y2="11" stroke="currentColor" stroke-linecap="round"/>
    <line x1="24" y1="21" x2="14" y2="19" stroke="currentColor" stroke-linecap="round"/>
    <line x1="19" y1="29" x2="10" y2="27" stroke="currentColor" stroke-linecap="round"/>
  </svg>
)}

{name === 'joint' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="2.5" aria-hidden="true">
    <rect x="4" y="20" width="40" height="8" rx="4" stroke="currentColor"/>
    <rect x="18" y="14" width="12" height="20" rx="3" stroke="currentColor"/>
    <line x1="24" y1="14" x2="24" y2="34" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1 3.5" stroke-linecap="round"/>
  </svg>
)}

{name === 'shield' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="2.5" aria-hidden="true">
    <path d="M24 6l14 5v11c0 10-6 16-14 20-8-4-14-10-14-20V11l14-5Z" stroke="currentColor" stroke-linejoin="round"/>
    <path d="M15 20q3-3 6 0t6 0t6 0" stroke="currentColor" stroke-linecap="round"/>
    <path d="M15 27q3-3 6 0t6 0t6 0" stroke="currentColor" stroke-linecap="round"/>
  </svg>
)}

{name === 'wsaa' && (
  <svg class={className} viewBox="0 0 48 48" fill="none" stroke-width="2.5" aria-hidden="true">
    <circle cx="24" cy="20" r="12" stroke="currentColor"/>
    <path d="M18 20l4 4 8-8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M17 30l-4 12 7-4 4 5 4-5 7 4-4-12" stroke="currentColor" stroke-linejoin="round" stroke-linecap="round"/>
  </svg>
)}
