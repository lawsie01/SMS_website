---
interface Row {
  code: string;
  configuration: string;
  size?: string;
  notes?: string;
}
interface Group {
  heading: string;
  rows: Row[];
}
interface Props {
  groups: Group[];
  intro?: string;
}
const { groups, intro } = Astro.props;
---

<div>
  {intro && <p class="text-sms-charcoal-500 mb-4">{intro}</p>}
  <div class="config-accordion divide-y divide-sms-charcoal-100 border-t border-b border-sms-charcoal-100">
    {groups.map((group, i) => (
      <details class="group config-item" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold text-sms-charcoal-900 marker:content-none hover:text-sms-green-600">
          <span>{group.heading}</span>
          <span class="shrink-0 text-sms-green-600 transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
        </summary>
        <div class="config-panel overflow-hidden">
          <div class="overflow-x-auto rounded-lg border border-sms-charcoal-100 mb-5">
            <table class="w-full border-collapse text-sm">
              <thead>
                <tr class="bg-sms-charcoal-900 text-white">
                  <th scope="col" class="text-left px-3 py-2.5 font-semibold">Part code</th>
                  <th scope="col" class="text-left px-3 py-2.5 font-semibold">Configuration</th>
                </tr>
              </thead>
              <tbody>
                {group.rows.map((row, j) => (
                  <tr class:list={[j % 2 === 1 && 'bg-sms-charcoal-50', 'hover:bg-sms-green-50 transition-colors']}>
                    <td class="px-3 py-2 font-mono text-xs text-sms-charcoal-900">{row.code}</td>
                    <td class="px-3 py-2 text-sms-charcoal-900">{row.configuration}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </details>
    ))}
  </div>
</div>

<script>
  // Exclusive accordion: opening one group animate-closes any other group
  // already open in the same accordion, so only one is ever expanded at a
  // time. Native <details> has no animatable intermediate state, so WAAPI
  // animates the element's own height and commits `open` when it finishes;
  // state per item lives in a Map (not a closure var) so a click on one
  // item can drive the close animation of another.
  function initConfigAccordions(): void {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll<HTMLElement>('.config-accordion').forEach((container) => {
      if (container.dataset.accordionInit) return;
      container.dataset.accordionInit = 'true';

      const items = Array.from(container.querySelectorAll<HTMLDetailsElement>(':scope > .config-item'));
      const state = new Map<HTMLDetailsElement, { animation: Animation | null; isClosing: boolean }>(
        items.map((d) => [d, { animation: null, isClosing: false }]),
      );

      function run(details: HTMLDetailsElement, summary: HTMLElement, startHeight: number, endHeight: number, opening: boolean): void {
        const s = state.get(details)!;
        s.animation?.cancel();
        if (reduceMotion) {
          details.open = opening;
          details.style.height = '';
          details.style.overflow = '';
          s.isClosing = false;
          return;
        }
        s.animation = details.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration: 220, easing: 'ease-out' },
        );
        s.animation.onfinish = () => {
          details.open = opening;
          details.style.height = '';
          details.style.overflow = '';
          s.isClosing = false;
          s.animation = null;
        };
      }

      function closeItem(details: HTMLDetailsElement): void {
        const s = state.get(details);
        const summary = details.querySelector<HTMLElement>('summary');
        if (!s || !summary || !details.open || s.isClosing) return;
        details.style.overflow = 'hidden';
        const startHeight = details.getBoundingClientRect().height;
        s.isClosing = true;
        run(details, summary, startHeight, summary.getBoundingClientRect().height, false);
      }

      items.forEach((details) => {
        const summary = details.querySelector<HTMLElement>('summary');
        const panel = details.querySelector<HTMLElement>('.config-panel');
        if (!summary || !panel) return;

        summary.addEventListener('click', (e) => {
          e.preventDefault();
          const s = state.get(details)!;

          if (!details.open || s.isClosing) {
            items.forEach((other) => other !== details && closeItem(other));
            details.style.overflow = 'hidden';
            const startHeight = details.getBoundingClientRect().height;
            details.style.height = `${startHeight}px`;
            details.open = true;
            requestAnimationFrame(() => {
              const endHeight = summary.getBoundingClientRect().height + panel.getBoundingClientRect().height;
              run(details, summary, startHeight, endHeight, true);
            });
          } else {
            closeItem(details);
          }
        });
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initConfigAccordions);
  } else {
    initConfigAccordions();
  }
  document.addEventListener('astro:page-load', initConfigAccordions);
</script>
