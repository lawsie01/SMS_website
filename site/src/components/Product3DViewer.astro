---
interface Props {
  product: 'shaft' | 'chamber' | 'hole';
  title: string;
}
const { product, title } = Astro.props;

// Real CAD-derived assets, added as they become available. Products without
// an entry here still get the procedural placeholder geometry below.
const MODEL_URLS: Partial<Record<Props['product'], string>> = {
  shaft: '/models/dn375-maintenance-shaft.glb',
  chamber: '/models/dn600-maintenance-chamber.glb',
  hole: '/models/dn1000-maintenance-hole.glb',
};
const modelUrl = MODEL_URLS[product];
---

{/* Sidebar module, not a full-width band. The model is the product image now,
    so it takes the slot and the proportions the photograph used to have, and
    the mega view is behind the expand button instead of being the default. */}
<div class="viewer-shell">

    {/* Rotating the model was a pointer drag and nothing else: no keyboard
        path in, no buttons, and the canvas wasn't focusable, so a keyboard
        user tabbed straight past a 480px block of the page. WCAG 2.2 (2.5.7)
        also wants a single-pointer alternative to any drag. The buttons below
        drive the same orbit the drag does, and they double as the affordance
        a mouse user previously had to guess at. */}
    <div
      class="product-3d-viewer relative aspect-square rounded-xl border border-sms-charcoal-100 bg-render-bg overflow-hidden"
      data-product={product}
      data-model-url={modelUrl}
      data-model-path={modelUrl}
      tabindex="0"
      role="application"
      aria-label={`Interactive 3D model of the SMS ${title}. Use the arrow keys to rotate, plus and minus to zoom.`}
    >
      <div class="viewer-loading absolute inset-0 flex items-center justify-center text-sms-charcoal-400 text-sm">
        Loading 3D preview&hellip;
      </div>
      <noscript>
        <div class="absolute inset-0 flex items-center justify-center text-sms-charcoal-400 text-sm p-6 text-center">
          Enable JavaScript to view the interactive 3D model.
        </div>
      </noscript>

      {/* Over the render's own ground rather than under the frame. The bar
          paints a translucent white so the icons keep their contrast wherever
          the model happens to sit behind them, and it is pinned to the foot so
          it does not move when the box changes size. */}
      <div class="viewer-controls absolute inset-x-0 bottom-0 flex flex-wrap items-center justify-center gap-1 bg-render-bg/90 backdrop-blur-sm px-2 py-1.5" role="group" aria-label="Model controls">
        <button type="button" data-viewer-act="left" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Rotate left">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        </button>
        <button type="button" data-viewer-act="right" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Rotate right">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        </button>
        <button type="button" data-viewer-act="up" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Tilt up">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4.5 12.5 10 7l5.5 5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        </button>
        <button type="button" data-viewer-act="down" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Tilt down">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4.5 7.5 10 13l5.5-5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        </button>
        <button type="button" data-viewer-act="in" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Zoom in">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 5v10M5 10h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        </button>
        <button type="button" data-viewer-act="out" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Zoom out">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 10h10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        </button>
        <button type="button" data-viewer-act="reset" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Reset view">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10a6 6 0 1 0 1.8-4.3M4 4v3h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        </button>
        {/* The expanded view is opt-in. Fullscreen is on the shell, not the
          canvas box, so the controls come with it and the model can still be
          driven once expanded. */}
        <button type="button" data-viewer-act="expand" aria-pressed="false" class="sms-press viewer-btn inline-flex items-center justify-center rounded-md p-2 text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-900/5 transition-colors" aria-label="Expand the model">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path class="expand-open" d="M8 3H3v5M12 17h5v-5M17 8V3h-5M3 12v5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          <path class="expand-close" d="M3 8h5V3M17 12h-5v5M12 3v5h5M8 17v-5H3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        </button>
      </div>
    </div>

</div>

{/* The expanded view is the same overlay EnquiryModal uses: a fixed sheet, a
    charcoal backdrop, a centred white card with a titled header and a close
    control. It was a <dialog> before, which put the whole layout at the mercy
    of the UA modal stylesheet and of one scoped rule surviving; a card built
    from the same utilities as the enquiry panel does not depend on either, and
    the two overlays on the site now open the same way. */}
<div
  class="viewer-modal fixed inset-0 z-50 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label={`${title} model, expanded`}
  hidden
  data-closed
>
  <div class="viewer-modal-backdrop fixed inset-0 bg-sms-charcoal-900/50"></div>
  {/* The centring wrapper is deliberately unpositioned and the card is the
      one that is relative, matching EnquiryModal. Position the wrapper and it
      paints above the fixed backdrop, swallowing every click meant for it. */}
  <div class="flex min-h-full items-center justify-center p-4 sm:p-6">
    <div class="viewer-modal-card relative w-full max-w-4xl rounded-xl bg-white shadow-2xl overflow-hidden">
      <div class="flex items-center justify-between gap-4 border-b border-sms-charcoal-100 px-5 py-4">
        <h2 class="text-lg font-bold text-sms-charcoal-900">{title}</h2>
        <button
          type="button"
          data-viewer-act="collapse"
          aria-label="Close"
          class="sms-press shrink-0 -m-1 p-1 rounded-md text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-50"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      {/* The square ratio that suits the sidebar is dropped here. The body
          takes a share of the viewport and the model reframes into it. */}
      <div class="viewer-modal-body h-[min(68vh,620px)]"></div>
    </div>
  </div>
</div>

<style>
  /* Same reveal as EnquiryModal, which takes it in turn from Header's
     disclosures. Layout deliberately lives in the utility classes on the
     markup instead: this block is a scoped per-page <style>, and losing it
     should cost the animation, not the position of the panel. */
  .viewer-modal-card {
    transition: opacity 160ms ease-out, transform 160ms ease-out;
  }
  .viewer-modal[data-closed] .viewer-modal-card {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .viewer-modal-card {
      transition: none;
    }
  }
  .expand-close {
    display: none;
  }
</style>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { MeshoptDecoder } from 'three/examples/jsm/libs/meshopt_decoder.module.js';

  type ProductKey = 'shaft' | 'chamber' | 'hole';

  interface ProductConfig {
    bodyRadius: number;
    bodyHeight: number;
    ribbed: boolean;
    riserColor: number;
    capRadius: number;
    capHeight: number;
    stubCount: number;
    stubRadius: number;
    stubLength: number;
    cameraDistance: number;
  }

  const CONFIGS: Record<ProductKey, ProductConfig> = {
    shaft: {
      bodyRadius: 0.34,
      bodyHeight: 1.9,
      ribbed: false,
      riserColor: 0xe4e2dc,
      capRadius: 0.46,
      capHeight: 0.16,
      stubCount: 1,
      stubRadius: 0.11,
      stubLength: 0.5,
      cameraDistance: 3.4,
    },
    chamber: {
      bodyRadius: 0.5,
      bodyHeight: 2.1,
      ribbed: true,
      riserColor: 0x4a4a4a,
      capRadius: 0.62,
      capHeight: 0.18,
      stubCount: 2,
      stubRadius: 0.14,
      stubLength: 0.55,
      cameraDistance: 4.0,
    },
    hole: {
      bodyRadius: 0.66,
      bodyHeight: 2.5,
      ribbed: true,
      riserColor: 0x4a4a4a,
      capRadius: 0.8,
      capHeight: 0.2,
      stubCount: 2,
      stubRadius: 0.17,
      stubLength: 0.65,
      cameraDistance: 4.8,
    },
  };

  function buildGrateTexture(): THREE.CanvasTexture {
    const size = 256;
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext('2d')!;
    ctx.fillStyle = '#2a2a2a';
    ctx.fillRect(0, 0, size, size);
    ctx.strokeStyle = '#0f0f0f';
    ctx.lineWidth = 3;
    const cx = size / 2;
    const cy = size / 2;
    for (let r = 20; r < size / 2; r += 18) {
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.stroke();
    }
    for (let a = 0; a < 12; a++) {
      const angle = (a / 12) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(angle) * size * 0.48, cy + Math.sin(angle) * size * 0.48);
      ctx.stroke();
    }
    return new THREE.CanvasTexture(canvas);
  }

  function buildBody(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    const material = new THREE.MeshStandardMaterial({
      color: config.riserColor,
      roughness: 0.65,
      metalness: 0.05,
    });

    if (config.ribbed) {
      const ribCount = Math.round(config.bodyHeight * 14);
      const ribHeight = config.bodyHeight / ribCount;
      for (let i = 0; i < ribCount; i++) {
        const t = i / ribCount;
        const radius = config.bodyRadius * (i % 2 === 0 ? 1 : 0.86);
        const geo = new THREE.CylinderGeometry(radius, radius, ribHeight * 1.05, 32);
        const mesh = new THREE.Mesh(geo, material);
        mesh.position.y = t * config.bodyHeight - config.bodyHeight / 2 + ribHeight / 2;
        group.add(mesh);
      }
    } else {
      const geo = new THREE.CylinderGeometry(config.bodyRadius, config.bodyRadius * 1.05, config.bodyHeight, 32);
      const mesh = new THREE.Mesh(geo, material);
      group.add(mesh);
    }
    return group;
  }

  function buildCap(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    const capMaterial = new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.5, metalness: 0.1 });
    const grateMaterial = new THREE.MeshStandardMaterial({ map: buildGrateTexture(), roughness: 0.8, metalness: 0.1 });

    const collarGeo = new THREE.CylinderGeometry(config.bodyRadius * 1.1, config.capRadius, config.capHeight * 0.7, 32);
    const collar = new THREE.Mesh(collarGeo, capMaterial);
    collar.position.y = config.bodyHeight / 2 + (config.capHeight * 0.7) / 2;
    group.add(collar);

    const lidGeo = new THREE.CylinderGeometry(config.capRadius, config.capRadius, config.capHeight, 32, 1, false);
    const lidMaterials = [capMaterial, grateMaterial, capMaterial];
    const lid = new THREE.Mesh(lidGeo, lidMaterials);
    lid.position.y = config.bodyHeight / 2 + config.capHeight * 0.7 + config.capHeight / 2;
    group.add(lid);

    return group;
  }

  function buildStubs(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    const material = new THREE.MeshStandardMaterial({ color: 0xd8d5cc, roughness: 0.55, metalness: 0.05 });
    const positions = config.stubCount === 1 ? [0] : [0, Math.PI];
    const stubHeight = -config.bodyHeight / 2 + config.stubRadius * 1.6;

    positions.forEach((angle) => {
      const geo = new THREE.CylinderGeometry(config.stubRadius, config.stubRadius, config.stubLength, 20);
      const mesh = new THREE.Mesh(geo, material);
      mesh.rotation.z = Math.PI / 2;
      const dist = config.bodyRadius + config.stubLength / 2 - 0.05;
      mesh.position.set(Math.cos(angle) * dist, stubHeight, Math.sin(angle) * dist);
      mesh.rotation.y = angle;
      group.add(mesh);
    });
    return group;
  }

  function buildBase(config: ProductConfig): THREE.Mesh {
    const material = new THREE.MeshStandardMaterial({ color: 0x2e2e2e, roughness: 0.7, metalness: 0.05 });
    const geo = new THREE.CylinderGeometry(config.bodyRadius * 1.15, config.bodyRadius * 1.2, 0.12, 32);
    const mesh = new THREE.Mesh(geo, material);
    mesh.position.y = -config.bodyHeight / 2 - 0.06;
    return mesh;
  }

  function buildProceduralGroup(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    group.add(buildBody(config));
    group.add(buildCap(config));
    group.add(buildStubs(config));
    group.add(buildBase(config));
    return group;
  }

  let gltfLoader: GLTFLoader | null = null;
  function getGltfLoader(): GLTFLoader {
    if (!gltfLoader) {
      gltfLoader = new GLTFLoader();
      gltfLoader.setMeshoptDecoder(MeshoptDecoder);
    }
    return gltfLoader;
  }

  function initViewer(container: HTMLElement) {
    const productKey = (container.dataset.product as ProductKey) ?? 'hole';
    const config = CONFIGS[productKey];
    const modelUrl = container.dataset.modelUrl || null;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(config.cameraDistance * 0.7, config.cameraDistance * 0.35, config.cameraDistance * 0.9);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.35;
    container.appendChild(renderer.domElement);

    const loading = container.querySelector<HTMLElement>('.viewer-loading');
    function clearLoading() {
      loading?.remove();
    }

    // Tuned against the darkest real material in the range (near-black
    // matte corrugated risers): ambient light has no notion of occlusion, so
    // it lifts every fragment's floor brightness uniformly — kept low here
    // specifically so a near-black albedo still reads as black instead of
    // being flattened toward mid-grey. Shape and ridge detail instead comes
    // from the directional key/fill falloff, which does vary with surface
    // angle. The rim reads as a crisp brand-green edge highlight, not a
    // color cast. Same values for all three viewers is the point — one
    // lighting rig, so a product's apparent finish comes from its own
    // material, not from re-lighting it.
    scene.add(new THREE.AmbientLight(0xffffff, 0.45));
    const key = new THREE.DirectionalLight(0xffffff, 2.4);
    key.position.set(4, 6, 4);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xffffff, 0.9);
    fill.position.set(-3, 2, 4);
    scene.add(fill);
    // Molded/embossed detail (part numbers, brand marks on the access cover)
    // is shallow relief — it only reads when light rakes across it at a low
    // angle, casting a shadow into the recess. The key light's fairly steep
    // elevation is nearly coincident with a top-down camera, which is
    // exactly the angle that flattens relief text into invisible noise. Two
    // near-horizontal lights from different azimuths catch stroke edges
    // regardless of which way a given letter runs, without changing the
    // overall look of the standard 3/4 view they're too dim to dominate.
    const rake1 = new THREE.DirectionalLight(0xffffff, 1.6);
    rake1.position.set(7, 0.6, -2);
    scene.add(rake1);
    const rake2 = new THREE.DirectionalLight(0xffffff, 1.1);
    rake2.position.set(-2, 0.5, 7);
    scene.add(rake2);
    const rim = new THREE.DirectionalLight(0x63b447, 0.3);
    rim.position.set(-4, 3, -4);
    scene.add(rim);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.target.set(0, 0, 0);
    // Where "Reset view" and the Home key return to. Re-captured in
    // frameObject, because a real asset reframes the shot once it loads.
    const homePosition = camera.position.clone();
    const homeTarget = controls.target.clone();
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.enablePan = false;
    controls.minDistance = config.cameraDistance * 0.4;
    controls.maxDistance = config.cameraDistance * 1.8;
    // Continuous unprompted motion is exactly what prefers-reduced-motion exists
    // to suppress, so only spin for viewers who haven't asked us not to. Drag and
    // zoom stay available either way, so nothing is lost by holding still.
    const wantsLessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    controls.autoRotate = !wantsLessMotion.matches;
    controls.autoRotateSpeed = 1.6;
    controls.addEventListener('start', () => {
      controls.autoRotate = false;
    });
    wantsLessMotion.addEventListener('change', (e) => {
      if (e.matches) controls.autoRotate = false;
    });

    // ---- keyboard + button orbit -------------------------------------------
    // OrbitControls' own key handling only pans, and panning is disabled here,
    // so rotation is driven directly. Both the buttons and the arrow keys call
    // the same three functions, which keeps the two paths identical rather
    // than approximately similar.
    // Raises the model within the box so it reads centred in the area the
    // control bar leaves visible, rather than centred in the box behind it.
    // The bar is 46px of a 374px box, so framing to the box put the model 28px
    // low. Calibrated rather than guessed: 0.15 of a radius moved it 23px, so
    // 28px is 0.183. In radii rather than pixels because the camera distance
    // is set in radii too, which keeps the shift the same across all three
    // models regardless of how big each one is.
    const MODEL_LIFT = 0.183;

    const ORBIT_STEP = Math.PI / 18; // 10 degrees
    const ZOOM_STEP = 1.15;

    function orbit(dTheta: number, dPhi: number): void {
      controls.autoRotate = false;
      const offset = camera.position.clone().sub(controls.target);
      const spherical = new THREE.Spherical().setFromVector3(offset);
      spherical.theta += dTheta;
      // Keep the camera off the poles, where the model flips over.
      spherical.phi = Math.max(0.15, Math.min(Math.PI - 0.15, spherical.phi + dPhi));
      camera.position.copy(controls.target.clone().add(new THREE.Vector3().setFromSpherical(spherical)));
      camera.lookAt(controls.target);
      controls.update();
    }

    function zoom(factor: number): void {
      controls.autoRotate = false;
      const offset = camera.position.clone().sub(controls.target);
      const target = Math.max(controls.minDistance, Math.min(controls.maxDistance, offset.length() * factor));
      camera.position.copy(controls.target.clone().add(offset.setLength(target)));
      controls.update();
    }

    function resetView(): void {
      controls.autoRotate = false;
      camera.position.copy(homePosition);
      controls.target.copy(homeTarget);
      controls.update();
    }

    const ACTIONS: Record<string, () => void> = {
      left: () => orbit(-ORBIT_STEP, 0),
      right: () => orbit(ORBIT_STEP, 0),
      up: () => orbit(0, -ORBIT_STEP),
      down: () => orbit(0, ORBIT_STEP),
      in: () => zoom(1 / ZOOM_STEP),
      out: () => zoom(ZOOM_STEP),
      reset: resetView,
      expand: openExpanded,
      collapse: closeExpanded,
    };

    // The shell carries the canvas and the controls, so moving the whole thing
    // into the panel keeps the model drivable at full size. It is moved, not
    // cloned: a WebGL canvas survives being reparented, and a clone would not
    // carry the context. The ResizeObserver below re-fits the renderer, so
    // nothing here has to touch the camera.
    const shell = container.closest<HTMLElement>('.viewer-shell');
    const expandBtn = shell?.querySelector<HTMLButtonElement>('[data-viewer-act="expand"]');
    const modal = shell?.parentElement?.querySelector<HTMLElement>('.viewer-modal')
      ?? document.querySelector<HTMLElement>('.viewer-modal');
    // The panel is authored beside the viewer so the two stay together in the
    // source, but it has to sit at the end of <body> to paint over the sticky
    // header. Left where it is, it inherits the stacking context of the
    // product column and the backdrop stops at the top of the page content.
    // EnquiryModal is a direct child of the layout and never has this problem.
    if (modal) document.body.appendChild(modal);
    const modalBody = modal?.querySelector<HTMLElement>('.viewer-modal-body') ?? null;
    const modalCard = modal?.querySelector<HTMLElement>('.viewer-modal-card') ?? null;
    const backdrop = modal?.querySelector<HTMLElement>('.viewer-modal-backdrop') ?? null;
    const closeBtn = modal?.querySelector<HTMLButtonElement>('[data-viewer-act="collapse"]') ?? null;
    const homeParent = shell?.parentElement ?? null;
    const homeNext = shell?.nextElementSibling ?? null;
    let lastFocused: HTMLElement | null = null;
    let scrollLock: [string, string] = ['', ''];

    // In the sidebar the viewer is a square card. In the panel it fills a body
    // of a set height instead. Both overrides are inline rather than a class,
    // because inline styles cannot be lost to a stylesheet that did not load.
    function fillPanel(on: boolean): void {
      if (shell) shell.style.height = on ? '100%' : '';
      container.style.aspectRatio = on ? 'auto' : '';
      container.style.height = on ? '100%' : '';
      container.style.borderWidth = on ? '0' : '';
      container.style.borderRadius = on ? '0' : '';
      const open = shell?.querySelector<HTMLElement>('.expand-open');
      const close = shell?.querySelector<HTMLElement>('.expand-close');
      if (open) open.style.display = on ? 'none' : '';
      if (close) close.style.display = on ? 'inline' : '';
      expandBtn?.setAttribute('aria-pressed', String(on));
      expandBtn?.setAttribute('aria-label', on ? 'Close the expanded view' : 'Expand the model');
    }

    function isExpanded(): boolean {
      return !!modal && !modal.hasAttribute('hidden');
    }

    function openExpanded(): void {
      if (!shell || !modal || !modalBody) return;
      if (isExpanded()) { closeExpanded(); return; }
      lastFocused = document.activeElement as HTMLElement | null;
      // Taking the shell out of the sidebar would collapse the column and
      // reflow the page behind the backdrop, so the slot holds its height
      // until the shell comes back to it.
      if (homeParent) homeParent.style.minHeight = `${homeParent.offsetHeight}px`;
      modalBody.appendChild(shell);
      fillPanel(true);
      modal.removeAttribute('hidden');
      requestAnimationFrame(() => modal.removeAttribute('data-closed'));
      // <dialog> held the page still and kept Tab inside the panel. Neither
      // comes free from a plain overlay, so both are restored by hand. Taking
      // the scrollbar away widens the page and jogs the header sideways, so
      // its width goes back on as padding for as long as the panel is open.
      const bar = window.innerWidth - document.documentElement.clientWidth;
      scrollLock = [document.body.style.overflow, document.body.style.paddingRight];
      document.body.style.overflow = 'hidden';
      if (bar > 0) document.body.style.paddingRight = `${bar}px`;
      container.focus();
    }

    function closeExpanded(): void {
      if (!shell || !modal || !isExpanded()) return;
      modal.setAttribute('data-closed', '');
      [document.body.style.overflow, document.body.style.paddingRight] = scrollLock;
      const finish = () => {
        modal.setAttribute('hidden', '');
        fillPanel(false);
        homeParent?.insertBefore(shell, homeNext);
        if (homeParent) homeParent.style.minHeight = '';
        (lastFocused ?? expandBtn)?.focus();
      };
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) finish();
      else modalCard?.addEventListener('transitionend', finish, { once: true });
    }

    // A panel that cannot open is worse than no button at all.
    if (!modal || !modalBody) expandBtn?.remove();

    backdrop?.addEventListener('click', closeExpanded);
    closeBtn?.addEventListener('click', closeExpanded);
    // <dialog> gave Escape for free; this does not, so it is wired here. The
    // listener is on the document because focus sits on the canvas, which
    // claims the arrow keys and nothing else.
    document.addEventListener('keydown', (e) => {
      if (!isExpanded() || !modal) return;
      if (e.key === 'Escape') { closeExpanded(); return; }
      if (e.key !== 'Tab') return;
      const stops = [...modal.querySelectorAll<HTMLElement>(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])',
      )].filter((el) => !el.hasAttribute('disabled'));
      if (!stops.length) return;
      const first = stops[0];
      const last = stops[stops.length - 1];
      const here = document.activeElement;
      if (!e.shiftKey && (here === last || !modal.contains(here))) { e.preventDefault(); first.focus(); }
      else if (e.shiftKey && (here === first || !modal.contains(here))) { e.preventDefault(); last.focus(); }
    });

    shell?.querySelectorAll<HTMLButtonElement>('[data-viewer-act]').forEach((btn) => {
      btn.addEventListener('click', () => ACTIONS[btn.dataset.viewerAct!]?.());
    });

    const KEYS: Record<string, string> = {
      ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down',
      '+': 'in', '=': 'in', '-': 'out', '_': 'out', Home: 'reset',
    };
    container.addEventListener('keydown', (e) => {
      const act = KEYS[e.key];
      if (!act) return;
      // Only claim keys the viewer actually uses, so Tab and Escape still work
      // and the page can still be scrolled from anywhere else.
      e.preventDefault();
      ACTIONS[act]();
    });

    // Frames the camera/controls around whatever's actually in the scene, so a
    // real asset's true dimensions (unknown until it loads) drive the shot
    // instead of the procedural placeholder's hand-tuned cameraDistance.
    function frameObject(object: THREE.Object3D) {
      const box = new THREE.Box3().setFromObject(object);
      const sphere = box.getBoundingSphere(new THREE.Sphere());
      object.position.sub(sphere.center);
      // 2.6 filled the box edge to edge, which was right when the controls sat
      // under the frame. They are inside it now and cover the bottom ~12%, so
      // the shot pulls back enough for the base to clear the bar.
      const distance = sphere.radius * 2.9;
      camera.position.set(distance * 0.7, distance * 0.35, distance * 0.9);
      camera.near = Math.max(distance / 100, 0.01);
      camera.far = distance * 20;
      camera.updateProjectionMatrix();
      controls.target.set(0, 0, 0);
      object.position.y += sphere.radius * MODEL_LIFT;
      controls.minDistance = sphere.radius * 1.1;
      controls.maxDistance = sphere.radius * 6;
      controls.update();
      homePosition.copy(camera.position);
      homeTarget.copy(controls.target);
    }

    // The MS/MC/MH exports author their materials properly: every one carries
    // an explicit metallicFactor (0 for the plastics, 1 for the cover
    // fixings) and its own roughness. What they do not survive is this
    // viewer's rim light. The glossy materials sit at 0.15 to 0.25 roughness,
    // and at that value the green key throws a hard specular line down every
    // corrugation — rendered side by side, both the authored values and a
    // 0.45 floor glint, and only 0.78 does not. Nothing else is touched, so
    // the colours are the ones the CAD file was built with.
    function normalizeMaterials(root: THREE.Object3D) {
      root.traverse((node) => {
        if (!(node instanceof THREE.Mesh)) return;
        const materials = Array.isArray(node.material) ? node.material : [node.material];
        for (const material of materials) {
          if (!(material instanceof THREE.MeshStandardMaterial)) continue;
          material.roughness = Math.max(material.roughness, 0.78);
        }
      });
    }

    function useModel(gltf: { scene: THREE.Object3D }): void {
      normalizeMaterials(gltf.scene);
      frameObject(gltf.scene);
      scene.add(gltf.scene);
      clearLoading();
    }

    function useFallback(reason: string, error: unknown): void {
      console.error(`3D viewer: ${reason}, falling back to placeholder geometry.`, error);
      scene.add(buildProceduralGroup(config));
      clearLoading();
    }

    // The single-file preview bundle can't fetch anything — its CSP has no
    // connect-src, so even a blob: URL is refused, GLTFLoader's request fails
    // and every product page silently drops to the procedural placeholder.
    // When a host has already decoded the GLB it hands the ArrayBuffer over
    // here, keyed by the model's normal path, and we parse what we were given
    // instead of asking the network for it. The deployed site never sets this
    // and takes the load() branch below.
    const preloaded = (window as unknown as { __MODEL_BUFFERS__?: Record<string, ArrayBuffer> })
      .__MODEL_BUFFERS__?.[container.dataset.modelPath || modelUrl || ''];

    if (preloaded) {
      getGltfLoader().parse(
        preloaded,
        '',
        useModel,
        (error) => useFallback('failed to parse the preloaded model', error),
      );
    } else if (modelUrl) {
      getGltfLoader().load(
        modelUrl,
        useModel,
        undefined,
        (error) => useFallback(`failed to load ${modelUrl}`, error),
      );
    } else {
      scene.add(buildProceduralGroup(config));
      clearLoading();
    }

    function resize() {
      const { clientWidth, clientHeight } = container;
      camera.aspect = clientWidth / clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(clientWidth, clientHeight);
    }
    new ResizeObserver(resize).observe(container);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('.product-3d-viewer').forEach((el) => {
      if (el.dataset.initialized) return;
      el.dataset.initialized = 'true';
      initViewer(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  document.addEventListener('astro:page-load', initAll);
</script>
