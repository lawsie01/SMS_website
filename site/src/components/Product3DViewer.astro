---
interface Props {
  product: 'shaft' | 'chamber' | 'hole';
  title: string;
}
const { product, title } = Astro.props;

// Real CAD-derived assets, added as they become available. Products without
// an entry here still get the procedural placeholder geometry below.
const MODEL_URLS: Partial<Record<Props['product'], string>> = {
  shaft: '/models/dn375-maintenance-shaft.glb',
  chamber: '/models/dn600-maintenance-chamber.glb',
  hole: '/models/dn1000-maintenance-hole.glb',
};
const modelUrl = MODEL_URLS[product];
---

{/* Plain white ground. The grey band put a third background between the dark
    hero and the white body inside the first 1200px of the product page, for a
    block that is already framed by the viewer's own border. */}
<section aria-labelledby="viewer-heading" class="bg-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
      <h2 id="viewer-heading" class="text-xl font-bold text-sms-charcoal-900">Explore the {title} in 3D</h2>
      <p class="text-xs text-sms-charcoal-500">Drag or use the buttons to rotate &middot; scroll, pinch or zoom buttons to scale</p>
    </div>

    {/* Rotating the model was a pointer drag and nothing else: no keyboard
        path in, no buttons, and the canvas wasn't focusable, so a keyboard
        user tabbed straight past a 480px block of the page. WCAG 2.2 (2.5.7)
        also wants a single-pointer alternative to any drag. The buttons below
        drive the same orbit the drag does, and they double as the affordance
        a mouse user previously had to guess at. */}
    <div
      class="product-3d-viewer relative rounded-xl border border-sms-charcoal-200 bg-sms-charcoal-50 overflow-hidden"
      data-product={product}
      data-model-url={modelUrl}
      tabindex="0"
      role="application"
      aria-label={`Interactive 3D model of the SMS ${title}. Use the arrow keys to rotate, plus and minus to zoom.`}
      style="height: 480px;"
    >
      <div class="viewer-loading absolute inset-0 flex items-center justify-center text-sms-charcoal-400 text-sm">
        Loading 3D preview&hellip;
      </div>
      <noscript>
        <div class="absolute inset-0 flex items-center justify-center text-sms-charcoal-400 text-sm p-6 text-center">
          Enable JavaScript to view the interactive 3D model.
        </div>
      </noscript>
    </div>

    <div class="viewer-controls mt-3 flex flex-wrap items-center gap-2" role="group" aria-label="Model controls">
      <button type="button" data-viewer-act="left" class="viewer-btn inline-flex items-center justify-center rounded-md border border-sms-charcoal-200 bg-white px-3 py-2 text-sms-charcoal-700 hover:border-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors" aria-label="Rotate left">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 4.5 7 10l5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" data-viewer-act="right" class="viewer-btn inline-flex items-center justify-center rounded-md border border-sms-charcoal-200 bg-white px-3 py-2 text-sms-charcoal-700 hover:border-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors" aria-label="Rotate right">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" data-viewer-act="up" class="viewer-btn inline-flex items-center justify-center rounded-md border border-sms-charcoal-200 bg-white px-3 py-2 text-sms-charcoal-700 hover:border-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors" aria-label="Tilt up">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4.5 12.5 10 7l5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" data-viewer-act="down" class="viewer-btn inline-flex items-center justify-center rounded-md border border-sms-charcoal-200 bg-white px-3 py-2 text-sms-charcoal-700 hover:border-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors" aria-label="Tilt down">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4.5 7.5 10 13l5.5-5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <span class="w-px h-5 bg-sms-charcoal-200 mx-1" aria-hidden="true"></span>
      <button type="button" data-viewer-act="in" class="viewer-btn inline-flex items-center justify-center rounded-md border border-sms-charcoal-200 bg-white px-3 py-2 text-sms-charcoal-700 hover:border-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors" aria-label="Zoom in">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M10 5v10M5 10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
      <button type="button" data-viewer-act="out" class="viewer-btn inline-flex items-center justify-center rounded-md border border-sms-charcoal-200 bg-white px-3 py-2 text-sms-charcoal-700 hover:border-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors" aria-label="Zoom out">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M5 10h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
      <button type="button" data-viewer-act="reset" class="viewer-btn inline-flex items-center rounded-md border border-sms-charcoal-200 bg-white px-3 py-2 text-xs font-semibold text-sms-charcoal-700 hover:border-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors">
        Reset view
      </button>
    </div>

    {modelUrl ? (
      <p class="mt-3 text-xs text-sms-charcoal-500 max-w-[68ch]">
        Interactive model of the SMS {title}, built from the manufacturer's CAD.
      </p>
    ) : (
      <p class="mt-3 text-xs text-sms-charcoal-500 max-w-[68ch]">
        Placeholder geometry for concept purposes. Approximates the real product's proportions and
        construction (corrugated riser, access cover, RRJ inlet/outlet sockets) but is not derived from
        the actual CAD model. Swap in the real .glb/.gltf asset when available.
      </p>
    )}
  </div>
</section>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { MeshoptDecoder } from 'three/examples/jsm/libs/meshopt_decoder.module.js';

  type ProductKey = 'shaft' | 'chamber' | 'hole';

  interface ProductConfig {
    bodyRadius: number;
    bodyHeight: number;
    ribbed: boolean;
    riserColor: number;
    capRadius: number;
    capHeight: number;
    stubCount: number;
    stubRadius: number;
    stubLength: number;
    cameraDistance: number;
  }

  const CONFIGS: Record<ProductKey, ProductConfig> = {
    shaft: {
      bodyRadius: 0.34,
      bodyHeight: 1.9,
      ribbed: false,
      riserColor: 0xe4e2dc,
      capRadius: 0.46,
      capHeight: 0.16,
      stubCount: 1,
      stubRadius: 0.11,
      stubLength: 0.5,
      cameraDistance: 3.4,
    },
    chamber: {
      bodyRadius: 0.5,
      bodyHeight: 2.1,
      ribbed: true,
      riserColor: 0x4a4a4a,
      capRadius: 0.62,
      capHeight: 0.18,
      stubCount: 2,
      stubRadius: 0.14,
      stubLength: 0.55,
      cameraDistance: 4.0,
    },
    hole: {
      bodyRadius: 0.66,
      bodyHeight: 2.5,
      ribbed: true,
      riserColor: 0x4a4a4a,
      capRadius: 0.8,
      capHeight: 0.2,
      stubCount: 2,
      stubRadius: 0.17,
      stubLength: 0.65,
      cameraDistance: 4.8,
    },
  };

  function buildGrateTexture(): THREE.CanvasTexture {
    const size = 256;
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext('2d')!;
    ctx.fillStyle = '#2a2a2a';
    ctx.fillRect(0, 0, size, size);
    ctx.strokeStyle = '#0f0f0f';
    ctx.lineWidth = 3;
    const cx = size / 2;
    const cy = size / 2;
    for (let r = 20; r < size / 2; r += 18) {
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.stroke();
    }
    for (let a = 0; a < 12; a++) {
      const angle = (a / 12) * Math.PI * 2;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(angle) * size * 0.48, cy + Math.sin(angle) * size * 0.48);
      ctx.stroke();
    }
    return new THREE.CanvasTexture(canvas);
  }

  function buildBody(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    const material = new THREE.MeshStandardMaterial({
      color: config.riserColor,
      roughness: 0.65,
      metalness: 0.05,
    });

    if (config.ribbed) {
      const ribCount = Math.round(config.bodyHeight * 14);
      const ribHeight = config.bodyHeight / ribCount;
      for (let i = 0; i < ribCount; i++) {
        const t = i / ribCount;
        const radius = config.bodyRadius * (i % 2 === 0 ? 1 : 0.86);
        const geo = new THREE.CylinderGeometry(radius, radius, ribHeight * 1.05, 32);
        const mesh = new THREE.Mesh(geo, material);
        mesh.position.y = t * config.bodyHeight - config.bodyHeight / 2 + ribHeight / 2;
        group.add(mesh);
      }
    } else {
      const geo = new THREE.CylinderGeometry(config.bodyRadius, config.bodyRadius * 1.05, config.bodyHeight, 32);
      const mesh = new THREE.Mesh(geo, material);
      group.add(mesh);
    }
    return group;
  }

  function buildCap(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    const capMaterial = new THREE.MeshStandardMaterial({ color: 0x3a3a3a, roughness: 0.5, metalness: 0.1 });
    const grateMaterial = new THREE.MeshStandardMaterial({ map: buildGrateTexture(), roughness: 0.8, metalness: 0.1 });

    const collarGeo = new THREE.CylinderGeometry(config.bodyRadius * 1.1, config.capRadius, config.capHeight * 0.7, 32);
    const collar = new THREE.Mesh(collarGeo, capMaterial);
    collar.position.y = config.bodyHeight / 2 + (config.capHeight * 0.7) / 2;
    group.add(collar);

    const lidGeo = new THREE.CylinderGeometry(config.capRadius, config.capRadius, config.capHeight, 32, 1, false);
    const lidMaterials = [capMaterial, grateMaterial, capMaterial];
    const lid = new THREE.Mesh(lidGeo, lidMaterials);
    lid.position.y = config.bodyHeight / 2 + config.capHeight * 0.7 + config.capHeight / 2;
    group.add(lid);

    return group;
  }

  function buildStubs(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    const material = new THREE.MeshStandardMaterial({ color: 0xd8d5cc, roughness: 0.55, metalness: 0.05 });
    const positions = config.stubCount === 1 ? [0] : [0, Math.PI];
    const stubHeight = -config.bodyHeight / 2 + config.stubRadius * 1.6;

    positions.forEach((angle) => {
      const geo = new THREE.CylinderGeometry(config.stubRadius, config.stubRadius, config.stubLength, 20);
      const mesh = new THREE.Mesh(geo, material);
      mesh.rotation.z = Math.PI / 2;
      const dist = config.bodyRadius + config.stubLength / 2 - 0.05;
      mesh.position.set(Math.cos(angle) * dist, stubHeight, Math.sin(angle) * dist);
      mesh.rotation.y = angle;
      group.add(mesh);
    });
    return group;
  }

  function buildBase(config: ProductConfig): THREE.Mesh {
    const material = new THREE.MeshStandardMaterial({ color: 0x2e2e2e, roughness: 0.7, metalness: 0.05 });
    const geo = new THREE.CylinderGeometry(config.bodyRadius * 1.15, config.bodyRadius * 1.2, 0.12, 32);
    const mesh = new THREE.Mesh(geo, material);
    mesh.position.y = -config.bodyHeight / 2 - 0.06;
    return mesh;
  }

  function buildProceduralGroup(config: ProductConfig): THREE.Group {
    const group = new THREE.Group();
    group.add(buildBody(config));
    group.add(buildCap(config));
    group.add(buildStubs(config));
    group.add(buildBase(config));
    return group;
  }

  let gltfLoader: GLTFLoader | null = null;
  function getGltfLoader(): GLTFLoader {
    if (!gltfLoader) {
      gltfLoader = new GLTFLoader();
      gltfLoader.setMeshoptDecoder(MeshoptDecoder);
    }
    return gltfLoader;
  }

  function initViewer(container: HTMLElement) {
    const productKey = (container.dataset.product as ProductKey) ?? 'hole';
    const config = CONFIGS[productKey];
    const modelUrl = container.dataset.modelUrl || null;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, container.clientWidth / container.clientHeight, 0.1, 100);
    camera.position.set(config.cameraDistance * 0.7, config.cameraDistance * 0.35, config.cameraDistance * 0.9);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.35;
    container.appendChild(renderer.domElement);

    const loading = container.querySelector<HTMLElement>('.viewer-loading');
    function clearLoading() {
      loading?.remove();
    }

    // Tuned against the darkest real material in the range (near-black
    // matte corrugated risers): ambient light has no notion of occlusion, so
    // it lifts every fragment's floor brightness uniformly — kept low here
    // specifically so a near-black albedo still reads as black instead of
    // being flattened toward mid-grey. Shape and ridge detail instead comes
    // from the directional key/fill falloff, which does vary with surface
    // angle. The rim reads as a crisp brand-green edge highlight, not a
    // color cast. Same values for all three viewers is the point — one
    // lighting rig, so a product's apparent finish comes from its own
    // material, not from re-lighting it.
    scene.add(new THREE.AmbientLight(0xffffff, 0.45));
    const key = new THREE.DirectionalLight(0xffffff, 2.4);
    key.position.set(4, 6, 4);
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xffffff, 0.9);
    fill.position.set(-3, 2, 4);
    scene.add(fill);
    // Molded/embossed detail (part numbers, brand marks on the access cover)
    // is shallow relief — it only reads when light rakes across it at a low
    // angle, casting a shadow into the recess. The key light's fairly steep
    // elevation is nearly coincident with a top-down camera, which is
    // exactly the angle that flattens relief text into invisible noise. Two
    // near-horizontal lights from different azimuths catch stroke edges
    // regardless of which way a given letter runs, without changing the
    // overall look of the standard 3/4 view they're too dim to dominate.
    const rake1 = new THREE.DirectionalLight(0xffffff, 1.6);
    rake1.position.set(7, 0.6, -2);
    scene.add(rake1);
    const rake2 = new THREE.DirectionalLight(0xffffff, 1.1);
    rake2.position.set(-2, 0.5, 7);
    scene.add(rake2);
    const rim = new THREE.DirectionalLight(0x63b447, 0.3);
    rim.position.set(-4, 3, -4);
    scene.add(rim);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.target.set(0, 0, 0);
    // Where "Reset view" and the Home key return to. Re-captured in
    // frameObject, because a real asset reframes the shot once it loads.
    const homePosition = camera.position.clone();
    const homeTarget = controls.target.clone();
    controls.enableDamping = true;
    controls.dampingFactor = 0.08;
    controls.enablePan = false;
    controls.minDistance = config.cameraDistance * 0.4;
    controls.maxDistance = config.cameraDistance * 1.8;
    // Continuous unprompted motion is exactly what prefers-reduced-motion exists
    // to suppress, so only spin for viewers who haven't asked us not to. Drag and
    // zoom stay available either way, so nothing is lost by holding still.
    const wantsLessMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    controls.autoRotate = !wantsLessMotion.matches;
    controls.autoRotateSpeed = 1.6;
    controls.addEventListener('start', () => {
      controls.autoRotate = false;
    });
    wantsLessMotion.addEventListener('change', (e) => {
      if (e.matches) controls.autoRotate = false;
    });

    // ---- keyboard + button orbit -------------------------------------------
    // OrbitControls' own key handling only pans, and panning is disabled here,
    // so rotation is driven directly. Both the buttons and the arrow keys call
    // the same three functions, which keeps the two paths identical rather
    // than approximately similar.
    const ORBIT_STEP = Math.PI / 18; // 10 degrees
    const ZOOM_STEP = 1.15;

    function orbit(dTheta: number, dPhi: number): void {
      controls.autoRotate = false;
      const offset = camera.position.clone().sub(controls.target);
      const spherical = new THREE.Spherical().setFromVector3(offset);
      spherical.theta += dTheta;
      // Keep the camera off the poles, where the model flips over.
      spherical.phi = Math.max(0.15, Math.min(Math.PI - 0.15, spherical.phi + dPhi));
      camera.position.copy(controls.target.clone().add(new THREE.Vector3().setFromSpherical(spherical)));
      camera.lookAt(controls.target);
      controls.update();
    }

    function zoom(factor: number): void {
      controls.autoRotate = false;
      const offset = camera.position.clone().sub(controls.target);
      const target = Math.max(controls.minDistance, Math.min(controls.maxDistance, offset.length() * factor));
      camera.position.copy(controls.target.clone().add(offset.setLength(target)));
      controls.update();
    }

    function resetView(): void {
      controls.autoRotate = false;
      camera.position.copy(homePosition);
      controls.target.copy(homeTarget);
      controls.update();
    }

    const ACTIONS: Record<string, () => void> = {
      left: () => orbit(-ORBIT_STEP, 0),
      right: () => orbit(ORBIT_STEP, 0),
      up: () => orbit(0, -ORBIT_STEP),
      down: () => orbit(0, ORBIT_STEP),
      in: () => zoom(1 / ZOOM_STEP),
      out: () => zoom(ZOOM_STEP),
      reset: resetView,
    };

    container.parentElement?.querySelectorAll<HTMLButtonElement>('[data-viewer-act]').forEach((btn) => {
      btn.addEventListener('click', () => ACTIONS[btn.dataset.viewerAct!]?.());
    });

    const KEYS: Record<string, string> = {
      ArrowLeft: 'left', ArrowRight: 'right', ArrowUp: 'up', ArrowDown: 'down',
      '+': 'in', '=': 'in', '-': 'out', '_': 'out', Home: 'reset',
    };
    container.addEventListener('keydown', (e) => {
      const act = KEYS[e.key];
      if (!act) return;
      // Only claim keys the viewer actually uses, so Tab and Escape still work
      // and the page can still be scrolled from anywhere else.
      e.preventDefault();
      ACTIONS[act]();
    });

    // Frames the camera/controls around whatever's actually in the scene, so a
    // real asset's true dimensions (unknown until it loads) drive the shot
    // instead of the procedural placeholder's hand-tuned cameraDistance.
    function frameObject(object: THREE.Object3D) {
      const box = new THREE.Box3().setFromObject(object);
      const sphere = box.getBoundingSphere(new THREE.Sphere());
      object.position.sub(sphere.center);
      const distance = sphere.radius * 2.6;
      camera.position.set(distance * 0.7, distance * 0.35, distance * 0.9);
      camera.near = Math.max(distance / 100, 0.01);
      camera.far = distance * 20;
      camera.updateProjectionMatrix();
      controls.target.set(0, 0, 0);
      controls.minDistance = sphere.radius * 1.1;
      controls.maxDistance = sphere.radius * 6;
      controls.update();
      homePosition.copy(camera.position);
      homeTarget.copy(controls.target);
    }

    // The three exports come out of gltfpack with low authored roughness
    // (0.21) and, on most materials, no metallicFactor at all — which per the
    // glTF spec means fully metallic. The low roughness is what produced the
    // hard green glint off the rim light.
    //
    // Clamping metalness down as well as roughness up was the obvious
    // reading, and it was wrong: on a metal the base color is reflectance,
    // not diffuse albedo, so reinterpreting it as a dielectric washes every
    // part out. Measured against Clover's own product photography, the body
    // came out 33 to 46 luminance points too light on all three models.
    // Raising roughness alone and leaving the authored metalness where it is
    // lands within 5 points of the photographs, so that is what this does.
    // The pipe stub material (mat_4/mat_4.001 in all three files) still needs
    // its own color, because the chamber's copy omits base color entirely and
    // would otherwise default to white.
    function normalizeMaterials(root: THREE.Object3D) {
      root.traverse((node) => {
        if (!(node instanceof THREE.Mesh)) return;
        const materials = Array.isArray(node.material) ? node.material : [node.material];
        for (const material of materials) {
          if (!(material instanceof THREE.MeshStandardMaterial)) continue;
          material.roughness = Math.max(material.roughness, 0.78);
          if (material.name.startsWith('mat_4')) {
            material.color.set(0xc7c5bf);
            material.metalness = 0.05;
            material.roughness = 0.55;
          }
        }
      });
    }

    if (modelUrl) {
      getGltfLoader().load(
        modelUrl,
        (gltf) => {
          normalizeMaterials(gltf.scene);
          frameObject(gltf.scene);
          scene.add(gltf.scene);
          clearLoading();
        },
        undefined,
        (error) => {
          console.error(`3D viewer: failed to load ${modelUrl}, falling back to placeholder geometry.`, error);
          scene.add(buildProceduralGroup(config));
          clearLoading();
        },
      );
    } else {
      scene.add(buildProceduralGroup(config));
      clearLoading();
    }

    function resize() {
      const { clientWidth, clientHeight } = container;
      camera.aspect = clientWidth / clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(clientWidth, clientHeight);
    }
    new ResizeObserver(resize).observe(container);

    function animate() {
      requestAnimationFrame(animate);
      controls.update();
      renderer.render(scene, camera);
    }
    animate();
  }

  function initAll() {
    document.querySelectorAll<HTMLElement>('.product-3d-viewer').forEach((el) => {
      if (el.dataset.initialized) return;
      el.dataset.initialized = 'true';
      initViewer(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
  document.addEventListener('astro:page-load', initAll);
</script>
