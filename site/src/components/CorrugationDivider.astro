---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class:list={["w-full h-4 text-sms-charcoal-100", className]}
  viewBox="0 0 480 28"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <defs>
    <pattern id="sms-corrugation" width="32" height="28" patternUnits="userSpaceOnUse">
      <path d="M0 14 Q8 2 16 14 T32 14" fill="none" stroke="currentColor" stroke-width="2"/>
    </pattern>
  </defs>
  <rect width="480" height="28" fill="url(#sms-corrugation)"/>
</svg>
