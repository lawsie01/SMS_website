---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import company from '../data/company.json';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  compact?: boolean;
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt = '',
  primaryCta = { label: 'Enquire now', href: '/contact/' },
  secondaryCta = { label: `Call ${company.phone}`, href: `tel:${company.phoneHref}` },
  compact = false,
} = Astro.props;
---

<section class="relative overflow-hidden bg-sms-charcoal-900 text-white">
  {image ? (
    <div class="absolute inset-0">
      <Image
        src={image}
        alt=""
        role="presentation"
        class="h-full w-full object-cover opacity-40"
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-sms-charcoal-900 via-sms-charcoal-900/70 to-sms-charcoal-900/40"></div>
    </div>
  ) : (
    <svg class="absolute inset-0 h-full w-full text-white/[0.06]" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <pattern id="sms-hero-corrugation" width="48" height="200" patternUnits="userSpaceOnUse">
          <path d="M0 0 Q12 100 0 200 M24 0 Q36 100 24 200" fill="none" stroke="currentColor" stroke-width="2"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#sms-hero-corrugation)"/>
    </svg>
  )}
  <div class:list={["relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8", compact ? "py-16 sm:py-20" : "py-24 sm:py-32"]}>
    <div class="max-w-3xl">
      {eyebrow && <p class="text-sms-green-400 font-semibold tracking-wide uppercase text-sm mb-3">{eyebrow}</p>}
      <h1 class:list={["font-bold tracking-tight", compact ? "text-3xl sm:text-4xl" : "text-4xl sm:text-6xl"]}>{title}</h1>
      {subtitle && <p class="mt-6 text-lg text-sms-charcoal-100 leading-relaxed">{subtitle}</p>}
      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href={primaryCta.href}
          class="inline-flex items-center rounded-md bg-sms-green-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-sms-green-700 transition-colors"
        >
          {primaryCta.label}
        </a>
        <a
          href={secondaryCta.href}
          class="inline-flex items-center rounded-md border border-white/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10 transition-colors"
        >
          {secondaryCta.label}
        </a>
      </div>
      {imageAlt && <span class="sr-only">{imageAlt}</span>}
    </div>
  </div>
</section>
