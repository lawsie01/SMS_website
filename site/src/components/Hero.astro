---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';

interface Crumb {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  compact?: boolean;
  // The breadcrumb trail, rendered inside the hero rather than in its own
  // strip above it. Home is added by Breadcrumbs, so this is everything after
  // it. Omitted on the homepage, which has no trail.
  crumbs?: Crumb[];
}

const {
  eyebrow,
  title,
  subtitle,
  image,
  imageAlt = '',
  primaryCta = { label: 'Enquire', href: '/contact/' },
  secondaryCta,
  compact = false,
  crumbs,
} = Astro.props;

// Every current primaryCta ends up at /contact/ (optionally with
// ?product=<id> on product pages) — guarded on the href itself, rather than
// assuming that's still true, in case Hero is ever given a primaryCta that
// points somewhere else entirely.
const isEnquiryCta = primaryCta.href === '/contact/' || primaryCta.href.startsWith('/contact/?');
const enquiryProduct = isEnquiryCta ? new URL(primaryCta.href, 'https://sewerms.com.au').searchParams.get('product') : null;

// The default CTA points at /contact/, which on /contact/ itself is a button
// to the page you are already reading. Now that it's a solid green block
// rather than a quiet outline, that reads as a real offer and isn't one.
const showPrimaryCta = new URL(primaryCta.href, 'https://sewerms.com.au').pathname !== Astro.url.pathname;
---

{/* The contour rings are a dark-background device. On a hero carrying a
    background photo they have nothing to read against and just add noise over
    the image, so they only apply when there is no photo. A photo hero still
    needs the dark ground the rings used to bring with them: white text and a
    green CTA sit on it, and if the photo fails to load they would otherwise
    land on the page's white. */}
<section class:list={["relative overflow-hidden text-white", image ? "bg-sms-charcoal-900" : "sms-contour"]}>
  {image && (
    <div class="absolute inset-0">
      {/* astro:assets defaults to lazy, which is right everywhere except here:
          this is the largest contentful paint on every page carrying a hero
          photo, so deferring the fetch defers the paint. Measured on a
          1.6Mbps profile, eager plus high priority took the homepage from
          2124ms to 1432ms. */}
      <Image
        src={image}
        alt=""
        role="presentation"
        class="h-full w-full object-cover opacity-60"
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-sms-charcoal-900/60 via-sms-charcoal-900/45 to-sms-charcoal-900/25"></div>
    </div>
  )}
  {/* The trail used to sit in its own light strip between the header and this
      section, which put a white line across the top of every page below the
      home page. Inside the hero it reads as part of the same block. It brings
      about 53px with it, so where it is present the top padding comes down to
      keep the hero roughly the height it already was. */}
  <div class:list={["relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8",
                    compact
                      ? (crumbs ? "pt-12 pb-16 sm:pt-14 sm:pb-20" : "py-16 sm:py-20")
                      : (crumbs ? "pt-16 pb-24 sm:pt-24 sm:pb-32" : "py-24 sm:py-32")]}>
    <div class="max-w-3xl">
      {crumbs && <Breadcrumbs items={crumbs} inHero />}
      {/* Green on the contour heroes, white wherever a photograph is behind it.
          The palette note is explicit that #38E33A is a 1.7:1 accent and never
          text that has to be read on a light ground, and a photograph is an
          unknown ground: on the DN1000 channel shot the eyebrow landed on white
          benching and measured 3.08:1 against the 4.5:1 it needs. The heading
          and body are already white for the same reason. */}
      {eyebrow && (
        <p class:list={["font-semibold tracking-wide uppercase text-sm mb-3", image ? "text-white" : "text-sms-green-400"]}>{eyebrow}</p>
      )}
      <h1 class:list={["font-bold tracking-tight", compact ? "text-3xl sm:text-4xl" : "text-4xl sm:text-6xl"]}>
        <slot name="title">{title}</slot>
      </h1>
      {subtitle && <p class="mt-6 text-lg text-sms-charcoal-100 leading-relaxed max-w-[65ch]">{subtitle}</p>}
      <div class:list={[(showPrimaryCta || secondaryCta) && "mt-8 flex flex-wrap gap-4"]}>
        {/* The photo variant used to be a transparent button with a green
            outline, which made the page's main action lighter than the dark
            solid Enquire in the header, and left its legibility to whatever
            the photograph happened to be doing behind it. Solid green on a
            charcoal label is the same button on both grounds, and it paints
            its own background so the photo underneath stops mattering. */}
        {showPrimaryCta && (
          <a
            href={primaryCta.href}
            data-enquiry-cta={isEnquiryCta ? true : undefined}
            data-enquiry-product={enquiryProduct ?? undefined}
            class="sms-press inline-flex items-center rounded-md bg-sms-green-600 px-6 py-3 text-base font-semibold text-sms-charcoal-900 shadow-sm hover:bg-sms-green-700 transition-colors"
          >
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            class="sms-press inline-flex items-center rounded-md border border-white/40 px-6 py-3 text-base font-semibold text-white hover:bg-white/10 transition-colors"
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
      {imageAlt && <span class="sr-only">{imageAlt}</span>}
    </div>
  </div>
</section>
