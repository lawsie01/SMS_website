---
interface Row {
  label: string;
  value: string;
}
interface Section {
  heading: string;
  rows: Row[];
}
interface Props {
  sections: Section[];
}
const { sections } = Astro.props;
---

<div class="space-y-8">
  {sections.map((section) => (
    <div>
      <h3 class="text-lg font-bold text-sms-charcoal-900 mb-3">{section.heading}</h3>
      <div class="overflow-x-auto rounded-lg border border-sms-charcoal-100">
        <table class="w-full border-collapse text-sm">
          <tbody>
            {section.rows.map((row, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-sms-charcoal-50', 'hover:bg-sms-green-50 transition-colors']}>
                <th scope="row" class="w-1/3 text-left px-3 py-2.5 text-sms-charcoal-500 font-medium align-top">{row.label}</th>
                <td class="px-3 py-2.5 text-sms-charcoal-900 border-l border-sms-charcoal-100">{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}
</div>
