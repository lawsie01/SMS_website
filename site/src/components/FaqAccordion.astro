---
interface Item {
  question: string;
  answer: string;
}
interface Props {
  items: Item[];
  heading?: string;
}
const { items, heading = 'Frequently asked questions' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">{heading}</h2>
  <div class="divide-y divide-sms-charcoal-100 border-t border-b border-sms-charcoal-100">
    {items.map((item) => (
      <details class="group faq-item py-1">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-sms-charcoal-900 marker:content-none hover:text-sms-green-600">
          <span>{item.question}</span>
          <span class="shrink-0 text-sms-green-600 transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
        </summary>
        <div class="faq-panel overflow-hidden">
          <p class="pb-4 pr-8 text-sms-charcoal-500 leading-relaxed max-w-[68ch]">{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>

<script>
  // Native <details> toggles content visibility with no animatable
  // intermediate state (Chromium doesn't render the closed content at all,
  // so a CSS transition has nothing continuous to interpolate from). WAAPI
  // animating the <details> element's own height, then committing the
  // `open` attribute when the animation finishes, is the reliable
  // cross-browser way to get a smooth reveal here.
  function initFaqAnimations(): void {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((details) => {
      if (details.dataset.animInit) return;
      details.dataset.animInit = 'true';

      const summary = details.querySelector('summary');
      const panel = details.querySelector<HTMLElement>('.faq-panel');
      if (!summary || !panel) return;

      let animation: Animation | null = null;
      let isClosing = false;

      function run(startHeight: number, endHeight: number, opening: boolean): void {
        animation?.cancel();
        animation = details.animate(
          { height: [`${startHeight}px`, `${endHeight}px`] },
          { duration: 220, easing: 'ease-out' },
        );
        animation.onfinish = () => {
          details.open = opening;
          details.style.height = '';
          details.style.overflow = '';
          isClosing = false;
          animation = null;
        };
      }

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        details.style.overflow = 'hidden';
        const startHeight = details.getBoundingClientRect().height;

        if (!details.open || isClosing) {
          details.style.height = `${startHeight}px`;
          details.open = true;
          requestAnimationFrame(() => {
            const endHeight = summary.getBoundingClientRect().height + panel.getBoundingClientRect().height;
            run(startHeight, endHeight, true);
          });
        } else {
          isClosing = true;
          run(startHeight, summary.getBoundingClientRect().height, false);
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqAnimations);
  } else {
    initFaqAnimations();
  }
  document.addEventListener('astro:page-load', initFaqAnimations);
</script>
