---
interface Item {
  question: string;
  answer: string;
}
interface Props {
  items: Item[];
  heading?: string;
}
const { items, heading = 'Frequently asked questions' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl font-bold text-sms-charcoal-900 mb-6">{heading}</h2>
  <div class="divide-y divide-sms-charcoal-100 border-t border-b border-sms-charcoal-100">
    {items.map((item) => (
      <details class="group py-1">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-3 font-semibold text-sms-charcoal-900 marker:content-none hover:text-sms-green-600">
          <span>{item.question}</span>
          <span class="shrink-0 text-sms-green-600 transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
        </summary>
        <p class="pb-4 pr-8 text-sms-charcoal-500 leading-relaxed max-w-[68ch]">{item.answer}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
</section>
