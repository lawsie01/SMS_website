---
import Icon, { type IconName } from './Icon.astro';

const items: { label: string; sub: string; icon: IconName }[] = [
  { label: 'WSAA PA 1317', sub: 'Product Appraisal', icon: 'wsaa' },
  { label: 'WSA 137:2019', sub: 'Industry standard compliant', icon: 'shield' },
  { label: 'AS 3996 Class D', sub: 'Trafficable access covers', icon: 'load' },
  { label: '100-year design life', sub: 'PP structure service life', icon: 'service-life' },
];
---

{/* Static credential strip, not a clickable card grid — icons plus a single
    hairline rail (only at the 4-col breakpoint, where all 4 items sit in one
    row with no wrap) borrow the same registration-mark visual language as
    AtAGlance without giving these facts a card affordance they shouldn't have.

    Floats over the bottom of the hero rather than running edge to edge under
    it. The negative top margin is what creates the overlap, and z-10 keeps it
    above the hero's own stacking context. It stays a plain section, not a
    link, so the shadow reads as elevation rather than an invitation to
    click. */}
<section class="relative z-10 -mt-10 sm:-mt-14 mb-4" aria-label="Approvals and credentials">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-y-6 sm:divide-x divide-sms-charcoal-200 rounded-xl border border-sms-charcoal-100 bg-white px-4 py-8 shadow-lg sm:px-6">
      {items.map((item) => (
        <li class="flex flex-col items-center text-center px-2 lg:px-5">
          <Icon name={item.icon} class="w-6 h-6 text-sms-charcoal-900 mb-2" />
          <p class="font-bold text-sms-charcoal-900 text-sm sm:text-base leading-tight">{item.label}</p>
          <p class="text-xs text-sms-charcoal-400 mt-1">{item.sub}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
