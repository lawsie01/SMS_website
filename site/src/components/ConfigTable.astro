---
interface Row {
  code: string;
  configuration: string;
  size?: string;
  notes?: string;
}
interface Props {
  rows: Row[];
  intro?: string;
}
const { rows, intro } = Astro.props;
const hasSize = rows.some((r) => r.size);
const hasNotes = rows.some((r) => r.notes);
---

<div>
  {intro && <p class="text-sms-charcoal-500 mb-4">{intro}</p>}
  <div class="overflow-x-auto rounded-lg border border-sms-charcoal-100">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="bg-sms-charcoal-900 text-white">
          <th scope="col" class="text-left px-3 py-2.5 font-semibold">Part code</th>
          <th scope="col" class="text-left px-3 py-2.5 font-semibold">Configuration</th>
          {hasSize && <th scope="col" class="text-left px-3 py-2.5 font-semibold">Inlet/outlet size</th>}
          {hasNotes && <th scope="col" class="text-left px-3 py-2.5 font-semibold">Notes</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, i) => (
          <tr class:list={[i % 2 === 1 && 'bg-sms-charcoal-50', 'hover:bg-sms-green-50 transition-colors']}>
            <td class="px-3 py-2 font-mono text-xs text-sms-charcoal-900">{row.code}</td>
            <td class="px-3 py-2 text-sms-charcoal-900">{row.configuration}</td>
            {hasSize && <td class="px-3 py-2 text-sms-charcoal-900">{row.size ?? '—'}</td>}
            {hasNotes && <td class="px-3 py-2 text-sms-charcoal-500">{row.notes ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
