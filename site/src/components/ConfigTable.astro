---
interface Row {
  /** Matching indicator number on the assembly render above, when the part appears in it. */
  ref?: number;
  /** Absent on parts SMS does not code separately, such as riser pipe and seals. */
  code?: string;
  configuration: string;
  size?: string;
  notes?: string;
}
interface Props {
  rows: Row[];
  intro?: string;
}
const { rows, intro } = Astro.props;
const hasSize = rows.some((r) => r.size);
const hasRef = rows.some((r) => r.ref !== undefined);
const hasNotes = rows.some((r) => r.notes);
---

<div>
  {intro && <p class="text-sms-charcoal-500 mb-4 max-w-[68ch]">{intro}</p>}
  <div class="overflow-x-auto rounded-xl border border-sms-charcoal-100">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="bg-sms-charcoal-900 text-white">
          {hasRef && <th scope="col" class="text-left px-3 py-2.5 font-semibold w-10"><span class="sr-only">Assembly indicator</span>#</th>}
          <th scope="col" class="text-left px-3 py-2.5 font-semibold">Part code</th>
          <th scope="col" class="text-left px-3 py-2.5 font-semibold">Configuration</th>
          {hasSize && <th scope="col" class="text-left px-3 py-2.5 font-semibold">Inlet/outlet size</th>}
          {hasNotes && <th scope="col" class="text-left px-3 py-2.5 font-semibold">Notes</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((row, i) => (
          <tr class:list={[i % 2 === 1 && 'bg-sms-charcoal-50', 'hover:bg-sms-green-50 transition-colors']}>
            {hasRef && (
              <td class="px-3 py-2">
                {row.ref !== undefined && (
                  <span class="inline-flex items-center justify-center rounded-full bg-sms-charcoal-900 text-white font-semibold w-5 h-5 text-[0.6875rem]">{row.ref}</span>
                )}
              </td>
            )}
            <td class="px-3 py-2 font-mono text-xs text-sms-charcoal-900">
              {row.code ?? <span class="font-sans text-sms-charcoal-400">No code</span>}
            </td>
            <td class="px-3 py-2 text-sms-charcoal-900">{row.configuration}</td>
            {hasSize && <td class="px-3 py-2 text-sms-charcoal-900">{row.size ?? 'N/A'}</td>}
            {hasNotes && <td class="px-3 py-2 text-sms-charcoal-500">{row.notes ?? 'N/A'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
