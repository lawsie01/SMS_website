---
interface Crumb {
  label: string;
  href: string;
}
interface Props {
  items: Crumb[]; // does not include Home, added automatically
  // Rendered inside a Hero rather than as its own strip above it. The hero is
  // always a dark ground, so the trail drops its background and border and
  // takes the hero's padding instead of carrying its own. Pages with no hero
  // (the two thank-you pages) still get the standalone light strip.
  //
  // In a hero every item is white, links included. The muted grey that marks
  // a link in the light strip reads against a known ground; here the ground
  // is a photograph, and on the About and DN1000 shots grey measured 2.6 to
  // 3.9:1 where it needs 4.5. White clears it on every page we have, so the
  // trail separates the current page by weight instead of colour.
  inHero?: boolean;
}
const { items, inHero = false } = Astro.props;
const siteUrl = 'https://sewerms.com.au';
const allItems = [{ label: 'Home', href: '/' }, ...items];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: allItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: new URL(item.href, siteUrl).toString(),
  })),
};
---

<nav
  aria-label="Breadcrumb"
  class:list={[inHero ? "mb-5" : "bg-sms-charcoal-50 border-b border-sms-charcoal-100"]}
>
  <ol
    class:list={[
      "flex flex-wrap items-center gap-1.5 text-sm",
      inHero ? "text-white" : "mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-2 text-sms-charcoal-400",
    ]}
  >
    {allItems.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {i === allItems.length - 1 ? (
          <span class:list={["font-medium", inHero ? "text-white" : "text-sms-charcoal-700"]} aria-current="page">{item.label}</span>
        ) : (
          <a href={item.href} class:list={["inline-block py-1", inHero ? "hover:underline" : "hover:text-sms-charcoal-900"]}>{item.label}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
