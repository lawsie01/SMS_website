---
// Global quick-enquiry modal, included once from BaseLayout so it's
// reachable from any page. Opens from every element carrying
// data-enquiry-cta (Header's "Enquire Now", Hero's primary CTA, CtaBand,
// Footer's "Request a quote") instead of navigating to /contact/ — see each
// of those files for why that one link and not others. The underlying
// anchors keep their real /contact/ href, so a visitor without JS (or one
// who wants the full page with branch addresses) still gets there normally;
// this is a progressive enhancement layer, not a replacement for that page.
//
// Submits to the same Netlify Forms endpoint as the page's own form
// (name="enquiry") via fetch with a raw FormData body — required for file
// attachments to reach Netlify at all; the URL-encoded AJAX pattern most
// Netlify Forms examples show can't carry File objects.
import { getCollection } from 'astro:content';

const products = await getCollection('products');
// Fittings & accessories aren't ready for launch — excluded from this
// enquiry picker so a visitor can't ask about a product with no live page.
const sortedProducts = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);
---

<div id="enquiry-modal" role="dialog" aria-modal="true" aria-labelledby="enquiry-title" hidden data-closed class="fixed inset-0 z-50 overflow-y-auto">
  <div id="enquiry-backdrop" class="fixed inset-0 bg-sms-charcoal-900/50"></div>
  <div class="flex min-h-full items-start justify-center p-4 sm:p-6">
    <div id="enquiry-card" class="enquiry-card relative w-full max-w-2xl mt-8 rounded-xl bg-white shadow-2xl overflow-hidden">
      <div id="enquiry-form-view">
        <div class="flex items-start justify-between gap-4 border-b border-sms-charcoal-100 px-6 py-5">
          <div>
            <h2 id="enquiry-title" class="text-xl font-bold text-sms-charcoal-900">Send an enquiry</h2>
            <p class="mt-1 text-sm text-sms-charcoal-400">We'll confirm product configuration, lead time and depth for your site.</p>
          </div>
          <button type="button" id="enquiry-close" aria-label="Close" class="shrink-0 -m-1 p-1 rounded-md text-sms-charcoal-400 hover:text-sms-charcoal-900 hover:bg-sms-charcoal-50">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <form
          id="enquiry-form"
          name="enquiry"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          enctype="multipart/form-data"
          class="px-6 py-5 space-y-5"
        >
          <input type="hidden" name="form-name" value="enquiry" />
          <p class="hidden">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="eq-name" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Name *</label>
              <input type="text" id="eq-name" name="name" required autocomplete="name" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
            <div>
              <label for="eq-company" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Company</label>
              <input type="text" id="eq-company" name="company" autocomplete="organization" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="eq-email" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Email *</label>
              <input type="email" id="eq-email" name="email" required autocomplete="email" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
            <div>
              <label for="eq-phone" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Phone</label>
              <input type="tel" id="eq-phone" name="phone" autocomplete="tel" class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none" />
            </div>
          </div>

          <div class="relative">
            <label id="enquiry-product-label" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Product(s) of interest</label>
            <button
              type="button"
              id="enquiry-product-toggle"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="enquiry-product-panel"
              aria-labelledby="enquiry-product-label enquiry-product-summary"
              class="w-full flex items-center justify-between gap-2 rounded-md border border-sms-charcoal-200 px-3 py-2 text-sm text-left text-sms-charcoal-700 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none"
            >
              <span id="enquiry-product-summary">Select product(s) — optional</span>
              <svg id="enquiry-product-chevron" class="w-4 h-4 shrink-0 text-sms-charcoal-400 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div
              id="enquiry-product-panel"
              role="group"
              aria-labelledby="enquiry-product-label"
              hidden
              class="absolute z-10 mt-1 w-full max-h-56 overflow-y-auto rounded-md border border-sms-charcoal-200 bg-white shadow-lg p-2 space-y-0.5"
            >
              {sortedProducts.map((p) => (
                <label class="flex items-center gap-2 rounded px-2 py-1.5 text-sm text-sms-charcoal-700 hover:bg-sms-charcoal-50 cursor-pointer">
                  <input type="checkbox" name="product" value={p.id} data-product-title={p.data.title} class="rounded border-sms-charcoal-300 text-sms-green-600 focus:ring-sms-green-600" />
                  {p.data.title}
                </label>
              ))}
            </div>
          </div>

          <div>
            <label for="eq-message" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Project details *</label>
            <textarea id="eq-message" name="message" required rows="4" placeholder="Install depth, inlet sizes, load rating, timeframe, location..." class="w-full rounded-md border border-sms-charcoal-200 px-3 py-2 focus:border-sms-green-600 focus:ring-1 focus:ring-sms-green-600 outline-none"></textarea>
          </div>

          <div>
            <label id="enquiry-file-label" class="block text-sm font-medium text-sms-charcoal-700 mb-1">Attach files</label>
            <div
              id="enquiry-dropzone"
              class="enquiry-dropzone flex flex-col items-center justify-center gap-1.5 text-center rounded-lg border-2 border-dashed border-sms-charcoal-200 bg-sms-charcoal-50/60 px-4 py-5 cursor-pointer hover:border-sms-green-300 hover:bg-sms-green-50/40"
              role="button"
              tabindex="0"
              aria-labelledby="enquiry-file-label"
            >
              <svg width="22" height="22" viewBox="0 0 20 20" fill="none" class="text-sms-charcoal-400" aria-hidden="true">
                <path d="M10 13V4M10 4L6.5 7.5M10 4l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M3.5 13v1.5A2.5 2.5 0 006 17h8a2.5 2.5 0 002.5-2.5V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="text-sm font-semibold text-sms-charcoal-700">Drop site plans or photos here</span>
              <span class="text-xs text-sms-charcoal-400">or <button type="button" id="enquiry-file-browse" class="text-sms-green-600 font-semibold underline">browse files</button> — PDF, JPG, PNG or DWG, up to 15MB each</span>
            </div>
            <input id="enquiry-file-input" name="attachment" type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.dwg" class="sr-only" />
            <ul id="enquiry-file-list" class="mt-2.5 space-y-1.5"></ul>
            <p id="enquiry-file-error" hidden class="mt-1.5 text-xs text-red-700"></p>
          </div>

          <p id="enquiry-submit-error" hidden class="text-sm text-red-700">
            Something went wrong sending that — please try again, or call <a href="tel:1300482228" class="font-semibold underline">1300 482 228</a>.
          </p>

          <button type="submit" id="enquiry-submit-btn" class="w-full inline-flex items-center justify-center rounded-md bg-sms-green-600 px-6 py-3 text-base font-semibold text-white hover:bg-sms-green-700 transition-colors disabled:bg-sms-charcoal-200 disabled:cursor-not-allowed">
            Send enquiry
          </button>
        </form>
      </div>

      <div id="enquiry-success" class="hidden px-6 py-10 text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-sms-green-50">
          <svg width="24" height="24" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10.5l3.5 3.5L16 5" stroke="#3f7a2d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h2 class="text-lg font-bold text-sms-charcoal-900 mb-2">Enquiry received</h2>
        <p class="text-sm text-sms-charcoal-500 leading-relaxed max-w-[32ch] mx-auto mb-6">
          Thanks — an SMS team member will follow up within 2 business days. Need it sooner? Call 1300 482 228.
        </p>
        <button type="button" id="enquiry-success-close" class="inline-flex items-center rounded-md border border-sms-charcoal-200 px-5 py-2.5 text-sm font-semibold text-sms-charcoal-700 hover:border-sms-green-400 hover:text-sms-green-600 transition-colors">
          Close
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Same emerging-from-nothing treatment as Header.astro's nav-panel/
     mobile-panel disclosures — one reveal convention reused, not a
     bespoke animation invented per component. */
  .enquiry-card {
    transition: opacity 160ms ease-out, transform 160ms ease-out;
  }
  #enquiry-modal[data-closed] .enquiry-card {
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
  }
  .enquiry-dropzone[data-dragover] {
    border-color: var(--color-sms-green-600);
    background-color: var(--color-sms-green-50);
  }
  .enquiry-dropzone[data-dragover] svg {
    color: var(--color-sms-green-600);
  }
  @media (prefers-reduced-motion: reduce) {
    .enquiry-card {
      transition: none;
    }
  }
</style>

<script>
  // ---- open / close ---------------------------------------------------
  const modal = document.getElementById('enquiry-modal')!;
  const backdrop = document.getElementById('enquiry-backdrop')!;
  const closeBtn = document.getElementById('enquiry-close')!;
  const successCloseBtn = document.getElementById('enquiry-success-close')!;
  const formView = document.getElementById('enquiry-form-view')!;
  const successView = document.getElementById('enquiry-success')!;
  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const submitBtn = document.getElementById('enquiry-submit-btn') as HTMLButtonElement;
  const submitError = document.getElementById('enquiry-submit-error')!;
  const firstField = document.getElementById('eq-name') as HTMLInputElement;
  let lastFocused: HTMLElement | null = null;

  function openModal(e: Event, productId?: string | null): void {
    e.preventDefault();
    lastFocused = document.activeElement as HTMLElement | null;
    modal.removeAttribute('hidden');
    requestAnimationFrame(() => modal.removeAttribute('data-closed'));
    setTimeout(() => firstField?.focus(), 50);
    if (productId) preselectProduct(productId);
  }

  function closeModal(): void {
    modal.setAttribute('data-closed', '');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finish = () => {
      modal.setAttribute('hidden', '');
      formView.classList.remove('hidden');
      successView.classList.add('hidden');
      submitError.setAttribute('hidden', '');
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send enquiry';
      form.reset();
      clearFiles();
      lastFocused?.focus();
    };
    if (reduced) finish();
    else modal.querySelector('.enquiry-card')?.addEventListener('transitionend', finish, { once: true });
  }

  // Every real "Enquire"/"Request a quote" CTA on the site carries this
  // attribute explicitly (Header, Hero, CtaBand, Footer) — deliberately
  // opt-in rather than matching on href="/contact/" generically, since the
  // header's plain "Contact" nav link shares that exact href and should
  // keep navigating to the full page (branch addresses, direct phone/email),
  // not pop a quick-enquiry modal instead.
  document.querySelectorAll<HTMLElement>('[data-enquiry-cta]').forEach((el) => {
    el.addEventListener('click', (e) => openModal(e, el.dataset.enquiryProduct));
  });
  closeBtn.addEventListener('click', closeModal);
  successCloseBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal();
  });

  // ---- submit -----------------------------------------------------------
  // FormData (not a URL-encoded string) is required here — this is the one
  // part that genuinely differs from a typical Netlify Forms AJAX snippet,
  // since URLSearchParams can't carry File objects and would silently drop
  // every attachment. Don't set Content-Type manually: fetch derives the
  // multipart boundary from the FormData object itself, and a hand-set
  // header here would omit that boundary and break the parse.
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    submitError.setAttribute('hidden', '');
    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    fetch('/', { method: 'POST', body: new FormData(form) })
      .then((res) => {
        if (!res.ok) throw new Error(`${res.status}`);
        formView.classList.add('hidden');
        successView.classList.remove('hidden');
        successCloseBtn.focus();
      })
      .catch(() => {
        submitError.removeAttribute('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send enquiry';
      });
  });

  // ---- product multi-select (identical behavior to /contact/'s own form)
  const productToggle = document.getElementById('enquiry-product-toggle')!;
  const productPanel = document.getElementById('enquiry-product-panel')!;
  const productSummary = document.getElementById('enquiry-product-summary')!;
  const productChevron = document.getElementById('enquiry-product-chevron')!;
  const productCheckboxes = () => [...productPanel.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];

  function setProductOpen(open: boolean): void {
    productToggle.setAttribute('aria-expanded', String(open));
    productChevron.style.transform = open ? 'rotate(180deg)' : '';
    if (open) productPanel.removeAttribute('hidden');
    else productPanel.setAttribute('hidden', '');
  }
  function refreshProductSummary(): void {
    const checked = productCheckboxes().filter((c) => c.checked);
    if (checked.length === 0) productSummary.textContent = 'Select product(s) — optional';
    else if (checked.length === 1) productSummary.textContent = checked[0].dataset.productTitle || checked[0].value;
    else productSummary.textContent = `${checked.length} products selected`;
  }
  function preselectProduct(productId: string): void {
    const box = productCheckboxes().find((c) => c.value === productId);
    if (box) box.checked = true;
    refreshProductSummary();
  }
  productToggle.addEventListener('click', () => setProductOpen(productToggle.getAttribute('aria-expanded') !== 'true'));
  productCheckboxes().forEach((c) => c.addEventListener('change', refreshProductSummary));
  document.addEventListener('click', (e) => {
    if (productToggle.getAttribute('aria-expanded') === 'true' && !productPanel.contains(e.target as Node) && !productToggle.contains(e.target as Node)) {
      setProductOpen(false);
    }
  });

  // ---- file attachment ----------------------------------------------------
  const dropzone = document.getElementById('enquiry-dropzone')!;
  const fileInput = document.getElementById('enquiry-file-input') as HTMLInputElement;
  const fileBrowseBtn = document.getElementById('enquiry-file-browse')!;
  const fileList = document.getElementById('enquiry-file-list')!;
  const fileError = document.getElementById('enquiry-file-error')!;
  const MAX_FILE_BYTES = 15 * 1024 * 1024;
  const ACCEPTED_EXT = ['pdf', 'jpg', 'jpeg', 'png', 'dwg'];
  let attachedFiles: File[] = [];

  function formatSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }
  function fileKey(file: File): string {
    return `${file.name}::${file.size}::${file.lastModified}`;
  }
  function showFileError(message: string): void {
    fileError.textContent = message;
    fileError.removeAttribute('hidden');
  }
  function clearFileError(): void {
    fileError.setAttribute('hidden', '');
    fileError.textContent = '';
  }
  // The real submission reads File objects straight off the <input>, so the
  // in-memory attachedFiles list is re-synced onto fileInput.files (via a
  // DataTransfer, since FileList itself is read-only) every time it
  // changes — otherwise "remove" would only update the visible list while
  // the actually-submitted files stayed the original, unfiltered set.
  function syncInputFiles(): void {
    const dt = new DataTransfer();
    attachedFiles.forEach((f) => dt.items.add(f));
    fileInput.files = dt.files;
  }
  function renderFileList(): void {
    fileList.innerHTML = '';
    attachedFiles.forEach((file, i) => {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-2 rounded-md border border-sms-charcoal-100 bg-white px-2.5 py-1.5 text-sm text-sms-charcoal-700';
      li.innerHTML = `
        <svg class="shrink-0 text-sms-charcoal-400" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M6 2.5h5.5L15 6v10a1.5 1.5 0 01-1.5 1.5h-7A1.5 1.5 0 015 16V4a1.5 1.5 0 011-1.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          <path d="M11.5 2.5V6H15" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
        </svg>
        <span class="flex-1 min-w-0 truncate">${file.name}</span>
        <span class="shrink-0 text-xs text-sms-charcoal-400">${formatSize(file.size)}</span>
        <button type="button" class="enquiry-file-remove shrink-0 p-0.5 rounded text-sms-charcoal-400 hover:text-red-700 hover:bg-red-50" aria-label="Remove ${file.name}" data-index="${i}">
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      `;
      fileList.appendChild(li);
    });
  }
  function addFiles(incomingList: FileList): void {
    clearFileError();
    const incoming = [...incomingList];
    const accepted: File[] = [];
    const rejected: string[] = [];
    for (const file of incoming) {
      const ext = file.name.split('.').pop()?.toLowerCase() ?? '';
      const duplicate = attachedFiles.some((f) => fileKey(f) === fileKey(file));
      if (duplicate) rejected.push(`${file.name} is already attached`);
      else if (file.size > MAX_FILE_BYTES) rejected.push(`${file.name} is over 15MB`);
      else if (!ACCEPTED_EXT.includes(ext)) rejected.push(`${file.name} isn't a supported file type`);
      else accepted.push(file);
    }
    attachedFiles = [...attachedFiles, ...accepted];
    syncInputFiles();
    renderFileList();
    if (rejected.length) showFileError(rejected.join(' · '));
  }
  function clearFiles(): void {
    attachedFiles = [];
    fileInput.value = '';
    renderFileList();
    clearFileError();
  }
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      fileInput.click();
    }
  });
  fileBrowseBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    fileInput.click();
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.length) addFiles(fileInput.files);
  });
  fileList.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.enquiry-file-remove');
    if (!btn) return;
    attachedFiles.splice(Number(btn.dataset.index), 1);
    syncInputFiles();
    renderFileList();
  });
  (['dragenter', 'dragover'] as const).forEach((evt) => {
    dropzone.addEventListener(evt, (e) => {
      e.preventDefault();
      dropzone.setAttribute('data-dragover', '');
    });
  });
  (['dragleave', 'dragend'] as const).forEach((evt) => {
    dropzone.addEventListener(evt, () => dropzone.removeAttribute('data-dragover'));
  });
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.removeAttribute('data-dragover');
    if (e.dataTransfer?.files?.length) addFiles(e.dataTransfer.files);
  });
</script>
