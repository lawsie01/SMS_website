---
import company from '../data/company.json';

interface Props {
  heading?: string;
  subtitle?: string;
  productContext?: string;
  /* Product pages already carry an enquiry card in the sidebar with the
     product attached to it, so a second enquiry band a screen below repeats
     the same offer in different words. Passing a primaryCta here gives the
     band a different job — on product pages, the paperwork. */
  primaryCta?: { label: string; href: string };
}
const {
  heading = 'Talk to us about your next structure',
  subtitle = 'Send through your depth, inlet sizes and load rating. We\'ll confirm the configuration and lead time within 2 business days.',
  productContext,
  primaryCta,
} = Astro.props;

// One vocabulary for the enquiry action across the site: Enquire, or Request
// pricing where a product is actually attached to the link.
const enquiryHref = productContext ? `/contact/?product=${productContext}` : '/contact/';
const enquiryLabel = productContext ? 'Request pricing' : 'Enquire';
const isEnquiry = !primaryCta;
---

<section class="bg-sms-charcoal-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 flex flex-col lg:flex-row items-center justify-between gap-8">
    <div class="text-center lg:text-left">
      <h2 class="text-2xl sm:text-3xl font-bold text-white">{heading}</h2>
      <p class="mt-2 text-white/90 max-w-xl">{subtitle}</p>
    </div>
    <div class="flex flex-wrap justify-center gap-4 shrink-0">
      <a
        href={primaryCta?.href ?? enquiryHref}
        data-enquiry-cta={isEnquiry ? true : undefined}
        data-enquiry-product={isEnquiry ? (productContext ?? undefined) : undefined}
        class="inline-flex items-center rounded-md bg-sms-green-600 px-6 py-3 text-base font-semibold text-sms-charcoal-900 hover:bg-sms-green-700 transition-colors"
      >
        {primaryCta?.label ?? enquiryLabel}
      </a>
      <a
        href={`tel:${company.phoneHref}`}
        class="inline-flex items-center rounded-md border-2 border-white px-6 py-3 text-base font-semibold text-white hover:bg-white hover:text-sms-charcoal-900 transition-colors"
      >
        Call {company.phone}
      </a>
    </div>
  </div>
</section>
