---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  dnSize?: string;
  brand: string;
  useCase: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageBackground?: 'dark' | 'light';
}

const { href, title, dnSize, brand, useCase, image, imageAlt = '', imageBackground = 'light' } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col rounded-xl border border-sms-charcoal-100 bg-white overflow-hidden shadow-sm hover:shadow-lg hover:border-sms-green-300 transition-all"
>
  <div class:list={["aspect-4/3 flex items-center justify-center overflow-hidden", imageBackground === 'dark' ? 'bg-sms-charcoal-900' : 'bg-sms-charcoal-50']}>
    {image ? (
      <Image src={image} alt={imageAlt} class="h-full w-full object-contain p-4" widths={[320, 480, 640]} sizes="(min-width: 1024px) 320px, 50vw" />
    ) : (
      <span class:list={["text-sm", imageBackground === 'dark' ? 'text-white/40' : 'text-sms-charcoal-300']}>Product render</span>
    )}
  </div>
  <div class="p-6 flex flex-col grow">
    <p class="text-xs font-semibold tracking-wide uppercase text-sms-green-600">{brand}{dnSize ? ` · ${dnSize}` : ''}</p>
    <h3 class="mt-1 text-lg font-bold text-sms-charcoal-900">{title}</h3>
    <p class="mt-2 text-sm text-sms-charcoal-400 grow">{useCase}</p>
    <span class="mt-4 text-sm font-semibold text-sms-green-600 group-hover:text-sms-green-700">View specs &rarr;</span>
  </div>
</a>
