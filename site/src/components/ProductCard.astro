---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  dnSize?: string;
  brand: string;
  useCase: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imageBackground?: 'dark' | 'light' | 'white';
}

const { href, title, dnSize, brand, useCase, image, imageAlt = '', imageBackground = 'light' } = Astro.props;
// 'light' matches the exact backdrop baked into the "-clover" 3D renders;
// 'white' is for real photography shot on true white — using the wrong one
// leaves a visible seam around the image (see --color-render-bg).
const bgClass = imageBackground === 'dark' ? 'bg-sms-charcoal-900' : imageBackground === 'white' ? 'bg-white' : 'bg-render-bg';
---

<a
  href={href}
  class="group flex h-full flex-col rounded-xl border border-sms-charcoal-100 bg-white overflow-hidden shadow-sm hover:shadow-lg hover:border-sms-green-300 transition-all"
>
  <div class:list={["aspect-square flex items-center justify-center overflow-hidden", bgClass]}>
    {image ? (
      <Image src={image} alt={imageAlt} class="h-full w-full object-contain p-2" widths={[320, 480, 640]} sizes="(min-width: 1024px) 320px, 50vw" />
    ) : (
      <span class:list={["text-sm", imageBackground === 'dark' ? 'text-white/40' : 'text-sms-charcoal-300']}>Product render</span>
    )}
  </div>
  <div class="p-7 flex flex-col grow">
    <p class="text-xs font-semibold tracking-wide uppercase text-sms-slate-500">{brand}{dnSize ? ` · ${dnSize}` : ''}</p>
    <h3 class="mt-1 text-lg font-bold text-sms-charcoal-900">{title}</h3>
    <p class="mt-2 text-sm text-sms-charcoal-400 grow">{useCase}</p>
    <span class="mt-5 text-sm font-semibold text-sms-charcoal-900 sms-link self-start">View specs &rarr;</span>
  </div>
</a>
