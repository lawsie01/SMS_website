---
import logo from '../assets/images/sms-logo.png';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import SearchModal from './SearchModal.astro';

const nav = [
  { label: 'Why Plastic vs Concrete', href: '/why-plastic-vs-concrete/' },
  { label: 'Applications', href: '/applications/' },
  { label: 'Approvals', href: '/approvals/' },
  { label: 'Technical Resources', href: '/technical-resources/' },
  { label: 'About', href: '/about/' },
];

const products = await getCollection('products');
const productFamilies = products
  .filter((p) => p.data.category !== 'accessory')
  .sort((a, b) => a.data.order - b.data.order);
const accessories = products
  .filter((p) => p.data.category === 'accessory')
  .sort((a, b) => a.data.order - b.data.order);
---

<header id="site-header" class="border-b border-sms-charcoal-100 bg-white sticky top-0 z-40 transition-shadow duration-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="SMS home">
        <Image src={logo} alt="SMS" width={110} height={54} />
      </a>

      <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-sms-charcoal-700" aria-label="Main">
        <div class="relative">
          <button
            type="button"
            id="products-nav-toggle"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="products-nav-panel"
            class="flex items-center gap-1 hover:text-sms-green-600 transition-colors"
          >
            Products
            <svg id="products-nav-chevron" class="w-3.5 h-3.5 shrink-0 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div
            id="products-nav-panel"
            hidden
            class="absolute left-0 top-full mt-2 w-72 rounded-md border border-sms-charcoal-100 bg-white py-2 shadow-lg"
          >
            <p class="px-4 pt-1 pb-1.5 text-[11px] font-semibold uppercase tracking-wider text-sms-charcoal-400">Maintenance structures</p>
            {productFamilies.map((p) => (
              <a href={`/products/${p.id}/`} class="block px-4 py-2 text-sm text-sms-charcoal-700 hover:bg-sms-charcoal-50 hover:text-sms-green-600">
                {p.data.title}
              </a>
            ))}
            <div class="my-1.5 border-t border-sms-charcoal-100"></div>
            <p class="px-4 pt-1 pb-1.5 text-[11px] font-semibold uppercase tracking-wider text-sms-charcoal-400">Fittings & accessories</p>
            {accessories.map((p) => (
              <a href={`/products/${p.id}/`} class="block px-4 py-2 text-sm text-sms-charcoal-700 hover:bg-sms-charcoal-50 hover:text-sms-green-600">
                {p.data.title}
              </a>
            ))}
            <div class="my-1.5 border-t border-sms-charcoal-100"></div>
            <a href="/products/" class="block px-4 py-2 text-sm font-semibold text-sms-green-600 hover:bg-sms-green-50">
              View all products &rarr;
            </a>
          </div>
        </div>
        {nav.map((item) => (
          <a href={item.href} class="hover:text-sms-green-600 transition-colors">
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <SearchModal />

        {/* Hidden until the visitor actually has a quote started, so it stays out
            of the way for everyone else. Populated by the script below. */}
        <a
          href="/quote/"
          id="quote-badge-link"
          hidden
          class="items-center gap-2 rounded-md border border-sms-green-600 px-3 py-2.5 text-sm font-semibold text-sms-green-600 hover:bg-sms-green-50 transition-colors"
        >
          <span>Quote</span>
          <span
            id="quote-badge-count"
            class="inline-flex min-w-5 h-5 items-center justify-center rounded-full bg-sms-green-600 px-1.5 text-xs font-bold text-white"
          >0</span>
        </a>

        <a
          href="/contact/"
          class="inline-flex items-center rounded-md bg-sms-green-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-sms-green-700 transition-colors"
        >
          Enquire Now
        </a>

        {/* Six items in a wrapped row made the sticky bar two rows tall and left
            20px tap targets. Collapsed behind a disclosure instead. */}
        <button
          type="button"
          id="nav-toggle"
          class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-md border border-sms-charcoal-200 text-sms-charcoal-700 hover:border-sms-green-400 transition-colors"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
        >
          <svg id="nav-icon-open" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <svg id="nav-icon-close" class="hidden" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>

    <nav id="mobile-nav" hidden class="lg:hidden border-t border-sms-charcoal-100 py-2" aria-label="Main">
      <ul>
        <li>
          <button
            type="button"
            id="mobile-products-toggle"
            aria-expanded="false"
            aria-controls="mobile-products-panel"
            class="flex w-full items-center justify-between py-3 text-base font-medium text-sms-charcoal-700 hover:text-sms-green-600 transition-colors"
          >
            <span>Products</span>
            <svg id="mobile-products-chevron" class="w-4 h-4 shrink-0 transition-transform" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <ul id="mobile-products-panel" hidden class="pl-4 pb-2 space-y-1">
            {productFamilies.map((p) => (
              <li>
                <a href={`/products/${p.id}/`} class="block py-2 text-sm text-sms-charcoal-600 hover:text-sms-green-600 transition-colors">
                  {p.data.title}
                </a>
              </li>
            ))}
            {accessories.map((p) => (
              <li>
                <a href={`/products/${p.id}/`} class="block py-2 text-sm text-sms-charcoal-600 hover:text-sms-green-600 transition-colors">
                  {p.data.title}
                </a>
              </li>
            ))}
            <li>
              <a href="/products/" class="block py-2 text-sm font-semibold text-sms-green-600">
                View all products &rarr;
              </a>
            </li>
          </ul>
        </li>
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="block py-3 text-base font-medium text-sms-charcoal-700 hover:text-sms-green-600 transition-colors"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // ---- scroll elevation ---------------------------------------------------
  // A hairline border reads fine at the top of the page, but once content is
  // scrolling underneath a sticky header it needs a little more separation
  // to still read as "above" the page rather than part of it.
  const siteHeader = document.getElementById('site-header');
  function paintElevation(): void {
    siteHeader?.classList.toggle('shadow-sm', window.scrollY > 4);
  }
  paintElevation();
  window.addEventListener('scroll', paintElevation, { passive: true });

  // ---- quote badge -------------------------------------------------------
  const STORAGE_KEY = 'sms-quote-items';

  function quoteCount(): number {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      const items = raw ? JSON.parse(raw) : [];
      return Array.isArray(items) ? items.length : 0;
    } catch {
      return 0;
    }
  }

  function paintBadge(): void {
    const link = document.getElementById('quote-badge-link');
    const count = document.getElementById('quote-badge-count');
    if (!link || !count) return;
    const n = quoteCount();
    if (n > 0) {
      count.textContent = String(n);
      link.removeAttribute('hidden');
      link.classList.add('inline-flex');
      link.setAttribute('aria-label', `Your quote, ${n} ${n === 1 ? 'item' : 'items'}`);
    } else {
      link.setAttribute('hidden', '');
      link.classList.remove('inline-flex');
    }
  }

  paintBadge();
  // Same page (the quote builder dispatches this), and other tabs.
  window.addEventListener('sms-quote-change', paintBadge);
  window.addEventListener('storage', (e) => {
    if (e.key === STORAGE_KEY) paintBadge();
  });

  // ---- desktop Products dropdown ------------------------------------------
  const productsToggle = document.getElementById('products-nav-toggle');
  const productsPanel = document.getElementById('products-nav-panel');
  const productsChevron = document.getElementById('products-nav-chevron');

  function setProductsOpen(open: boolean): void {
    if (!productsToggle || !productsPanel || !productsChevron) return;
    productsToggle.setAttribute('aria-expanded', String(open));
    productsChevron.style.transform = open ? 'rotate(180deg)' : '';
    if (open) productsPanel.removeAttribute('hidden');
    else productsPanel.setAttribute('hidden', '');
  }

  if (productsToggle && productsPanel) {
    productsToggle.addEventListener('click', () => {
      setProductsOpen(productsToggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('click', (e) => {
      if (
        productsToggle.getAttribute('aria-expanded') === 'true' &&
        !productsPanel.contains(e.target as Node) &&
        !productsToggle.contains(e.target as Node)
      ) {
        setProductsOpen(false);
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && productsToggle.getAttribute('aria-expanded') === 'true') {
        setProductsOpen(false);
        productsToggle.focus();
      }
    });
  }

  // ---- mobile nav disclosure --------------------------------------------
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  function setNav(open: boolean): void {
    if (!toggle || !panel || !iconOpen || !iconClose) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    if (open) {
      panel.removeAttribute('hidden');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
    } else {
      panel.setAttribute('hidden', '');
      iconClose.classList.add('hidden');
      iconOpen.classList.remove('hidden');
    }
  }

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      setNav(toggle.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setNav(false);
        toggle.focus();
      }
    });
    // Reaching the desktop breakpoint makes the panel irrelevant; reset it so the
    // toggle doesn't come back already flagged as expanded.
    const wide = window.matchMedia('(min-width: 1024px)');
    wide.addEventListener('change', (e) => {
      if (e.matches) {
        setNav(false);
        setMobileProductsOpen(false);
      } else {
        setProductsOpen(false);
      }
    });
  }

  // ---- mobile nested Products disclosure ----------------------------------
  const mobileProductsToggle = document.getElementById('mobile-products-toggle');
  const mobileProductsPanel = document.getElementById('mobile-products-panel');
  const mobileProductsChevron = document.getElementById('mobile-products-chevron');

  function setMobileProductsOpen(open: boolean): void {
    if (!mobileProductsToggle || !mobileProductsPanel || !mobileProductsChevron) return;
    mobileProductsToggle.setAttribute('aria-expanded', String(open));
    mobileProductsChevron.style.transform = open ? 'rotate(180deg)' : '';
    if (open) mobileProductsPanel.removeAttribute('hidden');
    else mobileProductsPanel.setAttribute('hidden', '');
  }

  mobileProductsToggle?.addEventListener('click', () => {
    setMobileProductsOpen(mobileProductsToggle.getAttribute('aria-expanded') !== 'true');
  });
</script>
