---
import Icon, { type IconName } from './Icon.astro';

interface Row {
  label: string;
  value: string;
  icon?: IconName;
}
interface Props {
  items: Row[];
}
const { items } = Astro.props;
---

{/* Registration brackets (see .sms-bracketed in global.css) replace the old
    hand-drawn corner marks. Stats sit in a single non-wrapping row divided
    by hairlines on larger screens; below 640px a bare overflow-x-auto row
    of 5-6 items gave no visual cue that it scrolled — it just looked like
    the rest of the stats were missing off the edge of the phone screen —
    so on mobile the row folds into a 2-column grid instead (.sms-stat-grid,
    see global.css), no scrolling required. */}
<div class="sms-bracketed inline-block max-w-full">
  <div class="sms-bracketed__inner">
    {/* overflow-x-auto lives on its own wrapper, not .sms-bracketed__inner —
        setting only overflow-x there would force overflow-y to "auto" too
        per the CSS overflow spec, clipping the bottom corner marks. Only
        matters at sm+ now that mobile wraps instead of scrolling. */}
    <div class="overflow-x-auto">
      <dl class="sms-stat-grid grid grid-cols-2 py-6 sm:flex sm:w-max sm:py-8">
        {items.map((item) => (
          <div class="sms-stat">
            <dt class="sms-stat__label flex items-center gap-1.5">
              {item.icon && <Icon name={item.icon} class="w-3 h-3 shrink-0 text-sms-green-600" />}
              <span>{item.label}</span>
            </dt>
            <dd class="sms-stat__value">{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</div>
