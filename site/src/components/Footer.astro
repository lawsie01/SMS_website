---
import company from '../data/company.json';
import monoLogo from '../assets/images/sms-logo-mono-white.png';
import { Image } from 'astro:assets';

const year = new Date().getFullYear();
const productLinks = [
  { label: 'DN375 Maintenance Shaft', href: '/products/dn375-maintenance-shaft/' },
  { label: 'DN600 Maintenance Chamber', href: '/products/dn600-maintenance-chamber/' },
  { label: 'DN1000 Maintenance Hole', href: '/products/dn1000-maintenance-hole/' },
];
const resourceLinks = [
  { label: 'Approvals & Standards', href: '/approvals/' },
  { label: 'Technical Resources', href: '/technical-resources/' },
  { label: 'Why Plastic vs Concrete', href: '/why-plastic-vs-concrete/' },
  { label: 'Applications', href: '/applications/' },
];
---

<footer class="bg-sms-charcoal-900 text-sms-charcoal-200">
  {/* Equal-width columns give unequal-looking gaps here, because the blurb fills
      its column while the link lists leave 85-125px of slack. Sizing each column
      to its content and distributing the remainder with space-between is what
      actually reads as evenly spaced. */}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 xl:flex xl:justify-between xl:gap-x-10">
    <div class="xl:max-w-[20rem]">
      {/* h-6 + mb-3 matches the line-height + margin-bottom of the "Products"/
          "Resources"/"Contact" headings this sits beside, and items-end pins the
          mark to the bottom of that box — the same row-bottom the column
          headings' own text sits on — rather than the top, where a shorter mark
          would otherwise float above their baseline. The source PNG's own
          canvas has more empty padding below the mark than above it (68px vs
          19px), which at this display size undershoots the text's own leading
          by ~4px — mb-1 makes up the difference so the visible ink lines up,
          not just the two elements' invisible boxes. Verified by comparing
          rendered pixel bounds, not eyeballed. */}
      <div class="h-6 mb-3 flex items-end">
        <Image src={monoLogo} alt="SMS" height={22} width={Math.round((22 * monoLogo.width) / monoLogo.height)} class="mb-1" />
      </div>
      <p class="text-sm leading-relaxed">
        Australia's WSAA-appraised polypropylene sewer maintenance structures. Part of the
        Clover group.
      </p>
    </div>
    <div>
      <p class="text-white font-semibold mb-3">Products</p>
      <ul class="space-y-2 text-sm">
        {productLinks.map((l) => (
          <li><a href={l.href} class="hover:text-sms-green-400">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-white font-semibold mb-3">Resources</p>
      <ul class="space-y-2 text-sm">
        {resourceLinks.map((l) => (
          <li><a href={l.href} class="hover:text-sms-green-400">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-white font-semibold mb-3">Contact</p>
      <ul class="space-y-2 text-sm">
        <li><a href={`tel:${company.phoneHref}`} class="hover:text-sms-green-400">{company.phone}</a></li>
        <li><a href={`mailto:${company.email}`} class="hover:text-sms-green-400">{company.email}</a></li>
        <li><a href="/contact/" data-enquiry-cta class="hover:text-sms-green-400">Request a quote →</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-sms-charcoal-700">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 text-xs text-sms-charcoal-300">
      <p>&copy; {year} Sewer Maintenance Shaft Pty Ltd. All rights reserved.</p>
    </div>
  </div>
</footer>
