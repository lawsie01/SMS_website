---
import company from '../data/company.json';
import logo from '../assets/images/sms-logo.png';
import { Image } from 'astro:assets';

const year = new Date().getFullYear();
const productLinks = [
  { label: 'DN375 Maintenance Shaft', href: '/products/dn375-maintenance-shaft/' },
  { label: 'DN600 Maintenance Chamber', href: '/products/dn600-maintenance-chamber/' },
  { label: 'DN1000 Maintenance Hole', href: '/products/dn1000-maintenance-hole/' },
];
const resourceLinks = [
  { label: 'Approvals & Standards', href: '/approvals/' },
  { label: 'Technical Resources', href: '/technical-resources/' },
  { label: 'Why Plastic vs Concrete', href: '/why-plastic-vs-concrete/' },
  { label: 'Applications', href: '/applications/' },
];
---

<footer class="bg-sms-charcoal-50 text-sms-charcoal-500 border-t border-sms-charcoal-100">
  {/* Equal-width columns give unequal-looking gaps here, because the blurb fills
      its column while the link lists leave 85-125px of slack. Sizing each column
      to its content and distributing the remainder with space-between is what
      actually reads as evenly spaced. */}
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 xl:flex xl:justify-between xl:gap-x-10">
    <div class="xl:max-w-[20rem]">
      {/* h-6 + mb-3 matches the line-height + margin-bottom of the "Products"/
          "Resources"/"Contact" headings this sits beside, and items-end pins the
          mark to the bottom of that box — the same row-bottom the column
          headings' own text sits on — rather than the top, where a shorter mark
          would otherwise float above their baseline. The source PNG's own
          canvas has more empty padding below the mark than above it (68px vs
          19px), which at this display size undershoots the text's own leading
          by ~4px — mb-1 makes up the difference so the visible ink lines up,
          not just the two elements' invisible boxes. Verified by comparing
          rendered pixel bounds, not eyeballed. */}
      <div class="h-6 mb-3 flex items-end">
        <Image src={logo} alt="SMS" height={22} width={Math.round((22 * logo.width) / logo.height)} class="mb-1" />
      </div>
      <p class="text-sm leading-relaxed">
        Australia's WSAA-appraised polypropylene sewer maintenance structures. Part of the
        Clover group.
      </p>
    </div>
    <div>
      <p class="text-sms-charcoal-900 font-semibold mb-3">Products</p>
      <ul class="text-sm">
        {productLinks.map((l) => (
          <li><a href={l.href} class="block py-1.5 hover:text-sms-charcoal-900">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-sms-charcoal-900 font-semibold mb-3">Resources</p>
      <ul class="text-sm">
        {resourceLinks.map((l) => (
          <li><a href={l.href} class="block py-1.5 hover:text-sms-charcoal-900">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="text-sms-charcoal-900 font-semibold mb-3">Contact</p>
      <ul class="text-sm">
        <li><a href={`tel:${company.phoneHref}`} class="block py-1.5 hover:text-sms-charcoal-900">{company.phone}</a></li>
        <li><a href={`mailto:${company.email}`} class="block py-1.5 hover:text-sms-charcoal-900">{company.email}</a></li>
        <li><a href="/contact/" data-enquiry-cta class="block py-1.5 hover:text-sms-charcoal-900">Enquire</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-sms-charcoal-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-sms-charcoal-400">
      <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <p>&copy; {year} {company.legalName}. All rights reserved.</p>
        <a href="/disclaimer/" class="inline-block py-1.5 hover:text-sms-charcoal-900">Privacy Policy</a>
      </div>
      {company.socials.linkedin && (
        <a
          href={company.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="SMS on LinkedIn"
          class="-m-1.5 p-1.5 text-sms-charcoal-400 hover:text-sms-charcoal-900 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      )}
    </div>
  </div>
</footer>
